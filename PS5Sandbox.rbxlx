        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "neon_drive",
	title = "Neon Drive",
	category = "game", -- game | media | app
	genre = "Racing",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 2,
	description = "Night racing through a neon city: drift, boost and beat the clock.",
	icon = "🏎",
	cover = "cover",
	art = "art", -- фон главного экрана (blender/game_art.py)
	colors = { "#FF3D7F", "#3A0CA3" },
	controls = {
		{ "✕ / R2 / W", "Accelerate" },
		{ "□ / L2 / S", "Brake / reverse" },
		{ "Stick / A, D", "Steer" },
		{ "○ / L1 / Backspace, Q", "Drift" },
		{ "△ / R1 / R, E", "Boost" },
		{ "OPTIONS / O", "Pause" },
		{ "PS / H", "Control Center" },
	},
	trophies = {
		{ id = "green_light", name = "Green Light", description = "Complete your first lap", grade = "bronze" },
		{ id = "sideways", name = "Sideways", description = "Hold a single drift for 3 seconds", grade = "bronze" },
		{ id = "pad_hopper", name = "Pad Hopper", description = "Hit every boost pad in a single lap", grade = "bronze" },
		{ id = "beat_clock", name = "Beat the Clock", description = "Finish a Clock Run", grade = "silver" },
		{ id = "drift_king", name = "Drift King", description = "Score 12,000 drift points in one Clock Run", grade = "silver" },
		{ id = "ghost_buster", name = "Ghost Buster", description = "Beat your own ghost in Time Trial", grade = "silver" },
		{ id = "clean_line", name = "Clean Line", description = "Complete a lap without touching a wall", grade = "silver", hidden = true },
		{ id = "neon_ace", name = "Neon Ace", description = "Set a lap time under 30 seconds", grade = "gold" },
		{ id = "platinum", name = "Neon Legend", description = "Earn every Neon Drive trophy", grade = "platinum" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">NightSpider</string>
          <string name="Source"><![CDATA[-- Night Spider — герой-паук в ночном неоновом городе: полёт на паутине, бег по стенам,
-- бои с бандитами на вызовах и жетоны на крышах. Своя аркадная физика (без физики Roblox):
-- здания — прямоугольные коробки, герой — точка с радиусом.
local Game = {}

local BASE = Vector3.new(-9000, 300, 9000) -- город далеко от чиллзоны
local GY = BASE.Y -- уровень улицы
local N, BLOCK, CELL = 7, 84, 124 -- кварталы N×N, размер квартала, шаг сетки
local HALF = N * CELL / 2
local G = 120
local RUN, JUMP = 44, 58
local MAX_SPEED = 190
local WALL_UP = 52
local R, H = 1.2, 5 -- радиус и рост героя
local TOKENS = 20
local MAX_HP = 100
local Y = Vector3.new(0, 1, 0)

local CRIMSON = Color3.fromRGB(205, 24, 48)
local NAVY = Color3.fromRGB(18, 28, 70)
local WHITE = Color3.new(1, 1, 1)
local AMBER = Color3.fromRGB(255, 190, 40)
local CONCRETE = {
	Color3.fromRGB(38, 42, 58), Color3.fromRGB(52, 50, 64), Color3.fromRGB(30, 36, 48),
	Color3.fromRGB(60, 58, 70), Color3.fromRGB(44, 48, 70),
}

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function unitOr(v, fallback)
	local m = v.Magnitude
	if m < 1e-4 then
		return fallback
	end
	return v / m
end

local function part(parent, size, cf, color, material, transparency, shape)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

-- Детерминированный генератор, чтобы город всегда был одинаковым (жетоны сохраняются по номеру).
local function makeRng(seed)
	local s = seed
	return function()
		s = (s * 16807) % 2147483647
		return s / 2147483647
	end
end

-- Город: кварталы с одним зданием, в центре Night Tower, два парка.
local function buildCity(world)
	local rnd = makeRng(20261019)
	local city = Instance.new("Folder")
	city.Name = "City"
	local size = N * CELL + 240
	part(city, Vector3.new(size + 600, 4, size + 600), CFrame.new(BASE - Vector3.new(0, 8, 0)), Color3.fromRGB(10, 22, 40), Enum.Material.Glass, 0.1)
	part(city, Vector3.new(size, 2, size), CFrame.new(BASE - Vector3.new(0, 1.5, 0)), Color3.fromRGB(22, 22, 28), Enum.Material.Asphalt)

	local buildings = {}
	local tower
	for i = 0, N - 1 do
		for j = 0, N - 1 do
			local c = BASE + Vector3.new((i - (N - 1) / 2) * CELL, 0, (j - (N - 1) / 2) * CELL)
			part(city, Vector3.new(BLOCK, 0.5, BLOCK), CFrame.new(c - Vector3.new(0, 0.25, 0)), Color3.fromRGB(70, 70, 80), Enum.Material.Concrete)
			local park = (i == 1 and j == 5) or (i == 5 and j == 1)
			if park then
				part(city, Vector3.new(BLOCK - 6, 0.6, BLOCK - 6), CFrame.new(c), Color3.fromRGB(30, 90, 50), Enum.Material.Grass)
				for _ = 1, 6 do
					local t = c + Vector3.new((rnd() - 0.5) * 60, 0, (rnd() - 0.5) * 60)
					part(city, Vector3.new(1.4, 8, 1.4), CFrame.new(t + Vector3.new(0, 4, 0)), Color3.fromRGB(70, 45, 30), Enum.Material.Wood)
					part(city, Vector3.new(10, 10, 10), CFrame.new(t + Vector3.new(0, 11, 0)), Color3.fromRGB(30, 110, 60), Enum.Material.Grass, 0, Enum.PartType.Ball)
				end
			else
				local isTower = i == 3 and j == 3
				local w = isTower and 56 or 48 + rnd() * 30
				local d = isTower and 56 or 48 + rnd() * 30
				local h = isTower and 380 or math.floor(60 + rnd() ^ 1.4 * 210)
				local color = CONCRETE[1 + math.floor(rnd() * #CONCRETE)]
				local center = c + Vector3.new(0, h / 2, 0)
				part(city, Vector3.new(w, h, d), CFrame.new(center), color, isTower and Enum.Material.Glass or Enum.Material.Concrete, 0)
				-- пояса окон: одна деталь-кольцо на этаж, часть горит тёплым светом
				local step = isTower and 16 or 22
				for y = step, h - 6, step do
					local lit = rnd() < 0.55
					part(city, Vector3.new(w + 0.6, 1, d + 0.6), CFrame.new(c + Vector3.new(0, y, 0)), lit and Color3.fromRGB(235, 200, 130) or Color3.fromRGB(40, 46, 60), Enum.Material.Glass, 0)
				end
				part(city, Vector3.new(w + 1, 1.6, d + 1), CFrame.new(c + Vector3.new(0, h + 0.8, 0)), Color3.fromRGB(80, 80, 92), Enum.Material.Concrete)
				local roof = c + Vector3.new(0, h, 0)
				if isTower then
					part(city, Vector3.new(3, 60, 3), CFrame.new(roof + Vector3.new(0, 30, 0)), Color3.fromRGB(90, 90, 100), Enum.Material.Metal)
					local tip = part(city, Vector3.new(4, 4, 4), CFrame.new(roof + Vector3.new(0, 62, 0)), CRIMSON, Enum.Material.Glass, 0, Enum.PartType.Ball)
					local light = Instance.new("PointLight")
					light.Color = CRIMSON
					light.Range = 60
					light.Brightness = 4
					light.Parent = tip
				elseif rnd() < 0.35 then
					local p = roof + Vector3.new((rnd() - 0.5) * (w - 16), 0, (rnd() - 0.5) * (d - 16))
					part(city, Vector3.new(10, 8, 8), CFrame.new(p + Vector3.new(0, 9, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(110, 70, 45), Enum.Material.WoodPlanks, 0, Enum.PartType.Cylinder)
					part(city, Vector3.new(6, 5, 6), CFrame.new(p + Vector3.new(0, 2.5, 0)), Color3.fromRGB(50, 40, 35), Enum.Material.Metal, 0.5)
				elseif rnd() < 0.5 then
					local p = roof + Vector3.new((rnd() - 0.5) * (w - 10), 0, (rnd() - 0.5) * (d - 10))
					part(city, Vector3.new(0.6, 18, 0.6), CFrame.new(p + Vector3.new(0, 9, 0)), Color3.fromRGB(120, 120, 130), Enum.Material.Metal)
					part(city, Vector3.new(1.2, 1.2, 1.2), CFrame.new(p + Vector3.new(0, 18.5, 0)), Color3.fromRGB(255, 40, 40), Enum.Material.Glass, 0, Enum.PartType.Ball)
				end
				local b = {
					min = c - Vector3.new(w / 2, 0, d / 2),
					max = c + Vector3.new(w / 2, h, d / 2),
					top = GY + h,
					center = c,
				}
				table.insert(buildings, b)
				if isTower then
					tower = b
				end
			end
		end
	end

	-- фонари на перекрёстках
	local crossings = {}
	for i = 0, N - 2 do
		for j = 0, N - 2 do
			local p = BASE + Vector3.new((i - (N - 2) / 2) * CELL, 0, (j - (N - 2) / 2) * CELL)
			table.insert(crossings, p)
			if (i + j) % 2 == 0 then
				local lp = p + Vector3.new(14, 0, 14)
				part(city, Vector3.new(0.8, 16, 0.8), CFrame.new(lp + Vector3.new(0, 8, 0)), Color3.fromRGB(40, 40, 48), Enum.Material.Metal)
				local bulb = part(city, Vector3.new(2, 1, 2), CFrame.new(lp + Vector3.new(0, 16.5, 0)), Color3.fromRGB(255, 220, 160), Enum.Material.Glass)
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 210, 150)
				light.Range = 45
				light.Brightness = 2
				light.Parent = bulb
			end
		end
	end
	city.Parent = world
	return buildings, tower, crossings, rnd
end

-- Модель из деталей: размер, смещение от корня, цвет, материал. Конечности поворачиваются вокруг верхней точки.
local function buildFigure(parent, spec)
	local model = Instance.new("Model")
	local parts = {}
	for _, s in spec do
		local p = part(model, s.size, CFrame.new(BASE), s.color, s.material, s.transparency, s.shape)
		p.Name = s.name
		parts[s.name] = { part = p, at = s.at, half = s.size.Y / 2, limb = s.limb }
	end
	model.Parent = parent
	parts.model = model
	return parts
end

local function poseFigure(fig, root, swingA, swingB, armUp)
	for _, e in fig do
		if type(e) == "table" and e.part then
			local cf = root * CFrame.new(e.at)
			if e.limb == "a" then
				cf = cf * CFrame.Angles(swingA, 0, 0) * CFrame.new(0, -e.half, 0)
			elseif e.limb == "b" then
				cf = cf * CFrame.Angles(swingB, 0, 0) * CFrame.new(0, -e.half, 0)
			elseif e.limb == "up" then
				cf = cf * CFrame.Angles(armUp, 0, 0) * CFrame.new(0, -e.half, 0)
			end
			e.part.CFrame = cf
		end
	end
end

local HERO = {
	{ name = "Torso", size = Vector3.new(2, 2.2, 1), at = Vector3.new(0, 3.2, 0), color = CRIMSON },
	{ name = "Emblem", size = Vector3.new(0.9, 0.9, 0.1), at = Vector3.new(0, 3.5, -0.52), color = Color3.fromRGB(10, 10, 14) },
	{ name = "Belt", size = Vector3.new(2.05, 0.35, 1.05), at = Vector3.new(0, 2.2, 0), color = NAVY },
	{ name = "Head", size = Vector3.new(1.3, 1.4, 1.2), at = Vector3.new(0, 5, 0), color = CRIMSON },
	{ name = "EyeL", size = Vector3.new(0.45, 0.3, 0.1), at = Vector3.new(-0.32, 5.15, -0.61), color = WHITE, material = Enum.Material.SmoothPlastic },
	{ name = "EyeR", size = Vector3.new(0.45, 0.3, 0.1), at = Vector3.new(0.32, 5.15, -0.61), color = WHITE, material = Enum.Material.SmoothPlastic },
	{ name = "ArmL", size = Vector3.new(0.65, 2.1, 0.65), at = Vector3.new(-1.35, 4.2, 0), color = CRIMSON, limb = "b" },
	{ name = "ArmR", size = Vector3.new(0.65, 2.1, 0.65), at = Vector3.new(1.35, 4.2, 0), color = CRIMSON, limb = "up" },
	{ name = "LegL", size = Vector3.new(0.85, 2.1, 0.85), at = Vector3.new(-0.5, 2.1, 0), color = NAVY, limb = "a" },
	{ name = "LegR", size = Vector3.new(0.85, 2.1, 0.85), at = Vector3.new(0.5, 2.1, 0), color = NAVY, limb = "b" },
	{ name = "Sense", size = Vector3.new(0.6, 0.6, 0.6), at = Vector3.new(0, 6.6, 0), color = AMBER, material = Enum.Material.SmoothPlastic, transparency = 1, shape = Enum.PartType.Ball },
}

local THUG = {
	{ name = "Torso", size = Vector3.new(2.2, 2.2, 1.2), at = Vector3.new(0, 3.2, 0), color = Color3.fromRGB(70, 72, 80) },
	{ name = "Head", size = Vector3.new(1.2, 1.2, 1.2), at = Vector3.new(0, 4.9, 0), color = Color3.fromRGB(200, 150, 110) },
	{ name = "Mask", size = Vector3.new(1.25, 0.35, 1.25), at = Vector3.new(0, 4.8, 0), color = Color3.fromRGB(255, 120, 20) },
	{ name = "ArmL", size = Vector3.new(0.7, 2.1, 0.7), at = Vector3.new(-1.45, 4.2, 0), color = Color3.fromRGB(70, 72, 80), limb = "b" },
	{ name = "ArmR", size = Vector3.new(0.7, 2.1, 0.7), at = Vector3.new(1.45, 4.2, 0), color = Color3.fromRGB(70, 72, 80), limb = "up" },
	{ name = "LegL", size = Vector3.new(0.9, 2.1, 0.9), at = Vector3.new(-0.55, 2.1, 0), color = Color3.fromRGB(35, 35, 45), limb = "a" },
	{ name = "LegR", size = Vector3.new(0.9, 2.1, 0.9), at = Vector3.new(0.55, 2.1, 0), color = Color3.fromRGB(35, 35, 45), limb = "b" },
	{ name = "Web", size = Vector3.new(3.4, 6, 2.4), at = Vector3.new(0, 3, 0), color = Color3.fromRGB(235, 235, 245), material = Enum.Material.Fabric, transparency = 1 },
}

function Game.launch(ctx)
	local ui = ctx.ui
	local input = ctx.input
	ctx.gui.BackgroundTransparency = 1
	local camera = ctx.camera
	camera.CameraType = Enum.CameraType.Scriptable

	local buildings, tower, crossings, rnd = buildCity(ctx.world)

	-- Сохранения
	local tokenStr = ctx.save:Get("tokens", "")
	if type(tokenStr) ~= "string" or #tokenStr ~= TOKENS then
		tokenStr = string.rep("0", TOKENS)
	end
	local stats = {
		crimes = ctx.save:Get("crimes", 0),
		webbed = ctx.save:Get("webbed", 0),
		topSpeed = ctx.save:Get("topSpeed", 0),
	}

	-- Жетоны на крышах (детерминированно из генератора города)
	local tokens = {}
	do
		local pool = {}
		for _, b in buildings do
			if b ~= tower then
				table.insert(pool, b)
			end
		end
		for k = 1, TOKENS do
			local idx = 1 + math.floor(rnd() * #pool)
			local b = table.remove(pool, idx)
			local pos = Vector3.new(b.center.X, b.top + 3.5, b.center.Z)
			local got = tokenStr:sub(k, k) == "1"
			local p
			if not got then
				p = part(ctx.world, Vector3.new(0.6, 4, 4), CFrame.new(pos), AMBER, Enum.Material.Metal, 0, Enum.PartType.Cylinder)
				local light = Instance.new("PointLight")
				light.Color = AMBER
				light.Range = 18
				light.Brightness = 2
				light.Parent = p
			end
			tokens[k] = { pos = pos, part = p, got = got }
		end
	end
	local function tokenCount()
		local n = 0
		for _, t in tokens do
			if t.got then
				n += 1
			end
		end
		return n
	end

	-- Герой
	local fig = buildFigure(ctx.world, HERO)
	local rope = part(ctx.world, Vector3.new(0.18, 0.18, 1), CFrame.new(BASE), Color3.fromRGB(240, 240, 250), Enum.Material.SmoothPlastic, 1)
	local START = Vector3.new(tower.max.X + 20, GY, tower.max.Z + 20)
	local hero = {
		pos = START,
		vel = Vector3.zero,
		state = "ground", -- ground | air | swing | wall
		facing = Vector3.new(0, 0, -1),
		hp = MAX_HP,
		sinceHit = 99,
		iframes = 0,
		anchor = nil,
		ropeLen = 0,
		wall = nil,
		wallN = nil,
		climbed = 0,
		attackCd = 0,
		webCd = 0,
		dodgeCd = 0,
		combo = 0,
		comboT = 0,
		punch = 0,
		run = 0,
	}
	local camYaw = math.pi * 1.25
	local camManual = 0
	local camSmooth = nil
	local state = "title" -- title | play | pause
	local clock = 0

	-- Интерфейс
	local canvas = ui.canvas(ctx.gui)
	local hud = ui.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(1920, 1080), Visible = false, Parent = canvas })
	local hpBack = ui.new("Frame", {
		Position = UDim2.fromOffset(60, 50), Size = UDim2.fromOffset(420, 22),
		BackgroundColor3 = Color3.fromRGB(20, 20, 30), BackgroundTransparency = 0.3, Parent = hud,
	}, { ui.corner(11) })
	local hpFill = ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = CRIMSON, Parent = hpBack }, { ui.corner(11) })
	ui.text("NIGHT SPIDER", { Position = UDim2.fromOffset(60, 80), Size = UDim2.fromOffset(420, 30), TextSize = 22, TextColor3 = Color3.fromRGB(255, 255, 255), TextTransparency = 0.3, Parent = hud })
	local statsLabel = ui.text("", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromOffset(1860, 46), Size = UDim2.fromOffset(500, 80),
		TextSize = 28, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, Parent = hud,
	})
	local objective = ui.text("", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(960, 40), Size = UDim2.fromOffset(900, 40),
		TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Parent = hud,
	})
	local arrow = ui.text("▲", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 110), Size = UDim2.fromOffset(60, 60),
		TextSize = 44, TextColor3 = CRIMSON, TextXAlignment = Enum.TextXAlignment.Center, Parent = hud,
	})
	local speedLabel = ui.text("", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromOffset(1860, 1030), Size = UDim2.fromOffset(400, 60),
		TextSize = 44, TextXAlignment = Enum.TextXAlignment.Right, Parent = hud,
	})
	local comboLabel = ui.text("", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 300), Size = UDim2.fromOffset(600, 80),
		TextSize = 56, TextColor3 = AMBER, TextXAlignment = Enum.TextXAlignment.Center, Parent = hud,
	})
	local toast = ui.text("", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 820), Size = UDim2.fromOffset(1200, 70),
		TextSize = 40, TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1, Parent = hud,
	})
	local hint = ui.text("", {
		AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromOffset(60, 1030), Size = UDim2.fromOffset(1100, 40),
		TextSize = 22, TextTransparency = 0.35, Parent = hud,
	})
	local toastT = 0
	local function showToast(text)
		toast.Text = text
		toast.TextTransparency = 0
		toastT = 2.6
	end

	local overlay = ui.new("Frame", {
		Size = UDim2.fromOffset(1920, 1080), BackgroundColor3 = Color3.fromRGB(6, 8, 20), BackgroundTransparency = 0.35, Parent = canvas,
	})
	ui.text("NIGHT SPIDER", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 380), Size = UDim2.fromOffset(1400, 160),
		TextSize = 140, Font = Enum.Font.GothamBlack, TextColor3 = CRIMSON, TextXAlignment = Enum.TextXAlignment.Center, Parent = overlay,
	})
	local overlaySub = ui.text("", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 500), Size = UDim2.fromOffset(1400, 50),
		TextSize = 32, TextXAlignment = Enum.TextXAlignment.Center, Parent = overlay,
	})
	local overlayHint = ui.text("", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 640), Size = UDim2.fromOffset(1400, 220),
		TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 0.2, Parent = overlay,
	})
	local function g(btn)
		return input:Glyph(btn)
	end
	local function showOverlay(kind)
		overlay.Visible = true
		if kind == "title" then
			overlaySub.Text = "The city never sleeps. Neither do you."
			overlayHint.Text = `{g("cross")} Start      {g("circle")} Quit\n\n`
				.. `Hold {g("cross")} in the air to swing  ·  {g("square")} punch  ·  {g("triangle")} web  ·  run into walls to climb`
		else
			overlaySub.Text = "Paused"
			overlayHint.Text = `{g("cross")} Resume      {g("circle")} Quit to home`
		end
	end
	showOverlay("title")

	-- Мир: столкновения с коробками зданий
	local function floorAt(pos, prevY)
		local floor = GY
		for _, b in buildings do
			if pos.X > b.min.X - 0.3 and pos.X < b.max.X + 0.3 and pos.Z > b.min.Z - 0.3 and pos.Z < b.max.Z + 0.3
				and b.top <= prevY + 0.6 and b.top > floor then
				floor = b.top
			end
		end
		return floor
	end

	-- Выталкивает точку из стен; возвращает новую позицию, нормаль стены и здание.
	local function pushOut(pos, r)
		for _, b in buildings do
			if pos.Y < b.top - 0.05 and pos.X > b.min.X - r and pos.X < b.max.X + r and pos.Z > b.min.Z - r and pos.Z < b.max.Z + r then
				local opts = {
					{ (b.min.X - r) - pos.X, Vector3.new(-1, 0, 0) },
					{ (b.max.X + r) - pos.X, Vector3.new(1, 0, 0) },
					{ (b.min.Z - r) - pos.Z, Vector3.new(0, 0, -1) },
					{ (b.max.Z + r) - pos.Z, Vector3.new(0, 0, 1) },
				}
				local best = opts[1]
				for k = 2, 4 do
					if math.abs(opts[k][1]) < math.abs(best[1]) then
						best = opts[k]
					end
				end
				local n = best[2]
				pos += Vector3.new(math.abs(n.X) * best[1], 0, math.abs(n.Z) * best[1])
				return pos, n, b
			end
		end
		return pos, nil, nil
	end

	local function clampCity(pos)
		local lim = HALF + 100
		return Vector3.new(
			math.clamp(pos.X, BASE.X - lim, BASE.X + lim),
			pos.Y,
			math.clamp(pos.Z, BASE.Z - lim, BASE.Z + lim)
		)
	end

	local function camVectors()
		local fwd = Vector3.new(math.sin(camYaw), 0, math.cos(camYaw))
		local right = Vector3.new(-math.cos(camYaw), 0, math.sin(camYaw))
		return fwd, right
	end

	local function inputDir()
		local a = input:GetAxes()
		local fwd, right = camVectors()
		local v = fwd * a.ly + right * a.lx
		if v.Magnitude > 1 then
			v = v.Unit
		end
		return v
	end

	-- Бандиты и вызовы
	local thugs = {}
	local crime = nil
	local nextCrime = 1.5
	local koTotal = 0

	local function hurtHero(amount, from)
		if hero.iframes > 0 then
			return
		end
		hero.hp -= amount
		hero.sinceHit = 0
		hero.iframes = 0.5
		if crime then
			crime.clean = false
		end
		local away = unitOr(flat(hero.pos - from), -hero.facing)
		if hero.state == "ground" then
			hero.vel = away * 28 + Y * 18
			hero.state = "air"
		end
		input:Rumble(0.6, 0.25)
		ctx.audio:Play("hit", { volume = 0.6 })
	end

	local function spawnThug(pos)
		local t = {
			fig = buildFigure(ctx.world, THUG),
			pos = pos,
			knock = Vector3.zero,
			hp = 3,
			state = "chase",
			t = 0,
			cd = 0.8 + rnd(),
			facing = Vector3.new(0, 0, 1),
			walk = rnd() * 6,
		}
		table.insert(thugs, t)
		return t
	end

	local beacon = part(ctx.world, Vector3.new(500, 10, 10), CFrame.new(BASE), CRIMSON, Enum.Material.SmoothPlastic, 1, Enum.PartType.Cylinder)
	local function startCrime()
		local options = {}
		for _, p in crossings do
			if (flat(p - hero.pos)).Magnitude > 180 then
				table.insert(options, p)
			end
		end
		if #options == 0 then
			options = crossings
		end
		local p = options[1 + math.floor(rnd() * #options)]
		crime = { pos = p, phase = "travel", clean = true }
		beacon.CFrame = CFrame.new(p + Vector3.new(0, 250, 0)) * CFrame.Angles(0, 0, math.pi / 2)
		beacon.Transparency = 0.55
		showToast("Crime in progress! Follow the red beacon")
		ctx.audio:Play("notify")
	end

	local function clearThugs()
		for _, t in thugs do
			t.fig.model:Destroy()
		end
		table.clear(thugs)
	end

	local function saveAll()
		ctx.save:Set("tokens", tokenStr)
		ctx.save:Set("crimes", stats.crimes)
		ctx.save:Set("webbed", stats.webbed)
		ctx.save:Set("topSpeed", math.floor(stats.topSpeed))
	end

	local function checkCrime()
		if not crime or crime.phase ~= "fight" then
			return
		end
		for _, t in thugs do
			if t.state ~= "down" then
				return
			end
		end
		stats.crimes += 1
		saveAll()
		ctx.trophies:Unlock("first_crime")
		if crime.clean then
			ctx.trophies:Unlock("untouchable")
		end
		if stats.crimes >= 10 then
			ctx.trophies:Unlock("hero")
		end
		hero.hp = MAX_HP
		showToast(crime.clean and "Crime stopped! Flawless" or "Crime stopped!")
		ctx.audio:Play("trophy", { volume = 0.5 })
		crime = nil
		nextCrime = 5
	end

	local function knockOut(t, dir)
		t.state = "down"
		t.t = 0
		t.knock = dir * 40
		t.fig.Web.part.Transparency = 1
		koTotal += 1
		ctx.audio:Play("explosion", { volume = 0.35, pitch = 1.4 })
		input:Rumble(0.8, 0.2)
		checkCrime()
	end

	local function nearestThug(range, needFree)
		local best, bestD = nil, range
		for _, t in thugs do
			if t.state ~= "down" and not (needFree and t.state == "stun") then
				local d = (t.pos + Y * 3 - (hero.pos + Y * 3)).Magnitude
				if d < bestD then
					best, bestD = t, d
				end
			end
		end
		return best, bestD
	end

	-- Действия героя
	local function startSwing()
		local f = unitOr(flat(hero.vel), hero.facing)
		local target = hero.pos + f * 55 + Y * 55
		local best, bestD = nil, math.huge
		for _, b in buildings do
			local c = Vector3.new(
				math.clamp(target.X, b.min.X, b.max.X),
				math.clamp(target.Y, GY, b.top),
				math.clamp(target.Z, b.min.Z, b.max.Z)
			)
			local d = (c - target).Magnitude
			if c.Y > hero.pos.Y + 10 and d < bestD and (flat(c - hero.pos)).Magnitude < 130 then
				best, bestD = c, d
			end
		end
		if not best then
			best = target -- над крышами цепляемся «за небо», чтобы полёт не обрывался
		end
		hero.anchor = best
		hero.ropeLen = (best - hero.pos).Magnitude
		hero.state = "swing"
		rope.Transparency = 0
		ctx.audio:Play("shoot", { volume = 0.35, pitch = 1.6 })
		ctx.trophies:Unlock("first_swing")
	end

	local function endSwing(boost)
		if hero.state ~= "swing" then
			return
		end
		hero.state = "air"
		hero.anchor = nil
		rope.Transparency = 1
		if boost then
			hero.vel += Y * 22 + unitOr(flat(hero.vel), hero.facing) * 10
		end
	end

	local function pressCross()
		if hero.state == "ground" then
			hero.vel += Y * JUMP
			hero.state = "air"
			ctx.audio:Play("move", { pitch = 0.8 })
		elseif hero.state == "wall" then
			hero.vel = hero.wallN * 42 + Y * 48
			hero.state = "air"
			hero.wall = nil
			hero.facing = flat(hero.wallN)
		elseif hero.state == "air" then
			startSwing()
		end
	end

	local function attack()
		if hero.attackCd > 0 then
			return
		end
		hero.attackCd = 0.28
		hero.punch = 0.2
		local range = hero.state == "ground" and 10 or 15
		local t, d = nearestThug(range, false)
		if not t then
			ctx.audio:Play("move", { pitch = 0.6, volume = 0.4 })
			return
		end
		endSwing(false)
		local dir = unitOr(flat(t.pos - hero.pos), hero.facing)
		hero.facing = dir
		if d > 3.5 then
			hero.pos = t.pos - dir * 3
			hero.pos = Vector3.new(hero.pos.X, math.max(hero.pos.Y, t.pos.Y), hero.pos.Z)
			hero.vel = Vector3.zero
		end
		hero.combo += 1
		hero.comboT = 1.6
		local finisher = hero.combo % 3 == 0
		input:Rumble(finisher and 0.7 or 0.35, 0.12)
		ctx.audio:Play("hit", { pitch = finisher and 0.8 or 1.1 })
		if t.state == "stun" or finisher then
			t.hp = 0
		else
			t.hp -= 1
			t.knock = dir * 18
			t.state = "chase"
			t.cd = math.max(t.cd, 0.5)
		end
		if t.hp <= 0 then
			knockOut(t, dir)
		end
	end

	local function shootWeb()
		if hero.webCd > 0 then
			return
		end
		hero.webCd = 0.6
		local t = nearestThug(48, true)
		ctx.audio:Play("shoot", { volume = 0.4, pitch = 1.3 })
		if not t then
			return
		end
		t.state = "stun"
		t.t = 4
		t.fig.Web.part.Transparency = 0.25
		stats.webbed += 1
		if stats.webbed >= 15 then
			ctx.trophies:Unlock("tangled")
		end
	end

	local function dodge()
		if hero.dodgeCd > 0 or hero.state == "swing" or hero.state == "wall" then
			return
		end
		hero.dodgeCd = 0.8
		hero.iframes = 0.45
		local d = inputDir()
		d = d.Magnitude > 0.2 and d.Unit or -hero.facing
		hero.vel = Vector3.new(0, hero.vel.Y, 0) + d * 50
		if hero.state == "ground" then
			hero.vel += Y * 12
			hero.state = "air"
		end
		ctx.audio:Play("move", { pitch = 1.3 })
	end

	local function respawn()
		hero.pos = START
		hero.vel = Vector3.zero
		hero.state = "ground"
		hero.hp = MAX_HP
		endSwing(false)
		clearThugs()
		if crime then
			crime.phase = "travel"
			crime.clean = true
			beacon.Transparency = 0.55
		end
		showToast("You were knocked out. Back at Night Tower")
	end

	-- Ввод
	ctx.input:On("press", function(btn)
		if state == "title" then
			if btn == "cross" then
				state = "play"
				overlay.Visible = false
				hud.Visible = true
				ctx.audio:Play("confirm")
			elseif btn == "circle" then
				ctx:Exit()
			end
			return
		elseif state == "pause" then
			if btn == "cross" or btn == "options" then
				state = "play"
				overlay.Visible = false
				hud.Visible = true
			elseif btn == "circle" then
				saveAll()
				ctx:Exit()
			end
			return
		end
		if btn == "options" then
			state = "pause"
			showOverlay("pause")
			hud.Visible = false
		elseif btn == "cross" then
			pressCross()
		elseif btn == "r2" then
			if hero.state == "air" then
				startSwing()
			end
		elseif btn == "square" then
			attack()
		elseif btn == "triangle" then
			shootWeb()
		elseif btn == "circle" then
			dodge()
		end
	end)
	ctx.input:On("release", function(btn)
		if state == "play" and (btn == "cross" or btn == "r2") and hero.state == "swing"
			and not input:IsDown("cross") and not input:IsDown("r2") then
			endSwing(true)
		end
	end)

	-- Физика героя
	local function enterWall(n, b)
		endSwing(false)
		hero.state = "wall"
		hero.wall = b
		hero.wallN = n
		hero.climbed = 0
		hero.vel = Vector3.zero
		hero.facing = -n
	end

	local function updateHero(dt)
		local dir = inputDir()
		local prevY = hero.pos.Y
		if hero.state == "wall" then
			local n, b = hero.wallN, hero.wall
			local into = dir:Dot(-n)
			if into < 0.2 then
				hero.state = "air"
				hero.vel = n * 10
				hero.wall = nil
			else
				local lateral = (dir + n * into) * 24
				hero.vel = Y * WALL_UP + lateral
				local p = hero.pos + hero.vel * dt
				-- держимся за грань
				if n.X ~= 0 then
					p = Vector3.new(n.X > 0 and b.max.X + R or b.min.X - R, p.Y, p.Z)
				else
					p = Vector3.new(p.X, p.Y, n.Z > 0 and b.max.Z + R or b.min.Z - R)
				end
				hero.pos = p
				hero.climbed += WALL_UP * dt
				if hero.climbed >= 80 then
					ctx.trophies:Unlock("wall_crawler")
				end
				local off = n.X ~= 0 and (p.Z < b.min.Z - R or p.Z > b.max.Z + R) or (n.X == 0 and (p.X < b.min.X - R or p.X > b.max.X + R))
				if p.Y >= b.top then
					hero.pos = Vector3.new(p.X, b.top + 0.2, p.Z)
					hero.vel = Y * 26 - n * 22
					hero.state = "air"
					hero.wall = nil
				elseif off then
					hero.state = "air"
					hero.wall = nil
				end
			end
			return
		end

		if hero.state == "ground" then
			local target = dir * RUN
			local hv = flat(hero.vel)
			hv = hv:Lerp(target, math.min(1, dt * 10))
			hero.vel = hv
		elseif hero.state == "air" then
			hero.vel += dir * 30 * dt - Y * G * dt
		elseif hero.state == "swing" then
			hero.vel += dir * 38 * dt - Y * G * dt
			hero.ropeLen = math.max(hero.ropeLen - 6 * dt, 14)
		end
		if hero.vel.Magnitude > MAX_SPEED then
			hero.vel = hero.vel.Unit * MAX_SPEED
		end

		local pos = hero.pos + hero.vel * dt
		if hero.state == "swing" then
			local d = pos - hero.anchor
			if d.Magnitude > hero.ropeLen then
				local radial = d.Unit
				pos = hero.anchor + radial * hero.ropeLen
				local vr = hero.vel:Dot(radial)
				if vr > 0 then
					hero.vel -= radial * vr
				end
			end
			if pos.Y > hero.anchor.Y - 3 then
				endSwing(true)
			end
		end

		-- пол и крыши
		local floor = floorAt(pos, prevY)
		if pos.Y <= floor then
			pos = Vector3.new(pos.X, floor, pos.Z)
			if hero.state ~= "ground" then
				endSwing(false)
				hero.state = "ground"
				hero.vel = flat(hero.vel) * 0.6
				if hero.vel.Magnitude > 4 then
					input:Rumble(0.2, 0.08)
				end
			end
			hero.vel = flat(hero.vel)
		elseif hero.state == "ground" and pos.Y > floor + 0.05 then
			hero.state = "air"
		end

		-- стены
		local n, b
		pos, n, b = pushOut(pos, R)
		if n then
			local vn = hero.vel:Dot(n)
			if vn < 0 then
				hero.vel -= n * vn
			end
			local into = dir:Dot(-n)
			if into > 0.3 and pos.Y < b.top - 3 then
				enterWall(n, b)
			end
		end
		hero.pos = clampCity(pos)

		local hv = flat(hero.vel)
		if hv.Magnitude > 3 and hero.state ~= "wall" then
			hero.facing = hv.Unit
		end
		if hero.state == "ground" and floor == tower.top then
			ctx.trophies:Unlock("skyline")
		end
	end

	local function updateThugs(dt)
		local senseOn = false
		for i = #thugs, 1, -1 do
			local t = thugs[i]
			t.knock *= math.exp(-6 * dt)
			local root
			if t.state == "down" then
				t.t += dt
				t.pos = pushOut(t.pos + t.knock * dt, 1.2)
				root = CFrame.lookAt(t.pos + Y * 0.6, t.pos + Y * 0.6 + t.facing) * CFrame.Angles(-math.pi / 2, 0, 0)
				if t.t > 3 then
					t.fig.model:Destroy()
					table.remove(thugs, i)
				else
					poseFigure(t.fig, root * CFrame.new(0, -2.5, 0), 0, 0, 0)
				end
				continue
			end
			local toHero = flat(hero.pos - t.pos)
			local dist = toHero.Magnitude
			local dy = math.abs(hero.pos.Y - t.pos.Y)
			local step = Vector3.zero
			t.cd -= dt
			if t.state == "stun" then
				t.t -= dt
				if t.t <= 0 then
					t.state = "chase"
					t.fig.Web.part.Transparency = 1
				end
			elseif t.state == "chase" then
				if dist > 0.1 then
					t.facing = toHero.Unit
				end
				if dy < 7 and dist < 80 and dist > 3.4 then
					step = t.facing * 15
					t.walk += dt * 9
				elseif dy < 6 and dist <= 4.5 and t.cd <= 0 then
					t.state = "windup"
					t.t = 0.55
				end
			elseif t.state == "windup" then
				senseOn = true
				t.t -= dt
				if t.t <= 0 then
					if dist < 5.5 and dy < 5 then
						hurtHero(12, t.pos)
					end
					t.state = "chase"
					t.cd = 1.1 + rnd() * 0.8
				end
			end
			-- не толпиться
			for _, o in thugs do
				if o ~= t and o.state ~= "down" then
					local away = flat(t.pos - o.pos)
					if away.Magnitude < 3 and away.Magnitude > 0.01 then
						step += away.Unit * 6
					end
				end
			end
			local p = t.pos + (step + t.knock) * dt
			t.pos = Vector3.new(p.X, t.pos.Y, p.Z)
			t.pos = pushOut(t.pos, 1.2)
			root = CFrame.lookAt(t.pos, t.pos + t.facing)
			local s = math.sin(t.walk) * 0.7
			local armUp = t.state == "windup" and -2.6 or (t.state == "stun" and 0 or -s)
			poseFigure(t.fig, root, s, -s, armUp)
		end
		return senseOn
	end

	local function updateCrime(dt)
		if not crime then
			nextCrime -= dt
			if nextCrime <= 0 then
				startCrime()
			end
			return
		end
		if crime.phase == "travel" and (flat(crime.pos - hero.pos)).Magnitude < 55 then
			crime.phase = "fight"
			beacon.Transparency = 1
			local count = math.min(3 + math.floor(stats.crimes / 2), 6)
			for k = 1, count do
				local a = k / count * math.pi * 2
				spawnThug(crime.pos + Vector3.new(math.cos(a) * 12, 0, math.sin(a) * 12))
			end
			showToast("Take them down!")
		end
	end

	local function updateTokens()
		for k, t in tokens do
			if not t.got then
				t.part.CFrame = CFrame.new(t.pos + Y * math.sin(clock * 2 + k) * 0.5) * CFrame.Angles(0, clock * 2 + k, 0)
				if (t.pos - (hero.pos + Y * 2.5)).Magnitude < 5 then
					t.got = true
					t.part:Destroy()
					t.part = nil
					tokenStr = tokenStr:sub(1, k - 1) .. "1" .. tokenStr:sub(k + 1)
					saveAll()
					local n = tokenCount()
					showToast(`Spider token {n}/{TOKENS}`)
					ctx.audio:Play("confirm", { pitch = 1.3 })
					if n >= TOKENS then
						ctx.trophies:Unlock("collector")
					end
				end
			end
		end
	end

	local function updateCamera(dt)
		local a = input:GetAxes()
		local turn = a.rx
		if input:IsDown("l1") then
			turn -= 1
		end
		if input:IsDown("r1") then
			turn += 1
		end
		if math.abs(turn) > 0.1 then
			camYaw -= turn * 2.4 * dt
			camManual = 1.2
		else
			camManual -= dt
		end
		local hv = flat(hero.vel)
		if camManual <= 0 and hv.Magnitude > 14 and hero.state ~= "wall" then
			local want = math.atan2(hv.X, hv.Z)
			local diff = (want - camYaw + math.pi) % (math.pi * 2) - math.pi
			camYaw += diff * math.min(1, dt * (hero.state == "swing" and 2.2 or 1.5))
		end
		local fwd = camVectors()
		local speed = hero.vel.Magnitude
		local dist = 16 + speed * 0.06
		local height = hero.state == "wall" and 3 or 6
		local focus = hero.pos + Y * 3.5
		local camPos = focus - fwd * dist + Y * height
		camSmooth = camSmooth and camSmooth:Lerp(camPos, math.min(1, dt * 10)) or camPos
		camera.CFrame = CFrame.lookAt(camSmooth, focus + fwd * 6)
		camera.FieldOfView = 70 + math.min(speed, MAX_SPEED) * 0.12
	end

	local function updateHeroModel(senseOn)
		local up = Y
		if hero.state == "swing" and hero.anchor then
			up = unitOr((hero.anchor - hero.pos).Unit + Y, Y)
		end
		local root = CFrame.lookAt(hero.pos, hero.pos + hero.facing, up)
		local speed = flat(hero.vel).Magnitude
		local legA, legB, armUp = 0, 0, 0
		if hero.state == "ground" then
			hero.run += speed * 0.12 * (1 / 60)
			legA = math.sin(hero.run * 6) * math.min(speed / RUN, 1) * 0.9
			legB = -legA
			armUp = legA
		elseif hero.state == "swing" then
			legA, legB, armUp = 0.5, 0.3, -3.0
		elseif hero.state == "wall" then
			local s = math.sin(clock * 14) * 0.7
			legA, legB, armUp = s, -s, -2.4 + s
		else
			legA, legB, armUp = 0.6, -0.4, -1.2
		end
		if hero.punch > 0 then
			armUp = -1.6
		end
		-- на стене тело наклонено к стене, на тросе — вдоль троса
		if hero.state == "wall" then
			root = root * CFrame.Angles(0.35, 0, 0)
		end
		poseFigure(fig, root, legA, legB, armUp)
		fig.Sense.part.Transparency = senseOn and (math.sin(clock * 30) > 0 and 0 or 0.6) or 1
		if hero.state == "swing" and hero.anchor then
			local hand = hero.pos + up * 6
			local len = (hero.anchor - hand).Magnitude
			rope.Size = Vector3.new(0.18, 0.18, len)
			rope.CFrame = CFrame.lookAt((hand + hero.anchor) / 2, hero.anchor)
		end
	end

	local function updateHud()
		hpFill.Size = UDim2.fromScale(math.clamp(hero.hp / MAX_HP, 0, 1), 1)
		statsLabel.Text = `Crimes stopped: {stats.crimes}\nTokens: {tokenCount()}/{TOKENS}`
		local speed = math.floor(hero.vel.Magnitude)
		speedLabel.Text = `{speed} <font size="24">SPD</font>`
		speedLabel.RichText = true
		local target
		if crime and crime.phase == "travel" then
			target = crime.pos
			objective.Text = `Crime in progress · {math.floor((flat(crime.pos - hero.pos)).Magnitude)} m`
		elseif crime then
			local left = 0
			for _, t in thugs do
				if t.state ~= "down" then
					left += 1
				end
			end
			objective.Text = `Thugs left: {left}`
		else
			objective.Text = "Patrol the city · find spider tokens"
		end
		if target then
			local fwd, right = camVectors()
			local d = flat(target - hero.pos)
			arrow.Visible = true
			arrow.Rotation = math.deg(math.atan2(d:Dot(right), d:Dot(fwd)))
		else
			arrow.Visible = false
		end
		comboLabel.Text = hero.combo >= 2 and `x{hero.combo} COMBO` or ""
		if hero.state == "wall" then
			hint.Text = `{g("cross")} leap off  ·  let go of the stick to drop`
		elseif hero.state == "swing" then
			hint.Text = `Release {g("cross")} to fly`
		elseif hero.state == "air" then
			hint.Text = `Hold {g("cross")} to swing`
		else
			hint.Text = `{g("cross")} jump  ·  {g("square")} punch  ·  {g("triangle")} web  ·  {g("circle")} dodge  ·  {g("options")} pause`
		end
	end

	ctx:Loop(function(dt)
		dt = math.min(dt, 1 / 20)
		clock += dt
		if state == "title" then
			local a = clock * 0.12
			local center = Vector3.new(tower.center.X, GY + 160, tower.center.Z)
			camera.CFrame = CFrame.lookAt(center + Vector3.new(math.sin(a) * 320, 60, math.cos(a) * 320), center)
			updateTokens()
			updateHeroModel(false)
			return
		elseif state == "pause" then
			return
		end
		hero.attackCd -= dt
		hero.webCd -= dt
		hero.dodgeCd -= dt
		hero.iframes -= dt
		hero.punch -= dt
		hero.sinceHit += dt
		hero.comboT -= dt
		if hero.comboT <= 0 then
			hero.combo = 0
		end
		if hero.sinceHit > 4 then
			hero.hp = math.min(MAX_HP, hero.hp + 6 * dt)
		end
		updateHero(dt)
		local senseOn = updateThugs(dt)
		updateCrime(dt)
		updateTokens()
		updateCamera(dt)
		updateHeroModel(senseOn)
		updateHud()
		local speed = hero.vel.Magnitude
		if speed > stats.topSpeed then
			stats.topSpeed = speed
		end
		if speed >= 150 then
			ctx.trophies:Unlock("velocity")
		end
		if hero.hp <= 0 then
			respawn()
		end
		if toastT > 0 then
			toastT -= dt
			if toastT < 0.6 then
				toast.TextTransparency = 1 - math.max(toastT, 0) / 0.6
			end
		end
	end)

	ctx:On("pause", function()
		if state == "play" then
			state = "pause"
			showOverlay("pause")
			hud.Visible = false
		end
	end)
	ctx:On("exit", function()
		saveAll()
		camera.FieldOfView = 70
	end)

	-- Для дымового теста
	Game.debug = setmetatable({ hero = hero, thugs = thugs, buildings = buildings, tower = tower, tokenList = tokens }, {
		__index = function(_, k)
			if k == "state" then
				return state
			elseif k == "crime" then
				return crime
			elseif k == "stats" then
				return stats
			elseif k == "tokens" then
				return tokenCount()
			end
			return nil
		end,
	})
	Game.debug.startCrime = function()
		nextCrime = 0
	end
	Game.debug.look = function(yaw)
		camYaw = yaw
		camManual = 99
	end
	Game.debug.teleport = function(p)
		hero.pos = p
		hero.vel = Vector3.zero
		hero.state = "air"
	end
end

return Game
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "night_spider",
	title = "Night Spider",
	category = "game", -- game | media | app
	genre = "Action",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 8,
	description = "Swing through a neon city on your webs, run up skyscrapers and stop street crime.",
	icon = "🕷",
	colors = { "#E0213B", "#101A3A" },
	controls = {
		{ "Stick / WASD", "Run, steer in the air" },
		{ "✕ / Space", "Jump; hold in the air to swing" },
		{ "✕ on a wall", "Leap off the wall" },
		{ "□ / F", "Punch (3 hits = finisher)" },
		{ "△ / R", "Shoot web (stuns a thug)" },
		{ "○ / Backspace", "Dodge" },
		{ "L1 R1 / Q E, right stick", "Turn camera" },
		{ "OPTIONS / O", "Pause" },
	},
	trophies = {
		{ id = "first_swing", name = "Swing Into Action", description = "Swing on a web for the first time", grade = "bronze" },
		{ id = "wall_crawler", name = "Up the Wall", description = "Run 80 studs up a wall in one go", grade = "bronze" },
		{ id = "skyline", name = "Top of the City", description = "Stand on top of Night Tower", grade = "bronze" },
		{ id = "first_crime", name = "Night Watch", description = "Stop your first crime", grade = "bronze" },
		{ id = "tangled", name = "Tangled Up", description = "Web 15 thugs", grade = "bronze" },
		{ id = "velocity", name = "Terminal Velocity", description = "Reach a speed of 150", grade = "silver" },
		{ id = "untouchable", name = "Untouchable", description = "Stop a crime without taking damage", grade = "silver", hidden = true },
		{ id = "hero", name = "Neighborhood Hero", description = "Stop 10 crimes", grade = "silver" },
		{ id = "collector", name = "Token Hunter", description = "Find all 20 spider tokens on the rooftops", grade = "gold" },
		{ id = "platinum", name = "Night Legend", description = "Earn every Night Spider trophy", grade = "platinum" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">OrbitStrike</string>
          <string name="Source"><![CDATA[-- Orbit Strike: 2D twin-stick shooter on the canvas. Protect the space station in the centre from waves of drones.
-- Uses ctx.input (sticks, buttons, rumble), ctx.save, ctx.trophies, ctx.audio and ctx:Loop.
local Game = {}

local W, H = 1920, 1080
local CX, CY = W / 2, H / 2 + 40 -- station centre (HUD takes the top band)
local TOP = 110
local SHIP_R = 24
local SHIP_SPEED = 640
local BULLET_SPEED = 1500
local ENEMY_BULLET_SPEED = 420
local STATION_R = 72
local STATION_MAX = 100
local PULSE_RADIUS = 440
local COMBO_TIME = 2.5
local MAX_PARTICLES = 220

local ORANGE = Color3.fromRGB(248, 150, 30)
local CYAN = Color3.fromRGB(110, 230, 255)
local WHITE = Color3.new(1, 1, 1)

local DRONES = {
	scout = { r = 18, hp = 1, speed = 240, score = 50, damage = 6, charge = 6, color = Color3.fromRGB(255, 176, 64) },
	brute = { r = 34, hp = 6, speed = 105, score = 150, damage = 15, charge = 12, color = Color3.fromRGB(255, 84, 60) },
	gunner = { r = 24, hp = 3, speed = 170, score = 120, damage = 8, charge = 10, color = Color3.fromRGB(186, 110, 255), orbit = 380 },
	mother = { r = 84, hp = 70, speed = 60, score = 2500, damage = 40, charge = 40, color = Color3.fromRGB(255, 60, 120), orbit = 470 },
}

local PICKUPS = {
	repair = { glyph = "+", color = Color3.fromRGB(90, 255, 140), label = "Station repaired" },
	rapid = { glyph = "»", color = CYAN, label = "Rapid fire" },
	shield = { glyph = "▲", color = Color3.fromRGB(255, 220, 90), label = "Extra ship" },
}

local function dist2(ax, ay, bx, by)
	return (ax - bx) ^ 2 + (ay - by) ^ 2
end

-- Rotation of a "▲" glyph pointing along (dx, dy) in screen space.
local function angleOf(dx, dy)
	return math.deg(math.atan2(dx, -dy))
end

function Game.launch(ctx)
	local ui = ctx.ui
	local input = ctx.input
	local font, fontBold = ctx.theme.FontMedium, ctx.theme.FontBold

	ctx.gui.BackgroundColor3 = Color3.fromRGB(3, 3, 12)
	ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = ctx.gui,
	}, { ui.gradient({ Color3.fromRGB(30, 11, 4), Color3.fromRGB(3, 3, 14) }, 90) })
	local canvas = ui.canvas(ctx.gui, W, H)
	canvas.ClipsDescendants = true
	-- Everything that shakes lives in field; the HUD sits on the canvas itself.
	local field = ui.new("Frame", { Size = UDim2.fromOffset(W, H), BackgroundTransparency = 1, Parent = canvas })

	local function circle(size, color, props, children)
		props = props or {}
		props.AnchorPoint = Vector2.new(0.5, 0.5)
		props.Size = UDim2.fromOffset(size, size)
		props.BackgroundColor3 = color
		props.BorderSizePixel = 0
		props.Parent = props.Parent or field
		children = children or {}
		table.insert(children, ui.corner(UDim.new(0.5, 0)))
		return ui.new("Frame", props, children)
	end

	-- Background: stars and a distant planet
	local stars = {}
	for _ = 1, 110 do
		local size = math.random(1, 3)
		local star = ui.new("Frame", {
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.2 + math.random() * 0.6,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(size, size),
			Parent = field,
		})
		table.insert(stars, { frame = star, x = math.random() * W, y = math.random() * H, speed = 6 + size * 8 })
	end
	circle(900, Color3.fromRGB(200, 90, 20), { Position = UDim2.fromOffset(-120, H + 260), BackgroundTransparency = 0.1 }, {
		ui.gradient({ Color3.fromRGB(255, 170, 70), Color3.fromRGB(60, 15, 0) }, 315),
	})
	circle(1100, ORANGE, { Position = UDim2.fromOffset(-120, H + 260), BackgroundTransparency = 1 }, {
		ui.stroke(ORANGE, 3, 0.75),
	})

	-- Station: core, orbit ring and solar panels that circle around it
	local stationRing = circle(STATION_R * 2 + 90, ORANGE, { Position = UDim2.fromOffset(CX, CY), BackgroundTransparency = 1, ZIndex = 2 }, {
		ui.stroke(ORANGE, 3, 0.45),
	})
	local stationCore = circle(STATION_R * 2, ORANGE, { Position = UDim2.fromOffset(CX, CY), ZIndex = 3 }, {
		ui.gradient({ Color3.fromRGB(255, 220, 160), Color3.fromRGB(150, 60, 10) }, 45),
		ui.stroke(WHITE, 3, 0.3),
	})
	circle(STATION_R, Color3.fromRGB(40, 16, 4), { Position = UDim2.fromOffset(CX, CY), ZIndex = 4 }, { ui.stroke(ORANGE, 2, 0.2) })
	local stationLight = circle(26, CYAN, { Position = UDim2.fromOffset(CX, CY), ZIndex = 5 })
	local panels = {}
	for i = 1, 4 do
		panels[i] = ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(56, 22),
			BackgroundColor3 = Color3.fromRGB(40, 80, 160),
			BorderSizePixel = 0,
			ZIndex = 2,
			Parent = field,
		}, { ui.stroke(CYAN, 2, 0.3), ui.corner(3) })
	end

	-- Player ship
	local ship = ui.text("▲", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(SHIP_R * 2 + 10, SHIP_R * 2 + 10),
		TextScaled = true,
		Font = fontBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = CYAN,
		ZIndex = 8,
		Parent = field,
	})
	local shipGlow = circle(SHIP_R * 3, CYAN, { BackgroundTransparency = 0.85, ZIndex = 7 })
	local aimDot = circle(10, CYAN, { BackgroundTransparency = 0.3, ZIndex = 7 })

	-- HUD
	local function hudText(props)
		props.Font = props.Font or fontBold
		props.ZIndex = 20
		props.Parent = canvas
		return ui.text("", props)
	end
	ui.new("Frame", {
		Size = UDim2.fromOffset(W, 90),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		ZIndex = 19,
		Parent = canvas,
	})
	local scoreText = hudText({ Size = UDim2.fromOffset(600, 44), Position = UDim2.fromOffset(40, 10), TextSize = 38 })
	local comboText = hudText({ Size = UDim2.fromOffset(600, 30), Position = UDim2.fromOffset(40, 52), TextSize = 24, TextColor3 = ORANGE })
	local waveText = hudText({
		Size = UDim2.fromOffset(600, 44), Position = UDim2.fromOffset(W / 2 - 300, 10), TextSize = 36,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local leftText = hudText({
		Size = UDim2.fromOffset(600, 30), Position = UDim2.fromOffset(W / 2 - 300, 52), TextSize = 22, Font = font,
		TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(200, 200, 210),
	})
	hudText({ Text = "STATION", Size = UDim2.fromOffset(160, 30), Position = UDim2.fromOffset(W - 520, 14), TextSize = 22 })
	local hpBack = ui.new("Frame", {
		Size = UDim2.fromOffset(340, 18), Position = UDim2.fromOffset(W - 380, 20),
		BackgroundColor3 = Color3.fromRGB(40, 40, 50), BorderSizePixel = 0, ZIndex = 20, Parent = canvas,
	}, { ui.corner(9) })
	local hpBar = ui.new("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(90, 255, 140), BorderSizePixel = 0, ZIndex = 21, Parent = hpBack,
	}, { ui.corner(9) })
	local livesText = hudText({
		Size = UDim2.fromOffset(480, 30), Position = UDim2.fromOffset(W - 520, 50), TextSize = 24, TextColor3 = CYAN,
	})
	local pulseLabel = hudText({
		Size = UDim2.fromOffset(500, 30), Position = UDim2.fromOffset(W / 2 - 250, H - 76), TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local pulseBack = ui.new("Frame", {
		Size = UDim2.fromOffset(420, 12), Position = UDim2.fromOffset(W / 2 - 210, H - 40),
		BackgroundColor3 = Color3.fromRGB(40, 40, 50), BorderSizePixel = 0, ZIndex = 20, Parent = canvas,
	}, { ui.corner(6) })
	local pulseBar = ui.new("Frame", {
		Size = UDim2.fromScale(0, 1), BackgroundColor3 = CYAN, BorderSizePixel = 0, ZIndex = 21, Parent = pulseBack,
	}, { ui.corner(6) })
	local banner = hudText({
		Size = UDim2.fromOffset(W, 120), Position = UDim2.fromOffset(0, CY - 290), TextSize = 64, Font = ctx.theme.FontHeavy,
		TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = ORANGE, TextStrokeTransparency = 0.4,
	})
	local subBanner = hudText({
		Size = UDim2.fromOffset(W, 40), Position = UDim2.fromOffset(0, CY - 180), TextSize = 28, Font = font,
		TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.5,
	})
	local menuBack = ui.new("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45,
		BorderSizePixel = 0, ZIndex = 29, Visible = false, Parent = canvas,
	})
	local centerText = hudText({
		Size = UDim2.fromOffset(W, 460), Position = UDim2.fromOffset(0, H / 2 - 230), TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	centerText.ZIndex = 30

	-- Game state
	local state, menuIndex = "play", 1
	local phase, phaseTimer -- "intro" | "fight" | "clear"
	local x, y, vx, vy, aimX, aimY
	local lives, score, wave, stationHp, stationHitThisWave
	local cooldown, invuln, rapidTime, pulse, combo, comboTimer, shake, elapsed
	local spawnQueue, spawnTimer, spawnInterval
	local bullets, enemyBullets, drones, pickups, particles, rings = {}, {}, {}, {}, {}, {}
	local best = ctx.save:Get("best", 0)
	local bestWave = ctx.save:Get("bestWave", 0)

	local function clearEntities()
		for _, list in { bullets, enemyBullets, drones, pickups, particles, rings } do
			for _, e in list do
				e.frame:Destroy()
			end
			table.clear(list)
		end
	end

	-- Effects
	local function burst(px, py, color, count, speed)
		for _ = 1, count do
			if #particles >= MAX_PARTICLES then
				break
			end
			local size = math.random(4, 9)
			local a = math.random() * math.pi * 2
			local s = speed * (0.4 + math.random() * 0.8)
			local f = ui.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = color, BorderSizePixel = 0,
				Size = UDim2.fromOffset(size, size), Position = UDim2.fromOffset(px, py), ZIndex = 6, Parent = field,
			})
			table.insert(particles, { frame = f, x = px, y = py, vx = math.cos(a) * s, vy = math.sin(a) * s, life = 0.4 + math.random() * 0.4, t = 0 })
		end
	end

	local function ring(px, py, radius, color, duration)
		local f = circle(10, color, { Position = UDim2.fromOffset(px, py), BackgroundTransparency = 1, ZIndex = 6 }, { ui.stroke(color, 4, 0) })
		table.insert(rings, { frame = f, stroke = f:FindFirstChildOfClass("UIStroke"), radius = radius, t = 0, duration = duration })
	end

	local function floatText(px, py, txt, color)
		local f = ui.text(txt, {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(300, 30), Position = UDim2.fromOffset(px, py),
			TextSize = 24, Font = fontBold, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 9, Parent = field,
		})
		table.insert(particles, { frame = f, x = px, y = py, vx = 0, vy = -60, life = 0.9, t = 0, text = true })
	end

	-- Drones
	local function spawnDrone(kind, px, py)
		local def = DRONES[kind]
		local size = def.r * 2
		local frame
		if kind == "scout" then
			frame = ui.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size * 0.75, size * 0.75), Rotation = 45,
				BackgroundColor3 = def.color, BorderSizePixel = 0, ZIndex = 5, Parent = field,
			}, { ui.corner(4), ui.stroke(WHITE, 2, 0.5) })
		elseif kind == "brute" then
			frame = ui.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size),
				BackgroundColor3 = def.color, BorderSizePixel = 0, ZIndex = 5, Parent = field,
			}, { ui.corner(10), ui.stroke(Color3.fromRGB(255, 200, 160), 3, 0.3) })
			circle(size * 0.45, Color3.fromRGB(60, 10, 0), { Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6, Parent = frame })
		elseif kind == "gunner" then
			frame = circle(size, def.color, { ZIndex = 5 }, { ui.stroke(WHITE, 3, 0.35) })
			circle(size * 0.4, WHITE, { Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6, Parent = frame })
		else
			frame = circle(size, def.color, { ZIndex = 5 }, {
				ui.gradient({ Color3.fromRGB(255, 120, 170), Color3.fromRGB(110, 10, 50) }, 45),
				ui.stroke(WHITE, 4, 0.3),
			})
			circle(size * 0.5, Color3.fromRGB(30, 0, 15), { Position = UDim2.fromScale(0.5, 0.5), ZIndex = 6, Parent = frame }, { ui.stroke(def.color, 3, 0) })
			circle(size * 0.18, Color3.fromRGB(255, 220, 90), { Position = UDim2.fromScale(0.5, 0.5), ZIndex = 7, Parent = frame })
		end
		local hpScale = 1 + math.max(0, wave - 4) * 0.08
		local drone = {
			kind = kind, def = def, frame = frame, color = def.color, x = px, y = py, r = def.r,
			hp = math.ceil(def.hp * hpScale), maxHp = math.ceil(def.hp * hpScale),
			speed = def.speed * (1 + math.min(wave, 15) * 0.025),
			angle = math.atan2(py - CY, px - CX), dir = math.random() < 0.5 and -1 or 1,
			fireTimer = 1 + math.random() * 1.5, spawnTimer = 3, flash = 0, wobble = math.random() * 10,
		}
		frame.Position = UDim2.fromOffset(px, py)
		table.insert(drones, drone)
		return drone
	end

	local function edgePoint()
		local a = math.random() * math.pi * 2
		return CX + math.cos(a) * 1080, CY + math.sin(a) * 640
	end

	local function buildWave(n)
		local queue = {}
		for _ = 1, 4 + n * 2 do
			table.insert(queue, "scout")
		end
		for _ = 1, math.floor(n / 2) do
			table.insert(queue, "brute")
		end
		for _ = 1, math.max(0, math.floor((n - 1) / 2)) do
			table.insert(queue, "gunner")
		end
		-- shuffle, then the mothership arrives in the middle of every fifth wave
		for i = #queue, 2, -1 do
			local j = math.random(1, i)
			queue[i], queue[j] = queue[j], queue[i]
		end
		if n % 5 == 0 then
			table.insert(queue, math.floor(#queue / 2) + 1, "mother")
		end
		return queue
	end

	local function showBanner(title, sub)
		banner.Text = title
		subBanner.Text = sub or ""
	end

	local function startWave(n)
		wave = n
		phase, phaseTimer = "intro", 2.4
		spawnQueue = buildWave(n)
		spawnInterval = math.max(0.32, 1.25 - n * 0.07)
		spawnTimer = 0
		stationHitThisWave = false
		if n >= 5 then
			ctx.trophies:Unlock("wave_5")
		end
		if n >= 10 then
			ctx.trophies:Unlock("wave_10")
		end
		local sub = n % 5 == 0 and "Warning: mothership incoming" or `{#spawnQueue} drones inbound`
		if n == 1 then
			sub = `Protect the station!   Fire: {input:Glyph("cross")}   Pulse bomb: {input:Glyph("l1")}`
		end
		showBanner(`WAVE {n}`, sub)
		ctx.audio:Play("notify", { volume = 0.5, pitch = 0.9 })
	end

	local function reset()
		clearEntities()
		x, y, vx, vy = CX, CY + 240, 0, 0
		aimX, aimY = 0, -1
		lives, score, stationHp = 3, 0, STATION_MAX
		cooldown, invuln, rapidTime, pulse, combo, comboTimer, shake, elapsed = 0, 2, 0, 0, 0, 0, 0, 0
		state = "play"
		centerText.Text = ""
		menuBack.Visible = false
		startWave(1)
	end

	local MENU = { "Resume", "Restart", "Quit to PS5 Menu" }
	local function drawMenu()
		local lines = { "PAUSED", "" }
		for i, item in MENU do
			table.insert(lines, (i == menuIndex and "▶  " or "    ") .. item)
		end
		centerText.Text = table.concat(lines, "\n")
		menuBack.Visible = true
	end

	local function resume()
		state = "play"
		centerText.Text = ""
		menuBack.Visible = false
	end

	local function gameOver(reason)
		state = "over"
		input:Rumble(1, 0.6)
		ctx.audio:Play("explosion", { volume = 0.9, pitch = 0.5 })
		local newBest = score > best
		if newBest then
			best = score
			ctx.save:Set("best", best)
		end
		if wave > bestWave then
			bestWave = wave
			ctx.save:Set("bestWave", bestWave)
		end
		ctx.save:Set("games", ctx.save:Get("games", 0) + 1)
		showBanner("", "")
		menuBack.Visible = true
		centerText.Text = `{reason}\n\nScore: {score}{newBest and "   NEW BEST!" or ""}\nWave reached: {wave}   Best: {best} (wave {bestWave})\n\n{input:Glyph("cross")} — play again    {input:Glyph("circle")} — quit`
	end

	local function addScore(points, px, py)
		local mult = math.min(1 + combo // 5, 8)
		local gained = points * mult
		score += gained
		if px then
			floatText(px, py - 30, `+{gained}`, mult > 1 and ORANGE or WHITE)
		end
		if score >= 10000 then
			ctx.trophies:Unlock("score_10000")
		end
	end

	local function dropPickup(px, py, kind)
		if not kind then
			local roll = math.random()
			if roll < 0.4 then
				kind = "repair"
			elseif roll < 0.85 then
				kind = "rapid"
			else
				kind = "shield"
			end
		end
		local def = PICKUPS[kind]
		local f = circle(44, def.color, { Position = UDim2.fromOffset(px, py), BackgroundTransparency = 0.3, ZIndex = 6 }, { ui.stroke(WHITE, 2, 0.2) })
		ui.text(def.glyph, {
			Size = UDim2.fromScale(1, 1), TextScaled = true, Font = fontBold, TextColor3 = Color3.new(0, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 7, Parent = f,
		})
		table.insert(pickups, { frame = f, kind = kind, x = px, y = py, life = 10 })
	end

	local function killDrone(i, byPulse)
		local d = drones[i]
		table.remove(drones, i)
		d.frame:Destroy()
		burst(d.x, d.y, d.color, d.kind == "mother" and 40 or (d.kind == "brute" and 16 or 9), d.kind == "mother" and 500 or 300)
		ring(d.x, d.y, d.r * 3, d.color, 0.35)
		combo += 1
		comboTimer = COMBO_TIME
		if combo >= 20 then
			ctx.trophies:Unlock("combo_20")
		end
		addScore(d.def.score, d.x, d.y)
		pulse = math.min(100, pulse + d.def.charge)
		ctx.trophies:Unlock("first_kill")
		if d.kind == "mother" then
			ctx.trophies:Unlock("mothership")
			ctx.audio:Play("explosion", { volume = 1, pitch = 0.45 })
			input:Rumble(1, 0.8)
			shake = 0.6
			dropPickup(d.x - 40, d.y, "repair")
			dropPickup(d.x + 40, d.y, "rapid")
			showBanner("MOTHERSHIP DOWN", "")
			phaseTimer = math.max(phaseTimer or 0, 0)
		else
			if not byPulse then
				ctx.audio:Play("explosion", { volume = 0.3, pitch = 1.3 + math.random() * 0.3 })
			end
			local chance = d.kind == "brute" and 0.25 or (d.kind == "gunner" and 0.15 or 0.05)
			if math.random() < chance then
				dropPickup(d.x, d.y)
			end
		end
	end

	local function damageDrone(i, amount)
		local d = drones[i]
		d.hp -= amount
		d.flash = 0.06
		if d.hp <= 0 then
			killDrone(i, false)
			return true
		end
		ctx.audio:Play("hit", { volume = 0.15, pitch = 1.6 })
		return false
	end

	local function hurtStation(amount)
		stationHp = math.max(0, stationHp - amount)
		stationHitThisWave = true
		shake = math.max(shake, 0.25)
		input:Rumble(0.5, 0.2)
		ctx.audio:Play("hit", { volume = 0.5, pitch = 0.6 })
		stationCore.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
		if stationHp <= 0 then
			burst(CX, CY, ORANGE, 50, 600)
			gameOver("STATION DESTROYED")
		end
	end

	local function hurtShip()
		if invuln > 0 or state ~= "play" then
			return
		end
		lives -= 1
		invuln = 2
		combo = 0
		shake = 0.4
		input:Rumble(0.9, 0.35)
		ctx.audio:Play("explosion", { volume = 0.6, pitch = 0.8 })
		burst(x, y, CYAN, 20, 400)
		if lives <= 0 then
			gameOver("SHIP DESTROYED")
		end
	end

	local function firePulse()
		if pulse < 100 or state ~= "play" then
			return
		end
		pulse = 0
		ring(x, y, PULSE_RADIUS, CYAN, 0.45)
		ring(x, y, PULSE_RADIUS * 0.6, WHITE, 0.3)
		ctx.audio:Play("explosion", { volume = 0.8, pitch = 0.7 })
		input:Rumble(1, 0.4)
		shake = 0.35
		local killed = 0
		for i = #drones, 1, -1 do
			local d = drones[i]
			if dist2(d.x, d.y, x, y) < (PULSE_RADIUS + d.r) ^ 2 then
				if d.kind == "mother" then
					d.hp -= 15
					d.flash = 0.1
					if d.hp <= 0 then
						killDrone(i, true)
						killed += 1
					end
				else
					killDrone(i, true)
					killed += 1
				end
			end
		end
		for i = #enemyBullets, 1, -1 do
			local b = enemyBullets[i]
			if dist2(b.x, b.y, x, y) < PULSE_RADIUS ^ 2 then
				b.frame:Destroy()
				table.remove(enemyBullets, i)
			end
		end
		if killed >= 5 then
			ctx.trophies:Unlock("pulse_5")
		end
	end

	local function shoot(dx, dy)
		local spread = rapidTime > 0 and { -0.12, 0, 0.12 } or { 0 }
		local base = math.atan2(dy, dx)
		for _, off in spread do
			local a = base + off
			local b = ui.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = rapidTime > 0 and WHITE or CYAN, BorderSizePixel = 0,
				Size = UDim2.fromOffset(24, 6), Rotation = math.deg(a), ZIndex = 6, Parent = field,
			}, { ui.corner(3) })
			table.insert(bullets, { frame = b, x = x + math.cos(a) * 30, y = y + math.sin(a) * 30, vx = math.cos(a) * BULLET_SPEED, vy = math.sin(a) * BULLET_SPEED })
		end
		ctx.audio:Play("shoot", { volume = 0.12, pitch = 1.9 + math.random() * 0.2 })
	end

	local function enemyShoot(d, tx, ty, spread)
		local base = math.atan2(ty - d.y, tx - d.x)
		for _, off in spread do
			local a = base + off
			local f = circle(14, Color3.fromRGB(255, 90, 200), { Position = UDim2.fromOffset(d.x, d.y), ZIndex = 6 }, { ui.stroke(WHITE, 2, 0.3) })
			table.insert(enemyBullets, { frame = f, x = d.x, y = d.y, vx = math.cos(a) * ENEMY_BULLET_SPEED, vy = math.sin(a) * ENEMY_BULLET_SPEED })
		end
	end

	local function nearestDrone()
		local bestD, bestDist = nil, math.huge
		for _, d in drones do
			local onScreen = d.x > 0 and d.x < W and d.y > TOP - 40 and d.y < H
			local dd = dist2(d.x, d.y, x, y)
			if onScreen and dd < bestDist then
				bestD, bestDist = d, dd
			end
		end
		return bestD
	end

	-- Input
	input:On("press", function(btn)
		if state == "play" then
			if btn == "options" then
				state, menuIndex = "paused", 1
				drawMenu()
			elseif btn == "l1" or btn == "r1" then
				firePulse()
			end
		elseif state == "paused" then
			if btn == "up" or btn == "down" then
				menuIndex = (menuIndex - 1 + (btn == "down" and 1 or -1)) % #MENU + 1
				ctx.audio:Play("move", { volume = 0.3, pitch = 1.6 })
				drawMenu()
			elseif btn == "circle" or btn == "options" then
				resume()
			elseif btn == "cross" then
				ctx.audio:Play("confirm", { volume = 0.4 })
				if menuIndex == 1 then
					resume()
				elseif menuIndex == 2 then
					reset()
				else
					ctx:Exit()
				end
			end
		elseif state == "over" then
			if btn == "cross" then
				reset()
			elseif btn == "circle" then
				ctx:Exit()
			end
		end
	end)

	-- System pause (PS button): ctx:Loop stops by itself, and the game menu is waiting on return.
	ctx:On("pause", function()
		if state == "play" then
			state, menuIndex = "paused", 1
			drawMenu()
		end
	end)

	reset()

	local stationSpin = 0
	ctx:Loop(function(dt)
		dt = math.min(dt, 1 / 20)
		for _, s in stars do
			s.x = (s.x - s.speed * dt) % W
			s.frame.Position = UDim2.fromOffset(s.x, s.y)
		end
		stationSpin += dt * 0.5
		for i, p in panels do
			local a = stationSpin + (i - 1) * math.pi / 2
			p.Position = UDim2.fromOffset(CX + math.cos(a) * (STATION_R + 70), CY + math.sin(a) * (STATION_R + 70))
			p.Rotation = math.deg(a)
		end
		stationLight.BackgroundTransparency = 0.2 + 0.4 * (0.5 + 0.5 * math.sin(stationSpin * 8))
		stationRing.Rotation = math.deg(stationSpin)

		-- effects run even after game over
		for i = #particles, 1, -1 do
			local p = particles[i]
			p.t += dt
			p.x += p.vx * dt
			p.y += p.vy * dt
			p.vx *= 0.94
			if not p.text then
				p.vy *= 0.94
			end
			local k = p.t / p.life
			p.frame.Position = UDim2.fromOffset(p.x, p.y)
			if p.text then
				p.frame.TextTransparency = k
			else
				p.frame.BackgroundTransparency = k
			end
			if k >= 1 then
				p.frame:Destroy()
				table.remove(particles, i)
			end
		end
		for i = #rings, 1, -1 do
			local r = rings[i]
			r.t += dt
			local k = math.min(r.t / r.duration, 1)
			local size = 10 + (r.radius * 2 - 10) * (1 - (1 - k) ^ 3)
			r.frame.Size = UDim2.fromOffset(size, size)
			if r.stroke then
				r.stroke.Transparency = k
			end
			if k >= 1 then
				r.frame:Destroy()
				table.remove(rings, i)
			end
		end
		if shake > 0 then
			shake = math.max(0, shake - dt)
			local m = shake * 30
			field.Position = UDim2.fromOffset((math.random() - 0.5) * m, (math.random() - 0.5) * m)
		else
			field.Position = UDim2.fromOffset(0, 0)
		end
		stationCore.BackgroundColor3 = stationCore.BackgroundColor3:Lerp(ORANGE, math.min(1, dt * 6))

		if state ~= "play" then
			return
		end
		elapsed += dt

		-- Waves
		if phase == "intro" then
			phaseTimer -= dt
			if phaseTimer <= 0 then
				phase = "fight"
				showBanner("", "")
			end
		elseif phase == "fight" then
			spawnTimer -= dt
			if #spawnQueue > 0 and spawnTimer <= 0 then
				spawnTimer = spawnInterval
				local kind = table.remove(spawnQueue, 1)
				local px, py = edgePoint()
				spawnDrone(kind, px, py)
				if kind == "mother" then
					showBanner("MOTHERSHIP", "Bring it down!")
					ctx.audio:Play("notify", { volume = 0.7, pitch = 0.6 })
				end
			end
			if #spawnQueue == 0 and #drones == 0 then
				phase, phaseTimer = "clear", 2.2
				local bonus = 250 * wave
				score += bonus
				stationHp = math.min(STATION_MAX, stationHp + 10)
				if wave >= 3 and not stationHitThisWave then
					ctx.trophies:Unlock("flawless")
				end
				if score >= 10000 then
					ctx.trophies:Unlock("score_10000")
				end
				showBanner(`WAVE {wave} CLEAR`, `Bonus +{bonus}   Station repaired +10`)
				ctx.audio:Play("confirm", { volume = 0.6, pitch = 0.9 })
			end
		elseif phase == "clear" then
			phaseTimer -= dt
			if phaseTimer <= 0 then
				startWave(wave + 1)
			end
		end

		-- Ship movement
		local axes = input:GetAxes()
		local mx, my = axes.lx, -axes.ly
		local mag = math.sqrt(mx * mx + my * my)
		if mag > 1 then
			mx, my = mx / mag, my / mag
		end
		vx += (mx * SHIP_SPEED - vx) * math.min(1, dt * 12)
		vy += (my * SHIP_SPEED - vy) * math.min(1, dt * 12)
		x = math.clamp(x + vx * dt, 40, W - 40)
		y = math.clamp(y + vy * dt, TOP, H - 40)
		local sd = math.sqrt(dist2(x, y, CX, CY))
		local minD = STATION_R + SHIP_R + 10
		if sd < minD and sd > 0 then
			x = CX + (x - CX) / sd * minD
			y = CY + (y - CY) / sd * minD
		end

		-- Aim: right stick wins, otherwise auto-aim at the nearest drone while firing
		local firing = input:IsDown("cross") or input:IsDown("r2") or axes.r2 > 0.3
		local rmag = math.sqrt(axes.rx * axes.rx + axes.ry * axes.ry)
		if rmag > 0.35 then
			aimX, aimY = axes.rx / rmag, -axes.ry / rmag
			firing = true
		elseif firing then
			local target = nearestDrone()
			if target then
				local dx, dy = target.x - x, target.y - y
				local len = math.sqrt(dx * dx + dy * dy)
				if len > 0 then
					aimX, aimY = dx / len, dy / len
				end
			end
		elseif mag > 0.2 then
			aimX, aimY = mx / math.max(mag, 1e-3), my / math.max(mag, 1e-3)
		end
		ship.Position = UDim2.fromOffset(x, y)
		ship.Rotation = angleOf(aimX, aimY)
		shipGlow.Position = ship.Position
		aimDot.Position = UDim2.fromOffset(x + aimX * 70, y + aimY * 70)
		invuln = math.max(0, invuln - dt)
		ship.Visible = invuln == 0 or math.floor(invuln * 10) % 2 == 0
		rapidTime = math.max(0, rapidTime - dt)
		ship.TextColor3 = rapidTime > 0 and WHITE or CYAN

		cooldown -= dt
		if firing and cooldown <= 0 then
			cooldown = rapidTime > 0 and 0.07 or 0.13
			shoot(aimX, aimY)
		end

		comboTimer -= dt
		if comboTimer <= 0 then
			combo = 0
		end

		-- Player bullets
		for i = #bullets, 1, -1 do
			local b = bullets[i]
			b.x += b.vx * dt
			b.y += b.vy * dt
			local gone = b.x < -40 or b.x > W + 40 or b.y < -40 or b.y > H + 40
			if not gone then
				for j = #drones, 1, -1 do
					local d = drones[j]
					if dist2(b.x, b.y, d.x, d.y) < (d.r + 6) ^ 2 then
						damageDrone(j, 1)
						gone = true
						break
					end
				end
			end
			if gone then
				b.frame:Destroy()
				table.remove(bullets, i)
			else
				b.frame.Position = UDim2.fromOffset(b.x, b.y)
			end
		end

		-- Drones
		for i = #drones, 1, -1 do
			local d = drones[i]
			if state ~= "play" then
				break
			end
			local dx, dy = CX - d.x, CY - d.y
			local dc = math.sqrt(dx * dx + dy * dy)
			local orbit = d.def.orbit
			if orbit and dc < orbit + 20 then
				-- circle the station and shoot
				d.angle = math.atan2(d.y - CY, d.x - CX) + d.dir * d.speed / orbit * dt * 0.6
				local radius = dc + (orbit - dc) * math.min(1, dt * 2)
				d.x = CX + math.cos(d.angle) * radius
				d.y = CY + math.sin(d.angle) * radius
				d.fireTimer -= dt
				if d.fireTimer <= 0 then
					if d.kind == "mother" then
						d.fireTimer = math.max(1.4, 3 - wave * 0.08)
						enemyShoot(d, x, y, { -0.25, 0, 0.25 })
					else
						d.fireTimer = math.max(1.3, 2.6 - wave * 0.06)
						local atShip = math.random() < 0.6
						enemyShoot(d, atShip and x or CX, atShip and y or CY, { 0 })
					end
				end
				if d.kind == "mother" then
					d.spawnTimer -= dt
					if d.spawnTimer <= 0 then
						d.spawnTimer = 4
						spawnDrone("scout", d.x + 60, d.y)
						spawnDrone("scout", d.x - 60, d.y)
					end
				end
			else
				local wob = math.sin(elapsed * 3 + d.wobble) * 0.35
				local ux, uy = dx / dc, dy / dc
				local px, py = -uy, ux
				d.x += (ux + px * wob) * d.speed * dt
				d.y += (uy + py * wob) * d.speed * dt
			end
			if d.kind == "scout" then
				d.frame.Rotation += 240 * dt
			elseif d.kind == "mother" then
				d.frame.Rotation += 20 * dt
			end
			d.frame.Position = UDim2.fromOffset(d.x, d.y)
			if d.flash > 0 then
				d.flash -= dt
				d.frame.BackgroundColor3 = WHITE
			else
				d.frame.BackgroundColor3 = d.color
			end

			if dc < STATION_R + d.r then
				-- rammed the station
				table.remove(drones, i)
				d.frame:Destroy()
				burst(d.x, d.y, d.color, 10, 300)
				hurtStation(d.def.damage)
			elseif invuln == 0 and dist2(d.x, d.y, x, y) < (d.r + SHIP_R) ^ 2 then
				hurtShip()
				if drones[i] == d then
					damageDrone(i, d.kind == "scout" and 99 or 2)
				end
			end
		end

		-- Enemy bullets
		for i = #enemyBullets, 1, -1 do
			local b = enemyBullets[i]
			if state ~= "play" then
				break
			end
			b.x += b.vx * dt
			b.y += b.vy * dt
			local gone = b.x < -40 or b.x > W + 40 or b.y < -40 or b.y > H + 40
			if not gone and dist2(b.x, b.y, CX, CY) < (STATION_R + 7) ^ 2 then
				gone = true
				hurtStation(2)
			elseif not gone and invuln == 0 and dist2(b.x, b.y, x, y) < (SHIP_R) ^ 2 then
				gone = true
				hurtShip()
			end
			if gone then
				b.frame:Destroy()
				table.remove(enemyBullets, i)
			else
				b.frame.Position = UDim2.fromOffset(b.x, b.y)
			end
		end

		-- Pickups
		for i = #pickups, 1, -1 do
			local p = pickups[i]
			p.life -= dt
			p.frame.BackgroundTransparency = p.life < 3 and (math.floor(p.life * 6) % 2 == 0 and 0.3 or 0.8) or 0.3
			local taken = dist2(p.x, p.y, x, y) < (SHIP_R + 26) ^ 2
			if taken then
				if p.kind == "repair" then
					stationHp = math.min(STATION_MAX, stationHp + 15)
				elseif p.kind == "rapid" then
					rapidTime = 8
				elseif p.kind == "shield" then
					lives = math.min(5, lives + 1)
				end
				floatText(p.x, p.y - 30, PICKUPS[p.kind].label, PICKUPS[p.kind].color)
				ctx.audio:Play("confirm", { volume = 0.5, pitch = 1.4 })
			end
			if taken or p.life <= 0 then
				p.frame:Destroy()
				table.remove(pickups, i)
			end
		end

		-- HUD
		if state ~= "play" then
			return
		end
		scoreText.Text = `SCORE {score}`
		comboText.Text = combo >= 5 and `COMBO {combo}   x{math.min(1 + combo // 5, 8)}` or (rapidTime > 0 and `RAPID FIRE {math.ceil(rapidTime)}s` or `BEST {math.max(best, score)}`)
		waveText.Text = `WAVE {wave}`
		leftText.Text = phase == "fight" and `Drones left: {#spawnQueue + #drones}` or ""
		hpBar.Size = UDim2.fromScale(stationHp / STATION_MAX, 1)
		hpBar.BackgroundColor3 = stationHp > 50 and Color3.fromRGB(90, 255, 140) or (stationHp > 25 and ORANGE or Color3.fromRGB(255, 70, 70))
		livesText.Text = "SHIPS " .. string.rep("▲ ", lives)
		pulseBar.Size = UDim2.fromScale(pulse / 100, 1)
		pulseBar.BackgroundColor3 = pulse >= 100 and WHITE or CYAN
		pulseLabel.Text = pulse >= 100 and `PULSE READY — press {input:Glyph("l1")}` or `PULSE {math.floor(pulse)}%`
	end)
end

return Game
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">art</string>
            <string name="Source"><![CDATA[-- Сгенерировано blender/export_luau.py из assets/renders/orbit_strike_art.png. Не редактировать вручную.
-- Key art orbit_strike: RGB 320×180 в base64, собирается в EditableImage.
return { width = 320, height = 180, rgb = "" }
]]></string>
          </Properties>
