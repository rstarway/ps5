]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">levels</string>
            <string name="Source"><![CDATA[-- Уровни Cube Logic. Символы: S старт, E выход, . пол, # стена, пробел пустота,
-- C трескается после схода, I лёд (скольжение), T переключатель, B мост (выкл. в начале), b мост (вкл. в начале).
-- par = минимальное число ходов (проверено перебором в ширину).
return {
	{ name = "First Roll", par = 4, tip = "Roll onto the glowing exit. The glowing face of the cube must point up.",
		map = { "S...E" } },
	{ name = "Corner", par = 8, tip = "Every roll turns the cube. Plan your turns so the glow ends on top.",
		map = { "S....", ".....", " ....", " . ..", "....E" } },
	{ name = "Detour", par = 7, tip = "Walls block the cube. Find a way around.",
		map = { "......", "S..#.E", "......" } },
	{ name = "Wrong Side Up", par = 6, mark = "east", tip = "The glow starts on the side this time. Turn it up before the exit.",
		map = { ".....", "S...E", "....." } },
	{ name = "Crumbling Path", par = 6, tip = "Cracked tiles fall away once you roll off them.",
		map = { "S.C.C", "..C..", "C.CCE" } },
	{ name = "Thin Ice", par = 7, tip = "Ice slides the cube without turning it, until something stops it.",
		map = { "#######", "#S.IIII#", "#..#..E#", "#.....##", "#######" } },
	{ name = "Bridge Switch", par = 10, tip = "Switches toggle the purple bridges.",
		map = { "S..T  ", "....  ", "..BBB.E", "......" } },
	{ name = "Skating Rink", par = 12,
		map = { "#########", "#S.III.##", "#.#I#IIE#", "#.IIII..#", "#I#II#..#", "#########" } },
	{ name = "Dead Ends", par = 11, mark = "north",
		map = { "S.#....", "..#.##.", "....#E.", ".CC.#..", "......." } },
	{ name = "Two Switches", par = 13,
		map = { "S.T..  ", "...#.  ", "bb#.BB.E", "..T..  ", "....   " } },
	{ name = "Glass Floor", par = 8, tip = "Every cracked tile holds only once. Choose your path carefully.",
		map = { "SCCCC.", "CCCCCC", "CCCCCC", "CCCC.E" } },
	{ name = "Final Exam", par = 9, mark = "south",
		map = { "##########", "#S..I.III#", "#.#.I#.#.#", "#.T.IIBBE#", "#..C..#..#", "##########" } },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "cube_logic",
	title = "Cube Logic",
	category = "game", -- game | media | app
	genre = "Puzzle",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 4,
	description = "Roll the cube onto the exit in short brain teasers.",
	icon = "🧩",
	cover = "cover",
	art = "art", -- фон главного экрана (blender/game_art.py)
	colors = { "#4CC9F0", "#14213D" },
	transparentGui = true, -- 3D-поле видно сквозь интерфейс
	controls = {
		{ "Stick / D-pad / arrows / WASD", "Roll the cube" },
		{ "□ / F", "Undo move" },
		{ "△ / R", "Restart level" },
		{ "✕ / Enter", "Select" },
		{ "○ / Backspace", "Back to levels" },
		{ "OPTIONS / O", "Pause" },
		{ "PS / H", "Control Center" },
	},
	trophies = {
		{ id = "first_roll", name = "First Roll", description = "Clear the first level", grade = "bronze" },
		{ id = "perfect", name = "Perfect Path", description = "Clear a level in par moves", grade = "bronze" },
		{ id = "skater", name = "Skater", description = "Clear Thin Ice", grade = "bronze" },
		{ id = "off_edge", name = "Leap of Faith", description = "Roll off the edge into the void", grade = "bronze", hidden = true },
		{ id = "halfway", name = "Halfway There", description = "Clear 6 levels", grade = "silver" },
		{ id = "sure_footed", name = "Sure Footed", description = "Clear level 7 or later without falling or undoing", grade = "silver", hidden = true },
		{ id = "cube_master", name = "Cube Master", description = "Clear all 12 levels", grade = "gold" },
		{ id = "flawless", name = "Flawless Logic", description = "Clear every level in par moves", grade = "gold" },
		{ id = "platinum", name = "Grand Cube", description = "Earn every Cube Logic trophy", grade = "platinum" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">Game2048</string>
          <string name="Source"><![CDATA[-- 2048: поле 4×4, ход — сдвиг строки и слияние равных соседей. Партия сохраняется.
local Game = {}

local N, TILE, GAP = 4, 170, 16
local COLORS = {
	[2] = { 238, 228, 218 }, [4] = { 237, 224, 200 }, [8] = { 242, 177, 121 }, [16] = { 245, 149, 99 },
	[32] = { 246, 124, 95 }, [64] = { 246, 94, 59 }, [128] = { 237, 207, 114 }, [256] = { 237, 204, 97 },
	[512] = { 237, 200, 80 }, [1024] = { 237, 197, 63 }, [2048] = { 237, 194, 46 },
}

function Game.launch(ctx)
	local ui = ctx.ui
	local canvas = ui.canvas(ctx.gui)
	ctx.gui.BackgroundColor3 = Color3.fromRGB(30, 24, 14)
	local size = N * TILE + (N + 1) * GAP
	local board = ui.new("Frame", {
		Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 590),
		BackgroundColor3 = Color3.fromRGB(120, 105, 90), Parent = canvas,
	}, { ui.corner(20) })
	local labels = {}
	for r = 1, N do
		labels[r] = {}
		for c = 1, N do
			labels[r][c] = ui.text("", {
				Size = UDim2.fromOffset(TILE, TILE), Position = UDim2.fromOffset(GAP + (c - 1) * (TILE + GAP), GAP + (r - 1) * (TILE + GAP)),
				BackgroundTransparency = 0, TextSize = 64, Font = ctx.theme.FontHeavy, TextXAlignment = Enum.TextXAlignment.Center, Parent = board,
			})
			ui.corner(12).Parent = labels[r][c]
		end
	end
	local scoreLabel = ui.text("", { Size = UDim2.fromOffset(1920, 60), Position = UDim2.fromOffset(0, 110), TextSize = 44, Font = ctx.theme.FontHeavy, TextXAlignment = Enum.TextXAlignment.Center, Parent = canvas })
	local message = ui.text("", { Size = UDim2.fromOffset(1920, 60), Position = UDim2.fromOffset(0, 990), TextSize = 32, TextColor3 = ctx.theme.Colors.SubText, TextXAlignment = Enum.TextXAlignment.Center, Parent = canvas })

	local grid, score
	local best = ctx.save:Get("best", 0)

	local function spawnTile()
		local empty = {}
		for r = 1, N do
			for c = 1, N do
				if grid[r][c] == 0 then
					table.insert(empty, { r, c })
				end
			end
		end
		if #empty > 0 then
			local cell = empty[math.random(#empty)]
			grid[cell[1]][cell[2]] = math.random() < 0.9 and 2 or 4
		end
	end

	local function canMove()
		for r = 1, N do
			for c = 1, N do
				local v = grid[r][c]
				if v == 0 or (c < N and grid[r][c + 1] == v) or (r < N and grid[r + 1][c] == v) then
					return true
				end
			end
		end
		return false
	end

	local function draw()
		for r = 1, N do
			for c = 1, N do
				local v, label = grid[r][c], labels[r][c]
				local rgb = COLORS[v] or { 60, 58, 50 }
				label.Text = v > 0 and tostring(v) or ""
				label.BackgroundColor3 = v > 0 and Color3.fromRGB(rgb[1], rgb[2], rgb[3]) or Color3.fromRGB(150, 135, 120)
				label.TextColor3 = v <= 4 and Color3.fromRGB(100, 90, 80) or Color3.new(1, 1, 1)
				label.TextSize = v >= 1024 and 50 or 64
			end
		end
		scoreLabel.Text = `Score {score}     Best {best}`
		message.Text = canMove() and `{ctx.input:Glyph("triangle")} new game   {ctx.input:Glyph("circle")} quit`
			or `No moves left · {ctx.input:Glyph("triangle")} new game`
		ctx.save:Set("board", { grid = grid, score = score })
	end

	local function newGame()
		grid, score = {}, 0
		for r = 1, N do
			grid[r] = { 0, 0, 0, 0 }
		end
		spawnTile()
		spawnTile()
		draw()
	end

	-- сдвиг одной линии к началу со слиянием
	local function slide(line)
		local out, merged = {}, false
		for _, v in line do
			if v ~= 0 then
				if not merged and out[#out] == v then
					out[#out] *= 2
					score += out[#out]
					merged = true
					local made = out[#out]
					for _, t in { { 128, "tile_128" }, { 512, "tile_512" }, { 2048, "tile_2048" } } do
						if made >= t[1] then
							ctx.trophies:Unlock(t[2])
						end
					end
				else
					table.insert(out, v)
					merged = false
				end
			end
		end
		while #out < N do
			table.insert(out, 0)
		end
		return out
	end

	local function move(dr, dc)
		local moved = false
		for i = 1, N do
			local cells = {}
			for k = 1, N do
				-- k-я клетка линии, считая от края, к которому сдвигаем
				local idx = (dr + dc) < 0 and k or N + 1 - k
				table.insert(cells, dr ~= 0 and { idx, i } or { i, idx })
			end
			local line = {}
			for _, p in cells do
				table.insert(line, grid[p[1]][p[2]])
			end
			local result = slide(line)
			for k, p in cells do
				if grid[p[1]][p[2]] ~= result[k] then
					moved = true
				end
				grid[p[1]][p[2]] = result[k]
			end
		end
		if moved then
			spawnTile()
			if score > best then
				best = score
				ctx.save:Set("best", best)
			end
			ctx.audio:Play("move")
			draw()
		end
	end

	local MOVES = { up = { -1, 0 }, down = { 1, 0 }, left = { 0, -1 }, right = { 0, 1 } }
	ctx.input:On("press", function(btn)
		if MOVES[btn] then
			move(MOVES[btn][1], MOVES[btn][2])
		elseif btn == "triangle" then
			newGame()
		elseif btn == "circle" then
			ctx:Exit()
		end
	end)

	local saved = ctx.save:Get("board")
	if type(saved) == "table" and type(saved.grid) == "table" and #saved.grid == N then
		grid, score = saved.grid, saved.score or 0
		draw()
	else
		newGame()
	end
end

return Game
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "game_2048",
	title = "2048",
	category = "game",
	genre = "Puzzle",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 12,
	description = "Slide the tiles, merge equal numbers and reach 2048.",
	icon = "🔢",
	cover = "",
	art = "",
	colors = { "#FFB703", "#5C3A00" },
	controls = {
		{ "Stick / D-pad / arrows / WASD", "Slide tiles" },
		{ "△ / R", "New game" },
		{ "○", "Quit" },
	},
	trophies = {
		{ id = "tile_128", name = "Warming Up", description = "Make a 128 tile", grade = "bronze" },
		{ id = "tile_512", name = "Getting There", description = "Make a 512 tile", grade = "silver" },
		{ id = "tile_2048", name = "2048!", description = "Make the 2048 tile", grade = "gold" },
		{ id = "platinum", name = "Number Master", description = "Earn every 2048 trophy", grade = "platinum" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">NeonDrive</string>
          <string name="Source"><![CDATA[-- Neon Drive — 3D-гонка по ночному городу. Две гонки: Clock Run (3 круга, чекпоинты
-- добавляют время) и Time Trial (свободные круги против призрака лучшего круга).
-- Машина едет по своей аркадной физике (без физики Roblox): газ, тормоз, занос, ускорение.
local Track = require(script.Track)

local Game = {}

local BASE = Vector3.new(9000, 300, 0) -- трасса далеко от чиллзоны
local LAPS = 3
local MAX_SPEED, BOOST_SPEED, REVERSE_SPEED = 150, 205, 35
local ACCEL, BRAKE, DRAG = 110, 170, 0.32
local TURN = 2.0
local GRIP, DRIFT_GRIP = 8, 3.2
local KMH = 1.3 -- studs/s → «км/ч» на спидометре
local CAR_HALF = 3.6
local CLOCK_START, CLOCK_BONUS = 24, 9
local ACE_LAP = 30
local DRIFT_KING = 12000
local GHOST_STEP = 0.1
local PAD_SPOTS = {
	{ index = 64, offset = 0 }, { index = 92, offset = -8 }, { index = 148, offset = 8 },
	{ index = 170, offset = 0 }, { index = 210, offset = -10 },
}

local PINK = Track.Colors.pink
local VIOLET = Track.Colors.violet
local CYAN = Track.Colors.cyan
local AMBER = Track.Colors.amber
local WHITE = Color3.new(1, 1, 1)

local function cross(a, b)
	return Vector3.new(a.Y * b.Z - a.Z * b.Y, a.Z * b.X - a.X * b.Z, a.X * b.Y - a.Y * b.X)
end

local function fmtTime(t)
	if not t then
		return "--:--.--"
	end
	local m = math.floor(t / 60)
	local s = t - m * 60
	return string.format("%d:%05.2f", m, s)
end

local function fmtNumber(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

-- Детали машины: размер, смещение (вправо, вверх, вперёд), цвет, материал, прозрачность, форма
local CAR_PARTS = {
	{ name = "Body", size = Vector3.new(7, 1.6, 13), at = Vector3.new(0, 1.7, 0), color = PINK, material = Enum.Material.SmoothPlastic },
	{ name = "Nose", size = Vector3.new(6.4, 0.9, 3), at = Vector3.new(0, 1.3, 7.2), color = PINK, material = Enum.Material.SmoothPlastic },
	{ name = "Cabin", size = Vector3.new(5.6, 1.5, 5.5), at = Vector3.new(0, 3.2, -0.8), color = Color3.fromRGB(14, 10, 26), material = Enum.Material.Glass, transparency = 0.15 },
	{ name = "Spoiler", size = Vector3.new(7.2, 0.3, 1.6), at = Vector3.new(0, 3.7, -6), color = Color3.fromRGB(20, 14, 36), material = Enum.Material.SmoothPlastic },
	{ name = "SpoilerL", size = Vector3.new(0.3, 1.2, 0.6), at = Vector3.new(-2.6, 3, -6), color = Color3.fromRGB(20, 14, 36) },
	{ name = "SpoilerR", size = Vector3.new(0.3, 1.2, 0.6), at = Vector3.new(2.6, 3, -6), color = Color3.fromRGB(20, 14, 36) },
	{ name = "StripeL", size = Vector3.new(0.15, 0.3, 11), at = Vector3.new(-3.56, 1.7, 0), color = WHITE, material = Enum.Material.SmoothPlastic },
	{ name = "StripeR", size = Vector3.new(0.15, 0.3, 11), at = Vector3.new(3.56, 1.7, 0), color = WHITE, material = Enum.Material.SmoothPlastic },
	{ name = "HeadL", size = Vector3.new(1.6, 0.4, 0.2), at = Vector3.new(-2.3, 1.6, 8.75), color = Color3.fromRGB(255, 248, 225), material = Enum.Material.Glass },
	{ name = "HeadR", size = Vector3.new(1.6, 0.4, 0.2), at = Vector3.new(2.3, 1.6, 8.75), color = Color3.fromRGB(255, 248, 225), material = Enum.Material.Glass },
	{ name = "TailL", size = Vector3.new(2, 0.4, 0.2), at = Vector3.new(-2.2, 2.1, -6.55), color = Color3.fromRGB(170, 20, 30), material = Enum.Material.Glass },
	{ name = "TailR", size = Vector3.new(2, 0.4, 0.2), at = Vector3.new(2.2, 2.1, -6.55), color = Color3.fromRGB(170, 20, 30), material = Enum.Material.Glass },
	{ name = "FlameL", size = Vector3.new(0.9, 0.7, 3), at = Vector3.new(-1.5, 1.4, -8.2), color = AMBER, material = Enum.Material.SmoothPlastic, transparency = 1 },
	{ name = "FlameR", size = Vector3.new(0.9, 0.7, 3), at = Vector3.new(1.5, 1.4, -8.2), color = AMBER, material = Enum.Material.SmoothPlastic, transparency = 1 },
	{ name = "WheelFL", size = Vector3.new(1.4, 2.6, 2.6), at = Vector3.new(-3.6, 1.3, 4.2), color = Color3.fromRGB(12, 12, 16), shape = Enum.PartType.Cylinder },
	{ name = "WheelFR", size = Vector3.new(1.4, 2.6, 2.6), at = Vector3.new(3.6, 1.3, 4.2), color = Color3.fromRGB(12, 12, 16), shape = Enum.PartType.Cylinder },
	{ name = "WheelRL", size = Vector3.new(1.4, 2.6, 2.6), at = Vector3.new(-3.6, 1.3, -4.2), color = Color3.fromRGB(12, 12, 16), shape = Enum.PartType.Cylinder },
	{ name = "WheelRR", size = Vector3.new(1.4, 2.6, 2.6), at = Vector3.new(3.6, 1.3, -4.2), color = Color3.fromRGB(12, 12, 16), shape = Enum.PartType.Cylinder },
}

local GHOST_PARTS = {
	{ name = "Body", size = Vector3.new(7, 1.6, 13), at = Vector3.new(0, 1.7, 0), color = CYAN, material = Enum.Material.Glass, transparency = 0.7 },
	{ name = "Cabin", size = Vector3.new(5.6, 1.5, 5.5), at = Vector3.new(0, 3.2, -0.8), color = CYAN, material = Enum.Material.Glass, transparency = 0.75 },
}

local function buildCar(parent, spec, name)
	local model = Instance.new("Model")
	model.Name = name
	local parts = {}
	for _, s in spec do
		local p = Track.part(model, s.size, CFrame.new(BASE), s.color, s.material, s.transparency)
		p.Name = s.name
		if s.shape then
			p.Shape = s.shape
		end
		parts[s.name] = p
		table.insert(parts, { part = p, at = s.at })
	end
	model.Parent = parent
	parts.model = model
	return parts
end

-- Ставит модель машины: pos — точка на дороге, f — горизонтальное направление, slope — уклон.
local function placeCar(parts, pos, f, slope)
	local f3 = Vector3.new(f.X, slope, f.Z).Unit
	local r = Vector3.new(-f.Z, 0, f.X)
	local u = cross(r, f3)
	for _, e in ipairs(parts) do
		local wp = pos + r * e.at.X + u * e.at.Y + f3 * e.at.Z
		e.part.CFrame = CFrame.lookAt(wp, wp + f3, u)
	end
end

local function encodeGhost(frames)
	local out = table.create(#frames)
	for i, fr in frames do
		out[i] = string.format("%d,%d,%d,%d", fr[1], fr[2], fr[3], fr[4])
	end
	return table.concat(out, ";")
end

local function decodeGhost(str)
	if type(str) ~= "string" or str == "" then
		return nil
	end
	local frames = {}
	for a, b, c, d in str:gmatch("([%-%d]+),([%-%d]+),([%-%d]+),([%-%d]+)") do
		table.insert(frames, { tonumber(a), tonumber(b), tonumber(c), tonumber(d) })
	end
	return #frames > 1 and frames or nil
end

function Game.launch(ctx)
	local ui = ctx.ui
	local theme = ctx.theme
	ctx.gui.BackgroundTransparency = 1

	-- Мир
	local track = Track.new(BASE)
	local N = track.N
	local SECTOR = N / 4
	local checkpoints = { 1, SECTOR + 1, SECTOR * 2 + 1, SECTOR * 3 + 1 }
	local built = track:build(ctx.world, checkpoints, PAD_SPOTS)
	local carParts = buildCar(ctx.world, CAR_PARTS, "Car")
	local ghostParts = buildCar(ctx.world, GHOST_PARTS, "Ghost")
	local headLight = Instance.new("SpotLight")
	headLight.Range = 60
	headLight.Angle = 50
	headLight.Brightness = 3
	headLight.Face = Enum.NormalId.Front
	headLight.Parent = carParts.Nose
	local cam = ctx.camera
	cam.CameraType = Enum.CameraType.Scriptable

	-- Сохранения
	local bestLap = ctx.save:Get("best_lap", nil)
	local bestClock = ctx.save:Get("best_clock", nil)
	local bestDrift = ctx.save:Get("best_drift", 0)
	local ghost = decodeGhost(ctx.save:Get("ghost", nil))

	-- HUD
	local canvas = ui.canvas(ctx.gui)
	local function label(props)
		props.Parent = props.Parent or canvas
		props.Font = props.Font or theme.FontHeavy
		props.TextStrokeTransparency = props.TextStrokeTransparency or 0.6
		return ui.text(props.Text or "", props)
	end
	local hud = ui.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = canvas })
	local lapLabel = label({ Parent = hud, Size = UDim2.fromOffset(500, 70), Position = UDim2.fromOffset(60, 40), TextSize = 64 })
	local timeLabel = label({ Parent = hud, Size = UDim2.fromOffset(600, 40), Position = UDim2.fromOffset(62, 112), TextSize = 34, Font = theme.FontBold })
	local bestLabel = label({ Parent = hud, Size = UDim2.fromOffset(600, 34), Position = UDim2.fromOffset(62, 152), TextSize = 26, Font = theme.FontMedium, TextColor3 = Color3.fromRGB(200, 190, 255) })
	local clockLabel = label({ Parent = hud, Size = UDim2.fromOffset(600, 110), Position = UDim2.fromOffset(660, 30), TextSize = 96, TextXAlignment = Enum.TextXAlignment.Center })
	local clockBonus = label({ Parent = hud, Size = UDim2.fromOffset(600, 50), Position = UDim2.fromOffset(660, 136), TextSize = 40, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = CYAN, TextTransparency = 1, TextStrokeTransparency = 1 })
	local speedLabel = label({ Parent = hud, Size = UDim2.fromOffset(420, 130), Position = UDim2.fromOffset(1440, 820), TextSize = 128, TextXAlignment = Enum.TextXAlignment.Right })
	label({ Parent = hud, Text = "KM/H", Size = UDim2.fromOffset(420, 34), Position = UDim2.fromOffset(1440, 940), TextSize = 28, Font = theme.FontBold, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(255, 150, 190) })
	local boostBack = ui.new("Frame", {
		Size = UDim2.fromOffset(420, 18), Position = UDim2.fromOffset(1440, 990), BackgroundColor3 = Color3.fromRGB(30, 20, 60), BackgroundTransparency = 0.2, Parent = hud,
	}, { ui.corner(9), ui.stroke(CYAN, 2, 0.4) })
	local boostFill = ui.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = CYAN, Parent = boostBack }, { ui.corner(9), ui.gradient({ CYAN, PINK }, 0) })
	label({ Parent = hud, Text = "BOOST", Size = UDim2.fromOffset(200, 26), Position = UDim2.fromOffset(1440, 1012), TextSize = 22, Font = theme.FontBold, TextColor3 = CYAN })
	local driftLabel = label({ Parent = hud, Size = UDim2.fromOffset(800, 60), Position = UDim2.fromOffset(560, 700), TextSize = 52, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = AMBER })
	local bigLabel = label({ Size = UDim2.fromOffset(1920, 200), Position = UDim2.fromOffset(0, 300), TextSize = 150, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 })
	local msgLabel = label({ Size = UDim2.fromOffset(1920, 60), Position = UDim2.fromOffset(0, 230), TextSize = 48, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5 })

	-- Мини-карта
	local MAP_SIZE = 260
	local minimap = ui.new("Frame", {
		Size = UDim2.fromOffset(MAP_SIZE + 40, MAP_SIZE + 40), Position = UDim2.fromOffset(50, 730),
		BackgroundColor3 = Color3.fromRGB(10, 6, 24), BackgroundTransparency = 0.35, Parent = hud,
	}, { ui.corner(20), ui.stroke(VIOLET, 2, 0.3) })
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, s in track.samples do
		minX, maxX = math.min(minX, s.X), math.max(maxX, s.X)
		minZ, maxZ = math.min(minZ, s.Z), math.max(maxZ, s.Z)
	end
	local mapScale = MAP_SIZE / math.max(maxX - minX, maxZ - minZ)
	local function mapPos(p)
		local ox = (MAP_SIZE - (maxX - minX) * mapScale) / 2
		local oz = (MAP_SIZE - (maxZ - minZ) * mapScale) / 2
		return UDim2.fromOffset(20 + ox + (p.X - minX) * mapScale, 20 + oz + (p.Z - minZ) * mapScale)
	end
	for i = 1, N, 2 do
		ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(5, 5), Position = mapPos(track.samples[i]),
			BackgroundColor3 = (i - 1) % SECTOR == 0 and WHITE or Color3.fromRGB(150, 110, 255), BorderSizePixel = 0, Parent = minimap,
		})
	end
	local ghostDot = ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = CYAN, Visible = false, ZIndex = 2, Parent = minimap }, { ui.corner(6) })
	local carDot = ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = PINK, ZIndex = 3, Parent = minimap }, { ui.corner(8), ui.stroke(WHITE, 2) })

	-- Меню (заставка, пауза, итоги)
	local menuFrame = ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 600), Size = UDim2.fromOffset(760, 560),
		BackgroundColor3 = Color3.fromRGB(14, 6, 34), BackgroundTransparency = 0.15, ZIndex = 10, Parent = canvas,
	}, { ui.corner(28), ui.stroke(PINK, 3, 0.2), ui.gradient({ Color3.fromRGB(80, 20, 120), Color3.fromRGB(20, 6, 50) }, 90) })
	local menuTitle = label({ Parent = menuFrame, Size = UDim2.new(1, 0, 0, 90), Position = UDim2.fromOffset(0, 26), TextSize = 72, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 11 })
	local menuSub = label({ Parent = menuFrame, Size = UDim2.new(1, -60, 0, 90), Position = UDim2.fromOffset(30, 112), TextSize = 28, Font = theme.FontMedium, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(220, 200, 255), ZIndex = 11 })
	local menuRows = {}
	for i = 1, 4 do
		local row = ui.new("Frame", {
			Size = UDim2.new(1, -120, 0, 64), Position = UDim2.fromOffset(60, 200 + (i - 1) * 76),
			BackgroundColor3 = PINK, BackgroundTransparency = 1, ZIndex = 11, Parent = menuFrame,
		}, { ui.corner(16) })
		local text = label({ Parent = row, Size = UDim2.fromScale(1, 1), TextSize = 36, Font = theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 12 })
		menuRows[i] = { frame = row, text = text }
	end
	local menuHint = label({ Parent = menuFrame, Size = UDim2.new(1, -60, 0, 36), Position = UDim2.new(0, 30, 1, -56), TextSize = 22, Font = theme.FontMedium, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(190, 170, 230), ZIndex = 11 })
	local logo = label({ Size = UDim2.fromOffset(1920, 170), Position = UDim2.fromOffset(0, 90), Text = "NEON DRIVE", TextSize = 160, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 1, ZIndex = 9 })
	ui.gradient({ PINK, Color3.fromRGB(255, 140, 200), CYAN }, 0).Parent = logo
	local tagline = label({ Size = UDim2.fromOffset(1920, 40), Position = UDim2.fromOffset(0, 250), Text = "Drift, boost and beat the clock", TextSize = 34, Font = theme.FontBold, TextColor3 = Color3.fromRGB(230, 210, 255), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 9 })

	local menu = { items = {}, index = 1 }
	local function drawMenu()
		for i, row in menuRows do
			local item = menu.items[i]
			row.frame.Visible = item ~= nil
			if item then
				local selected = i == menu.index
				row.text.Text = item.label
				row.frame.BackgroundTransparency = selected and 0.1 or 0.85
				row.text.TextColor3 = selected and WHITE or Color3.fromRGB(220, 200, 255)
			end
		end
		local item = menu.items[menu.index]
		menuHint.Text = (item and item.hint) or `{ctx.input:Glyph("cross")} select    {ctx.input:Glyph("circle")} back`
	end
	local function openMenu(title, sub, items, onBack)
		menu.items, menu.index, menu.onBack = items, 1, onBack
		menuTitle.Text = title
		menuSub.Text = sub or ""
		menuFrame.Visible = true
		drawMenu()
	end
	local function closeMenu()
		menuFrame.Visible = false
		menu.items = {}
	end

	-- Состояние машины и заезда
	local car = { pos = BASE, yaw = 0, vx = 0, vz = 0, idx = 1, lateral = 0, slope = 0, fwd = 0, lat = 0 }
	local race = {}
	local state = "title" -- title | countdown | race | paused | results
	local pausedFrom = nil
	local mode = "clock"
	local camPos = BASE + Vector3.new(0, 30, -60)
	local orbit = 0
	local messageTimer, bonusTimer = 0, 0
	Game._debug = { car = car, race = race, track = track, getState = function()
		return state
	end }

	local function message(text, color, seconds)
		msgLabel.Text = text
		msgLabel.TextColor3 = color or WHITE
		messageTimer = seconds or 1.6
	end

	local function placeAt(index)
		local p = track:sample(index)
		local t = track.tangents[(index - 1) % N + 1]
		car.pos, car.yaw, car.vx, car.vz = p, math.atan2(t.Z, t.X), 0, 0
		car.idx = (index - 1) % N + 1
		car.slope, car.lateral, car.fwd, car.lat = 0, 0, 0, 0
		placeCar(carParts, car.pos, Vector3.new(math.cos(car.yaw), 0, math.sin(car.yaw)), 0)
	end

	local function setGhostVisible(v)
		for _, e in ipairs(ghostParts) do
			e.part.Parent = v and ghostParts.model or nil
		end
		ghostDot.Visible = v
	end

	local function flashGate(index, color)
		local bars = built.gates[index]
		if not bars then
			return
		end
		for _, b in bars do
			local original = b.Color
			b.Color = color
			task.delay(0.6, function()
				if b.Parent then
					b.Color = original
				end
			end)
		end
	end

	local titleScreen -- объявлено ниже

	local function startRace(newMode)
		mode = newMode or mode
		closeMenu()
		logo.Visible, tagline.Visible = false, false
		hud.Visible = true
		placeAt(2)
		table.clear(race)
		race.lap, race.lapTime, race.raceTime = 1, 0, 0
		race.timeLeft = CLOCK_START
		race.sector = 0
		race.lapClean, race.lapPads = true, {}
		race.drift, race.driftChain, race.driftTime, race.driftOff = 0, 0, 0, 0
		race.boost, race.boostPad, race.boosting = 0, 0, false
		race.countdown, race.lastCount = 3.5, 4
		race.frames, race.recordTimer = {}, 0
		race.hitCooldown = 0
		race.ghostBeaten = false
		clockLabel.Visible = mode == "clock"
		setGhostVisible(mode == "trial" and ghost ~= nil)
		bigLabel.Text = ""
		driftLabel.Text = ""
		camPos = car.pos + Vector3.new(0, 30, 0) - track.tangents[2] * 60
		state = "countdown"
	end

	local function finishRace(success)
		state = "results"
		local lines
		if mode == "clock" then
			if success then
				ctx.trophies:Unlock("beat_clock")
				local record = bestClock == nil or race.raceTime < bestClock
				if record then
					bestClock = race.raceTime
					ctx.save:Set("best_clock", bestClock)
				end
				ctx.audio:Play("trophy", { volume = 0.5 })
				lines = `Total {fmtTime(race.raceTime)}{record and "   NEW RECORD!" or ""}\nTime left {string.format("%.1f", race.timeLeft)} s   Drift {fmtNumber(race.drift)}`
			else
				ctx.audio:Play("error", { volume = 0.6, pitch = 0.7 })
				ctx.input:Rumble(0.8, 0.5)
				lines = `Out of time on lap {race.lap} of {LAPS}\nDrift {fmtNumber(race.drift)}   Best lap {fmtTime(bestLap)}`
			end
		else
			lines = `Best lap {fmtTime(bestLap)}   Drift {fmtNumber(race.drift)}`
		end
		if race.drift > bestDrift then
			bestDrift = math.floor(race.drift)
			ctx.save:Set("best_drift", bestDrift)
		end
		ctx.save:Set("races", ctx.save:Get("races", 0) + 1)
		bigLabel.Text = ""
		local title = mode == "clock" and (success and "FINISH!" or "TIME UP") or "SESSION OVER"
		openMenu(title, lines, {
			{ label = "Race Again", action = function()
				startRace(mode)
			end },
			{ label = "Main Menu", action = function()
				titleScreen()
			end },
		}, function()
			titleScreen()
		end)
	end

	local function lapDone()
		local t = race.lapTime
		ctx.trophies:Unlock("green_light")
		if race.lapClean then
			ctx.trophies:Unlock("clean_line")
		end
		local allPads = true
		for _, spot in PAD_SPOTS do
			if not race.lapPads[spot.index] then
				allPads = false
			end
		end
		if allPads then
			ctx.trophies:Unlock("pad_hopper")
		end
		if t < ACE_LAP then
			ctx.trophies:Unlock("neon_ace")
		end
		local hadGhost = ghost ~= nil
		if bestLap == nil or t < bestLap then
			if mode == "trial" and hadGhost then
				ctx.trophies:Unlock("ghost_buster")
			end
			bestLap = t
			ctx.save:Set("best_lap", bestLap)
			if #race.frames > 1 then
				ghost = race.frames
				ctx.save:Set("ghost", encodeGhost(ghost))
			end
			message(`BEST LAP {fmtTime(t)}`, AMBER, 2.2)
			ctx.audio:Play("notify", { volume = 0.6, pitch = 1.2 })
		else
			message(`LAP {fmtTime(t)}`, WHITE, 1.8)
			ctx.audio:Play("notify", { volume = 0.5 })
		end
		race.lap += 1
		race.lapTime = 0
		race.lapClean = true
		race.lapPads = {}
		race.frames, race.recordTimer = {}, 0
		if mode == "trial" then
			setGhostVisible(ghost ~= nil)
		end
		if mode == "clock" and race.lap > LAPS then
			race.lap = LAPS
			finishRace(true)
			return true
		end
		if mode == "clock" and race.lap == LAPS then
			message("FINAL LAP", PINK, 2)
		end
		return false
	end

	local function endDrift()
		if race.driftChain > 0 then
			local pts = math.floor(race.driftChain)
			race.drift += pts
			driftLabel.Text = `+{fmtNumber(pts)} DRIFT`
			driftLabel.TextTransparency = 0
			task.delay(1.2, function()
				if driftLabel.Parent and race.driftChain == 0 then
					driftLabel.Text = ""
				end
			end)
			if mode == "clock" and race.drift >= DRIFT_KING then
				ctx.trophies:Unlock("drift_king")
			end
		end
		race.driftChain, race.driftTime = 0, 0
	end

	-- Физика и правила одного кадра заезда
	local function drive(dt, controls)
		local f = Vector3.new(math.cos(car.yaw), 0, math.sin(car.yaw))
		local r = Vector3.new(-f.Z, 0, f.X)
		local fwd = car.vx * f.X + car.vz * f.Z
		local lat = car.vx * r.X + car.vz * r.Z
		local boosting = race.boostPad > 0 or (controls.boost and race.boost > 0)
		if boosting and not race.boosting then
			ctx.audio:Play("shoot", { volume = 0.35, pitch = 0.45 })
			ctx.input:Rumble(0.4, 0.2)
		end
		race.boosting = boosting
		if race.boostPad > 0 then
			race.boostPad -= dt
		elseif boosting then
			race.boost = math.max(0, race.boost - 0.5 * dt)
		end
		local maxNow = boosting and BOOST_SPEED or MAX_SPEED

		-- газ, тормоз, сопротивление
		if boosting then
			fwd += 160 * dt * math.max(0, 1 - fwd / maxNow)
		end
		if controls.throttle > 0 and fwd >= -1 then
			fwd += controls.throttle * ACCEL * dt * math.max(0, 1 - fwd / maxNow)
		end
		if controls.brake > 0 then
			if fwd > 1 then
				fwd = math.max(0, fwd - controls.brake * BRAKE * dt)
			else
				fwd = math.max(-REVERSE_SPEED, fwd - controls.brake * 40 * dt)
			end
		elseif controls.throttle > 0 and fwd < 0 then
			fwd = math.min(0, fwd + BRAKE * dt)
		end
		fwd -= fwd * DRAG * dt
		if fwd > maxNow then
			fwd -= (fwd - maxNow) * 1.5 * dt
		end

		-- руль: на месте не поворачивает, на скорости чуть тупее, в заносе острее
		local speedFactor = math.clamp(math.abs(fwd) / 25, 0, 1) * (1 - 0.4 * math.clamp(math.abs(fwd) / MAX_SPEED, 0, 1))
		local drifting = controls.drift and fwd > 35
		local turn = controls.steer * TURN * speedFactor * (drifting and 1.3 or 1) * (fwd < 0 and -1 or 1)
		car.yaw += turn * dt

		-- сцепление: боковая скорость гаснет; в заносе медленно, и часть её уходит в скорость вперёд
		local latBefore = math.abs(lat)
		lat *= math.exp(-(drifting and DRIFT_GRIP or GRIP) * dt)
		if drifting then
			fwd += (latBefore - math.abs(lat)) * 0.85
		end
		local nf = Vector3.new(math.cos(car.yaw), 0, math.sin(car.yaw))
		local nr = Vector3.new(-nf.Z, 0, nf.X)
		if drifting then
			-- в заносе скорость сохраняет прежнее направление, а машина поворачивается: её несёт боком
			car.vx = f.X * fwd + r.X * lat
			car.vz = f.Z * fwd + r.Z * lat
		else
			car.vx = nf.X * fwd + nr.X * lat
			car.vz = nf.Z * fwd + nr.Z * lat
		end
		local nlat = car.vx * nr.X + car.vz * nr.Z
		car.fwd, car.lat = car.vx * nf.X + car.vz * nf.Z, nlat

		-- движение и проекция на трассу
		local newPos = car.pos + Vector3.new(car.vx, 0, car.vz) * dt
		local idx, t, lateral, point, tangent, slope = track:project(newPos, car.idx)
		local limit = Track.WIDTH / 2 - CAR_HALF
		if math.abs(lateral) > limit then
			local side = lateral > 0 and 1 or -1
			local n = Vector3.new(-tangent.Z, 0, tangent.X) * side
			newPos -= n * (math.abs(lateral) - limit)
			local vn = car.vx * n.X + car.vz * n.Z
			if vn > 0 then
				local loss = 1 - math.clamp(vn / 160, 0.02, 0.45)
				car.vx = (car.vx - n.X * vn * 1.3) * loss
				car.vz = (car.vz - n.Z * vn * 1.3) * loss
				if vn > 12 and race.hitCooldown <= 0 then
					race.hitCooldown = 0.4
					race.lapClean = false
					race.driftChain, race.driftTime = 0, 0
					driftLabel.Text = ""
					ctx.audio:Play("hit", { volume = math.clamp(vn / 80, 0.2, 0.8), pitch = 0.9 })
					ctx.input:Rumble(math.clamp(vn / 80, 0.3, 1), 0.2)
				end
			end
			lateral = side * limit
		end
		race.hitCooldown -= dt
		car.pos = Vector3.new(newPos.X, point.Y, newPos.Z)
		car.idx, car.lateral, car.slope = idx, lateral, slope

		local speed = math.sqrt(car.vx ^ 2 + car.vz ^ 2)
		if state ~= "race" then
			return speed
		end

		-- ускорители на дороге
		for _, pad in built.pads do
			if idx == pad.index or idx == pad.index - 1 then
				if math.abs(lateral - pad.offset) < 7 and race.boostPad <= 0 then
					race.boostPad = 1.3
					race.lapPads[pad.index] = true
					message("BOOST!", CYAN, 0.8)
				end
			end
		end

		-- занос: очки и заряд ускорения
		local slip = math.abs(nlat)
		if slip > 9 and speed > 35 then
			race.driftTime += dt
			race.driftOff = 0
			race.driftChain += slip * dt * 10
			race.boost = math.min(1, race.boost + dt * 0.12)
			driftLabel.Text = `DRIFT {fmtNumber(race.driftChain)}`
			if race.driftTime >= 3 then
				ctx.trophies:Unlock("sideways")
			end
		elseif race.driftChain > 0 then
			race.driftOff += dt
			if race.driftOff > 0.35 then
				endDrift()
			end
		end

		-- сектора, круги и время
		local sector = math.floor((idx - 1) / SECTOR)
		if sector == (race.sector + 1) % 4 then
			race.sector = sector
			flashGate(checkpoints[sector + 1], sector == 0 and AMBER or PINK)
			if sector == 0 then
				if lapDone() then
					return speed
				end
			end
			if mode == "clock" then
				race.timeLeft += CLOCK_BONUS
				clockBonus.Text = `+{CLOCK_BONUS} s`
				clockBonus.TextTransparency, clockBonus.TextStrokeTransparency = 0, 0.6
				bonusTimer = 1.4
				if sector ~= 0 then
					ctx.audio:Play("confirm", { volume = 0.4, pitch = 1.3 })
				end
			end
		end
		return speed
	end

	local function readControls()
		local axes = ctx.input:GetAxes()
		local keyboard = ctx.input:Device() ~= "gamepad"
		local throttle = math.max(axes.r2, ctx.input:IsDown("cross") and 1 or 0, (keyboard and axes.ly > 0.3) and axes.ly or 0)
		local brake = math.max(axes.l2, ctx.input:IsDown("square") and 1 or 0, (keyboard and axes.ly < -0.3) and -axes.ly or 0)
		return {
			throttle = throttle,
			brake = brake,
			steer = math.clamp(axes.lx, -1, 1),
			drift = ctx.input:IsDown("circle") or ctx.input:IsDown("l1"),
			boost = ctx.input:IsDown("triangle") or ctx.input:IsDown("r1"),
		}
	end

	local IDLE = { throttle = 0, brake = 0.3, steer = 0, drift = false, boost = false }

	local function updateCamera(dt, speed)
		local f = Vector3.new(math.cos(car.yaw), 0, math.sin(car.yaw))
		local back = 17 + speed * 0.03
		local target = car.pos - f * back + Vector3.new(0, 6.5, 0)
		camPos = camPos:Lerp(target, 1 - math.exp(-7 * dt))
		local look = car.pos + f * 10 + Vector3.new(0, 2.5, 0)
		cam.CFrame = CFrame.lookAt(camPos, look)
		cam.FieldOfView = 68 + math.clamp(speed / MAX_SPEED, 0, 1.4) * 14
	end

	local function updateCarVisual()
		local f = Vector3.new(math.cos(car.yaw), 0, math.sin(car.yaw))
		placeCar(carParts, car.pos, f, car.slope)
		local flame = race.boosting and 0.05 + math.random() * 0.3 or 1
		carParts.FlameL.Transparency, carParts.FlameR.Transparency = flame, flame
		local braking = state == "race" and race.braking
		local tail = braking and Color3.fromRGB(255, 30, 60) or Color3.fromRGB(150, 0, 30)
		carParts.TailL.Color, carParts.TailR.Color = tail, tail
		carDot.Position = mapPos(car.pos)
	end

	local function updateGhost()
		if mode ~= "trial" or not ghost or state ~= "race" then
			return
		end
		local k = race.lapTime / GHOST_STEP + 1
		local i = math.floor(k)
		local a, b = ghost[i], ghost[i + 1]
		if not a or not b then
			setGhostVisible(false)
			return
		end
		if not ghostDot.Visible then
			setGhostVisible(true)
		end
		local w = k - i
		local x = (a[1] + (b[1] - a[1]) * w) / 2 + BASE.X
		local z = (a[2] + (b[2] - a[2]) * w) / 2 + BASE.Z
		local y = (a[3] + (b[3] - a[3]) * w) / 4 + BASE.Y
		local yaw = (a[4] + (b[4] - a[4]) * w) / 100
		local pos = Vector3.new(x, y, z)
		placeCar(ghostParts, pos, Vector3.new(math.cos(yaw), 0, math.sin(yaw)), 0)
		ghostDot.Position = mapPos(pos)
	end

	local function recordFrame(dt)
		race.recordTimer -= dt
		if race.recordTimer <= 0 then
			race.recordTimer += GHOST_STEP
			if #race.frames < 1200 then
				table.insert(race.frames, {
					math.floor((car.pos.X - BASE.X) * 2 + 0.5), math.floor((car.pos.Z - BASE.Z) * 2 + 0.5),
					math.floor((car.pos.Y - BASE.Y) * 4 + 0.5), math.floor(car.yaw * 100 + 0.5),
				})
			end
		end
	end

	local function updateHud(speed)
		if mode == "clock" then
			lapLabel.Text = `LAP {race.lap}/{LAPS}`
			local tl = math.max(0, race.timeLeft)
			clockLabel.Text = string.format("%.1f", tl)
			clockLabel.TextColor3 = tl < 5 and Color3.fromRGB(255, 70, 90) or WHITE
		else
			lapLabel.Text = `LAP {race.lap}`
		end
		timeLabel.Text = `TIME {fmtTime(race.lapTime)}`
		bestLabel.Text = `BEST {fmtTime(bestLap)}`
		speedLabel.Text = tostring(math.floor(speed * KMH))
		speedLabel.TextColor3 = race.boosting and CYAN or WHITE
		boostFill.Size = UDim2.fromScale(race.boost, 1)
	end

	-- Экраны меню
	local pauseMenu
	function titleScreen()
		state = "title"
		hud.Visible = false
		logo.Visible, tagline.Visible = true, true
		bigLabel.Text, msgLabel.Text = "", ""
		setGhostVisible(false)
		placeAt(2)
		local records = `Best lap {fmtTime(bestLap)}    Clock Run {fmtTime(bestClock)}    Drift {fmtNumber(bestDrift)}`
		openMenu("", records, {
			{ label = "Clock Run", hint = `{LAPS} laps. Every checkpoint adds {CLOCK_BONUS} seconds.`, action = function()
				startRace("clock")
			end },
			{ label = "Time Trial", hint = "Free laps against the ghost of your best lap.", action = function()
				startRace("trial")
			end },
			{ label = "Quit to PS5 Menu", action = function()
				ctx:Exit()
			end },
		}, function()
			ctx:Exit()
		end)
		menuTitle.Text = "MAIN MENU"
	end

	function pauseMenu()
		if state ~= "race" and state ~= "countdown" then
			return
		end
		pausedFrom = state
		state = "paused"
		local items = {
			{ label = "Resume", action = function()
				closeMenu()
				state = pausedFrom
			end },
			{ label = "Restart", action = function()
				startRace(mode)
			end },
		}
		if mode == "trial" then
			table.insert(items, { label = "End Session", action = function()
				finishRace(false)
			end })
		else
			table.insert(items, { label = "Main Menu", action = function()
				titleScreen()
			end })
		end
		table.insert(items, { label = "Quit to PS5 Menu", action = function()
			ctx:Exit()
		end })
		openMenu("PAUSED", mode == "clock" and "Clock Run" or "Time Trial", items, items[1].action)
	end

	ctx.input:On("press", function(btn)
		if menuFrame.Visible then
			if btn == "up" or btn == "down" then
				menu.index = (menu.index - 1 + (btn == "down" and 1 or -1)) % #menu.items + 1
				ctx.audio:Play("move", { volume = 0.3, pitch = 1.4 })
				drawMenu()
			elseif btn == "cross" then
				local item = menu.items[menu.index]
				if item then
					ctx.audio:Play("confirm", { volume = 0.4 })
					item.action()
				end
			elseif btn == "circle" and menu.onBack then
				ctx.audio:Play("back", { volume = 0.4 })
				menu.onBack()
			elseif btn == "options" and state == "paused" then
				menu.items[1].action()
			end
		elseif btn == "options" then
			pauseMenu()
		end
	end)

	-- Кнопка PS ставит игру на паузу системой; показываем и своё меню паузы
	ctx:On("pause", function()
		pauseMenu()
	end)

	ctx:Loop(function(dt)
		dt = math.min(dt, 1 / 20)
		if messageTimer > 0 then
			messageTimer -= dt
			if messageTimer <= 0 then
				msgLabel.Text = ""
			end
		end
		if bonusTimer > 0 then
			bonusTimer -= dt
			local a = 1 - math.clamp(bonusTimer / 0.6, 0, 1)
			clockBonus.TextTransparency, clockBonus.TextStrokeTransparency = a, 0.6 + a * 0.4
		end

		if state == "title" then
			orbit += dt * 0.22
			local center = car.pos + Vector3.new(0, 3, 0)
			camPos = center + Vector3.new(math.cos(orbit) * 30, 9 + math.sin(orbit * 0.7) * 3, math.sin(orbit) * 30)
			cam.CFrame = CFrame.lookAt(camPos, center)
			cam.FieldOfView = 60
			return
		elseif state == "paused" then
			return
		elseif state == "countdown" then
			race.countdown -= dt
			local n = math.ceil(race.countdown - 0.5)
			if n < race.lastCount then
				race.lastCount = n
				if n >= 1 then
					bigLabel.Text = tostring(n)
					bigLabel.TextColor3 = n == 1 and AMBER or PINK
					ctx.audio:Play("move", { volume = 0.7, pitch = 0.8 })
				end
			end
			if race.countdown <= 0.5 then
				bigLabel.Text = "GO!"
				bigLabel.TextColor3 = CYAN
				ctx.audio:Play("confirm", { volume = 0.8, pitch = 1.5 })
				state = "race"
				task.delay(0.8, function()
					if bigLabel.Parent and bigLabel.Text == "GO!" then
						bigLabel.Text = ""
					end
				end)
			end
			updateCamera(dt, 0)
			updateCarVisual()
			updateHud(0)
			return
		end

		local controls = state == "race" and readControls() or IDLE
		race.braking = controls.brake > 0.1
		if state == "race" then
			race.lapTime += dt
			race.raceTime += dt
			recordFrame(dt)
		end
		local speed = drive(dt, controls)
		if state == "race" and mode == "clock" then
			race.timeLeft -= dt
			if race.timeLeft <= 0 then
				race.timeLeft = 0
				finishRace(false)
			end
		end
		updateCamera(dt, speed)
		updateCarVisual()
		updateGhost()
		if state == "race" then
			updateHud(speed)
		end
	end)

	titleScreen()
end

return Game
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Track</string>
            <string name="Source"><![CDATA[-- Трасса Neon Drive: замкнутый сплайн, дорога с бетонными отбойниками и ночной город вокруг.
-- Вся математика на Vector3 и числах (без методов CFrame), чтобы работала и в имитации tools/mock.
local Track = {}
Track.__index = Track

Track.WIDTH = 44
local HALF = Track.WIDTH / 2
local SUB = 14 -- точек сплайна между опорными

-- Опорные точки (x, высота, z) относительно base. Длина круга около 4200 studs.
local CONTROL = {
	{ 0, 0, 0 }, { 450, 0, 0 }, { 760, 4, 70 }, { 880, 10, 300 }, { 780, 16, 520 }, { 540, 12, 580 },
	{ 380, 8, 740 }, { 430, 4, 960 }, { 260, 8, 1130 }, { -60, 16, 1090 }, { -230, 12, 880 }, { -140, 6, 660 },
	{ -330, 4, 500 }, { -470, 2, 270 }, { -380, 0, 70 }, { -200, 0, 0 },
}

local PINK = Color3.fromRGB(255, 61, 127)
local VIOLET = Color3.fromRGB(123, 44, 255)
local CYAN = Color3.fromRGB(0, 229, 255)
local AMBER = Color3.fromRGB(255, 176, 46)
Track.Colors = { pink = PINK, violet = VIOLET, cyan = CYAN, amber = AMBER }

local function catmull(p0, p1, p2, p3, t)
	local t2, t3 = t * t, t * t * t
	return (p1 * 2 + (p2 - p0) * t + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2 + (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function part(parent, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end
Track.part = part

-- Брусок между двумя точками (длина по направлению a→b)
local function beam(parent, a, b, width, height, color, material, transparency)
	local d = b - a
	local len = d.Magnitude
	if len < 0.01 then
		return nil
	end
	local mid = (a + b) / 2
	return part(parent, Vector3.new(width, height, len), CFrame.lookAt(mid, b), color, material, transparency)
end

function Track.new(base)
	local self = setmetatable({}, Track)
	self.base = base
	local pts = {}
	for _, c in CONTROL do
		table.insert(pts, Vector3.new(c[1], c[2], c[3]))
	end
	local n = #pts
	local samples = {}
	for i = 1, n do
		local p0, p1 = pts[(i - 2) % n + 1], pts[i]
		local p2, p3 = pts[i % n + 1], pts[(i + 1) % n + 1]
		for k = 0, SUB - 1 do
			table.insert(samples, base + catmull(p0, p1, p2, p3, k / SUB))
		end
	end
	self.samples = samples
	self.N = #samples
	-- направления и правые векторы в каждой точке (по горизонтали)
	self.tangents, self.rights, self.lengths, self.cum = {}, {}, {}, {}
	local total = 0
	for i = 1, self.N do
		local prev, nxt = samples[(i - 2) % self.N + 1], samples[i % self.N + 1]
		local t = flat(nxt - prev).Unit
		self.tangents[i] = t
		self.rights[i] = Vector3.new(-t.Z, 0, t.X)
		self.cum[i] = total
		self.lengths[i] = flat(nxt - samples[i]).Magnitude
		total += self.lengths[i]
	end
	self.total = total
	return self
end

function Track:sample(i)
	return self.samples[(i - 1) % self.N + 1]
end

-- Проекция точки на осевую линию. hint — индекс прошлого сегмента (поиск вокруг него).
-- Возвращает индекс сегмента, долю t по нему, боковое смещение (+ вправо), точку на оси, касательную.
function Track:project(pos, hint, wide)
	local N = self.N
	local bestD, bestI, bestT = math.huge, 1, 0
	local from, to = 1, N
	if hint and not wide then
		from, to = hint - 8, hint + 8
	end
	local px, pz = pos.X, pos.Z
	for k = from, to do
		local i = (k - 1) % N + 1
		local a, b = self.samples[i], self.samples[i % N + 1]
		local dx, dz = b.X - a.X, b.Z - a.Z
		local len2 = dx * dx + dz * dz
		local t = math.clamp(((px - a.X) * dx + (pz - a.Z) * dz) / len2, 0, 1)
		local cx, cz = a.X + dx * t - px, a.Z + dz * t - pz
		local d = cx * cx + cz * cz
		if d < bestD then
			bestD, bestI, bestT = d, i, t
		end
	end
	local a, b = self.samples[bestI], self.samples[bestI % N + 1]
	local point = a + (b - a) * bestT
	local tangent = flat(b - a).Unit
	local right = Vector3.new(-tangent.Z, 0, tangent.X)
	local lateral = (pos.X - point.X) * right.X + (pos.Z - point.Z) * right.Z
	local slope = (b.Y - a.Y) / math.max(self.lengths[bestI], 0.01)
	return bestI, bestT, lateral, point, tangent, slope
end

-- Пройденная доля круга 0..1
function Track:progress(i, t)
	return (self.cum[i] + self.lengths[i] * t) / self.total
end

local function nearTrack(self, pos, clearance)
	local c2 = clearance * clearance
	for _, s in self.samples do
		local dx, dz = s.X - pos.X, s.Z - pos.Z
		if dx * dx + dz * dz < c2 then
			return true
		end
	end
	return false
end

-- Строит дорогу, ворота, ускорители и город. Возвращает { gates = {...}, pads = {...} }.
function Track:build(parent, checkpoints, padSpots)
	local rng = Random.new(7)
	local N, S, R = self.N, self.samples, self.rights
	local road = Instance.new("Model")
	road.Name = "Road"
	local asphalt = Color3.fromRGB(22, 18, 34)

	local minX, maxX, minZ, maxZ, minY = math.huge, -math.huge, math.huge, -math.huge, math.huge
	for _, s in S do
		minX, maxX = math.min(minX, s.X), math.max(maxX, s.X)
		minZ, maxZ = math.min(minZ, s.Z), math.max(maxZ, s.Z)
		minY = math.min(minY, s.Y)
	end
	local groundY = minY - 1.5

	for i = 1, N do
		local a, b = S[i], S[i % N + 1]
		-- полотно: брусок по сегменту + диск в точке, чтобы на поворотах не было щелей
		beam(road, a - Vector3.new(0, 0.5, 0), b - Vector3.new(0, 0.5, 0), Track.WIDTH, 1, asphalt, Enum.Material.Asphalt)
		local disc = part(road, Vector3.new(1, Track.WIDTH, Track.WIDTH), CFrame.new(a - Vector3.new(0, 0.55, 0)) * CFrame.Angles(0, 0, math.pi / 2), asphalt, Enum.Material.Asphalt)
		disc.Shape = Enum.PartType.Cylinder
		-- бетонные отбойники по краям, сверху полоса: через сегмент красная и белая
		local stripe = (math.floor(i / 3) % 2 == 0) and Color3.fromRGB(200, 40, 40) or Color3.fromRGB(235, 235, 235)
		local ra, rb = R[i], R[i % N + 1]
		for _, side in { -1, 1 } do
			local ea = a + ra * (side * (HALF + 0.6)) + Vector3.new(0, 1.1, 0)
			local eb = b + rb * (side * (HALF + 0.6)) + Vector3.new(0, 1.1, 0)
			beam(road, ea, eb, 0.7, 2.2, Color3.fromRGB(150, 148, 145), Enum.Material.Concrete)
			beam(road, ea + Vector3.new(0, 1.2, 0), eb + Vector3.new(0, 1.2, 0), 0.75, 0.3, stripe, Enum.Material.SmoothPlastic)
		end
		-- разметка по центру
		if i % 2 == 0 then
			local m = (a + b) / 2 + Vector3.new(0, 0.03, 0)
			local dir = (b - a).Unit
			beam(road, m - dir * 4, m + dir * 4, 0.6, 0.06, Color3.fromRGB(225, 220, 200), Enum.Material.SmoothPlastic, 0.2)
		end
		-- опоры под эстакадой
		if a.Y - groundY > 4 and i % 3 == 0 then
			for _, side in { -1, 1 } do
				local top = a + ra * (side * (HALF - 4)) - Vector3.new(0, 1, 0)
				local h = top.Y - groundY
				part(road, Vector3.new(3, h, 3), CFrame.new(top.X, groundY + h / 2, top.Z), Color3.fromRGB(30, 26, 46), Enum.Material.Concrete)
			end
		end
		-- фонари: столб, плафон и тёплый свет
		if i % 9 == 0 then
			local side = (i % 18 == 0) and 1 or -1
			local foot = a + ra * (side * (HALF + 3))
			part(road, Vector3.new(0.8, 16, 0.8), CFrame.new(foot + Vector3.new(0, 8, 0)), Color3.fromRGB(40, 36, 60), Enum.Material.Metal)
			local head = beam(road, foot + Vector3.new(0, 16, 0), foot - ra * (side * 6) + Vector3.new(0, 16, 0), 1.2, 0.5, Color3.fromRGB(255, 226, 170), Enum.Material.Glass)
			if head then
				local light = Instance.new("PointLight")
				light.Color = head.Color
				light.Range = 45
				light.Brightness = 2.2
				light.Parent = head
			end
		end
	end

	-- старт/финиш: клетчатая линия и арка
	local gates = {}
	local function gate(index, color, isStart)
		local g = Instance.new("Model")
		g.Name = isStart and "StartGate" or ("Checkpoint" .. index)
		local a, r, t = S[index], R[index], self.tangents[index]
		local bars = {}
		for _, side in { -1, 1 } do
			local foot = a + r * (side * (HALF + 2))
			table.insert(bars, part(g, Vector3.new(2, 20, 2), CFrame.new(foot + Vector3.new(0, 10, 0)), color, Enum.Material.SmoothPlastic))
		end
		table.insert(bars, beam(g, a - r * (HALF + 3) + Vector3.new(0, 20, 0), a + r * (HALF + 3) + Vector3.new(0, 20, 0), 2, isStart and 4 or 1.6, color, Enum.Material.SmoothPlastic))
		if isStart then
			for row = 0, 1 do
				for col = 0, 10 do
					local pos = a + r * (-HALF + 2 + col * 4) + t * (row * 4 - 2) + Vector3.new(0, 0.04, 0)
					local white = (row + col) % 2 == 0
					part(g, Vector3.new(4, 0.08, 4), CFrame.lookAt(pos, pos + t), white and Color3.new(0.95, 0.95, 1) or Color3.fromRGB(10, 10, 16), Enum.Material.SmoothPlastic)
				end
			end
			local sign = beam(g, a - r * 14 + Vector3.new(0, 25, 0), a + r * 14 + Vector3.new(0, 25, 0), 1, 6, Color3.fromRGB(16, 8, 30), Enum.Material.SmoothPlastic)
			if sign then
				for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
					local gui = Instance.new("SurfaceGui")
					gui.Face = face
					gui.LightInfluence = 0
					gui.PixelsPerStud = 20
					gui.Parent = sign
					local label = Instance.new("TextLabel")
					label.Size = UDim2.fromScale(1, 1)
					label.BackgroundTransparency = 1
					label.Text = "NEON DRIVE"
					label.TextScaled = true
					label.Font = Enum.Font.Arcade
					label.TextColor3 = PINK
					label.Parent = gui
				end
			end
		end
		g.Parent = parent
		gates[index] = bars
	end
	gate(1, Color3.new(1, 1, 1), true)
	for _, idx in checkpoints do
		if idx ~= 1 then
			gate(idx, CYAN, false)
		end
	end

	-- ускорители: голубая плита со стрелками
	local pads = {}
	for _, spot in padSpots do
		local a, r, t = S[spot.index], R[spot.index], self.tangents[spot.index]
		local center = a + r * spot.offset + Vector3.new(0, 0.05, 0)
		part(road, Vector3.new(12, 0.1, 16), CFrame.lookAt(center, center + t), Color3.fromRGB(30, 120, 170), Enum.Material.SmoothPlastic)
		for k = 0, 2 do
			local tip = center + t * (k * 5 - 3) + Vector3.new(0, 0.08, 0)
			for _, side in { -1, 1 } do
				beam(road, tip - t * 3 + r * (side * 4), tip, 1, 0.08, Color3.fromRGB(235, 245, 255), Enum.Material.SmoothPlastic)
			end
		end
		table.insert(pads, { index = spot.index, offset = spot.offset, center = center })
	end
	road.Parent = parent

	-- город
	local city = Instance.new("Model")
	city.Name = "City"
	local ground = part(city, Vector3.new(maxX - minX + 1400, 1, maxZ - minZ + 1400), CFrame.new((minX + maxX) / 2, groundY - 0.5, (minZ + maxZ) / 2), Color3.fromRGB(38, 40, 44), Enum.Material.Asphalt)
	ground.Name = "Ground"

	local function building(pos, t, w, d, h, detail)
		local body = Color3.fromRGB(rng:NextInteger(12, 26), rng:NextInteger(10, 20), rng:NextInteger(28, 48))
		local center = Vector3.new(pos.X, groundY + h / 2, pos.Z)
		local look = center + t
		part(city, Vector3.new(w, h, d), CFrame.lookAt(center, look), body, Enum.Material.SmoothPlastic)
		local r = Vector3.new(-t.Z, 0, t.X)
		if detail then
			-- полосы окон по периметру: часть горит тёплым светом, часть тёмная
			local bands = math.clamp(math.floor(h / 28), 1, 5)
			for k = 1, bands do
				local y = groundY + h * k / (bands + 1)
				local lit = rng:NextNumber(0, 1) < 0.6
				local c = lit and Color3.fromRGB(235, 200, 130) or Color3.fromRGB(40, 46, 60)
				local p = Vector3.new(center.X, y, center.Z)
				part(city, Vector3.new(w + 0.4, 1.2, d + 0.4), CFrame.lookAt(p, p + t), c, Enum.Material.Glass)
			end
		end
	end

	for i = 1, N, 3 do
		local s, t, r = S[i], self.tangents[i], R[i]
		for _, side in { -1, 1 } do
			local w, d, h = rng:NextNumber(22, 46), rng:NextNumber(22, 46), rng:NextNumber(40, 200)
			local off = HALF + 16 + rng:NextNumber(0, 36) + math.max(w, d) / 2
			local pos = s + r * (side * off)
			if not nearTrack(self, pos, HALF + 6 + math.max(w, d) * 0.72) then
				building(pos, t, w, d, h, true)
			end
		end
	end
	-- дальние небоскрёбы на фоне
	for i = 1, N, 6 do
		local s, t, r = S[i], self.tangents[i], R[i]
		for _, side in { -1, 1 } do
			local w, d, h = rng:NextNumber(40, 80), rng:NextNumber(40, 80), rng:NextNumber(180, 420)
			local pos = s + r * (side * rng:NextNumber(180, 340))
			if not nearTrack(self, pos, HALF + 20 + math.max(w, d) * 0.72) then
				building(pos, t, w, d, h, false)
			end
		end
	end
	city.Parent = parent

	return { gates = gates, pads = pads, groundY = groundY }
end

return Track
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">art</string>
            <string name="Source"><![CDATA[-- Сгенерировано blender/export_luau.py из assets/renders/neon_drive_art.png. Не редактировать вручную.
-- Key art neon_drive: RGB 320×180 в base64, собирается в EditableImage.
return { width = 320, height = 180, rgb = "" }
]]></string>
