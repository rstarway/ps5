      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">Snake</string>
          <string name="Source"><![CDATA[-- Змейка на сетке 24×15: каждая клетка — Frame, раз в шаг перекрашиваем.
local Snake = {}

local W, H, CELL = 24, 15, 44
local DIRS = { up = Vector2.new(0, -1), down = Vector2.new(0, 1), left = Vector2.new(-1, 0), right = Vector2.new(1, 0) }

function Snake.launch(ctx)
	local ui = ctx.ui
	local canvas = ui.canvas(ctx.gui)
	ctx.gui.BackgroundColor3 = Color3.fromRGB(8, 20, 14)
	local board = ui.new("Frame", {
		Size = UDim2.fromOffset(W * CELL, H * CELL), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 580),
		BackgroundColor3 = Color3.fromRGB(16, 40, 28), Parent = canvas,
	}, { ui.corner(16) })
	local cells = {}
	for y = 0, H - 1 do
		for x = 0, W - 1 do
			cells[y * W + x] = ui.new("Frame", {
				Size = UDim2.fromOffset(CELL - 4, CELL - 4), Position = UDim2.fromOffset(x * CELL + 2, y * CELL + 2),
				BackgroundTransparency = 1, Parent = board,
			}, { ui.corner(8) })
		end
	end
	local scoreLabel = ui.text("", { Size = UDim2.fromOffset(1920, 60), Position = UDim2.fromOffset(0, 120), TextSize = 44, Font = ctx.theme.FontHeavy, TextXAlignment = Enum.TextXAlignment.Center, Parent = canvas })
	local message = ui.text("", { Size = UDim2.fromOffset(1920, 120), Position = UDim2.fromOffset(0, 520), TextSize = 50, Font = ctx.theme.FontHeavy, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = canvas })

	local best = ctx.save:Get("best", 0)
	local body, dir, nextDir, apple, timer, score, alive

	local function placeApple()
		repeat
			apple = Vector2.new(math.random(0, W - 1), math.random(0, H - 1))
			local free = true
			for _, p in body do
				if p == apple then
					free = false
				end
			end
		until free
	end

	local function draw()
		for _, c in cells do
			c.BackgroundTransparency = 1
		end
		for i, p in body do
			local c = cells[p.Y * W + p.X]
			c.BackgroundTransparency = 0
			c.BackgroundColor3 = i == 1 and Color3.fromRGB(200, 255, 140) or Color3.fromRGB(80, 220, 120):Lerp(Color3.fromRGB(30, 140, 80), i / #body)
		end
		local a = cells[apple.Y * W + apple.X]
		a.BackgroundTransparency = 0
		a.BackgroundColor3 = Color3.fromRGB(255, 70, 80)
		scoreLabel.Text = `🍎 {score}     Best {best}`
	end

	local function reset()
		body = { Vector2.new(8, 7), Vector2.new(7, 7), Vector2.new(6, 7) }
		dir, nextDir, timer, score, alive = DIRS.right, DIRS.right, 0, 0, true
		message.Text = ""
		placeApple()
		draw()
	end

	ctx.input:On("press", function(btn)
		local d = DIRS[btn]
		if d and alive and d ~= -dir then
			nextDir = d
		elseif btn == "cross" and not alive then
			reset()
		elseif btn == "circle" then
			ctx:Exit()
		end
	end)

	ctx:Loop(function(dt)
		if not alive then
			return
		end
		timer += dt
		local stepTime = math.max(0.06, 0.13 - score * 0.0015)
		if timer < stepTime then
			return
		end
		timer = 0
		dir = nextDir
		local head = body[1] + dir
		local hit = head.X < 0 or head.Y < 0 or head.X >= W or head.Y >= H
		for i = 1, #body - 1 do
			if body[i] == head then
				hit = true
			end
		end
		if hit then
			alive = false
			ctx.audio:Play("explosion")
			ctx.input:Rumble(0.6, 0.3)
			if score > best then
				best = score
				ctx.save:Set("best", best)
			end
			message.Text = `Game over · {score} 🍎\n{ctx.input:Glyph("cross")} play again   {ctx.input:Glyph("circle")} quit`
			return
		end
		table.insert(body, 1, head)
		if head == apple then
			score += 1
			ctx.audio:Play("confirm", { pitch = 1 + math.min(score, 30) * 0.02 })
			ctx.trophies:Unlock("first_apple")
			if score >= 20 then
				ctx.trophies:Unlock("score_20")
			end
			if score >= 50 then
				ctx.trophies:Unlock("score_50")
			end
			placeApple()
		else
			table.remove(body)
		end
		draw()
	end)

	reset()
end

return Snake
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "snake",
	title = "Snake",
	category = "game",
	genre = "Classic",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 10,
	description = "The classic: eat apples, grow longer and don't bite your own tail.",
	icon = "🐍",
	cover = "",
	art = "",
	colors = { "#80ED99", "#0B3D20" },
	controls = {
		{ "D-pad / arrows / WASD", "Turn" },
		{ "✕ / Enter", "Start again" },
		{ "○", "Quit" },
	},
	trophies = {
		{ id = "first_apple", name = "Snack Time", description = "Eat your first apple", grade = "bronze" },
		{ id = "score_20", name = "Long Boi", description = "Eat 20 apples in one run", grade = "silver" },
		{ id = "score_50", name = "Anaconda", description = "Eat 50 apples in one run", grade = "gold" },
		{ id = "platinum", name = "Snake Charmer", description = "Earn every Snake trophy", grade = "platinum" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="98">
        <Properties>
          <string name="Name">StarPilot</string>
          <string name="Source"><![CDATA[-- Star Pilot — пример 2D-игры на GUI. Использует ctx.input, ctx.save, ctx.trophies, ctx.audio, ctx:Loop.
local Game = {}

local W, H = 1920, 1080
local SHIP_SPEED = 720
local BULLET_SPEED = 1400

function Game.launch(ctx)
	local ui = ctx.ui
	ctx.gui.BackgroundColor3 = Color3.fromRGB(4, 5, 16)
	ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = ctx.gui,
	}, { ui.gradient({ Color3.fromRGB(10, 8, 40), Color3.fromRGB(2, 2, 10) }, 90) })
	local canvas = ui.canvas(ctx.gui, W, H)
	canvas.ClipsDescendants = true

	-- Звёзды
	local stars = {}
	for _ = 1, 90 do
		local size = math.random(2, 4)
		local star = ui.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = math.random() * 0.6,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(size, size),
			Parent = canvas,
		})
		table.insert(stars, { frame = star, x = math.random() * W, y = math.random() * H, speed = 40 + size * 60 })
	end

	-- HUD
	local hud = ui.text("", { Size = UDim2.fromOffset(1200, 40), Position = UDim2.fromOffset(40, 24), TextSize = 30, Font = ctx.theme.FontBold, ZIndex = 10, Parent = canvas })
	local centerText = ui.text("", {
		Size = UDim2.fromOffset(W, 300), Position = UDim2.fromOffset(0, H / 2 - 150), TextSize = 40, Font = ctx.theme.FontBold,
		TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 20, Parent = canvas,
	})

	local ship = ui.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Size = UDim2.fromOffset(70, 70), ZIndex = 5, Parent = canvas })
	ui.text("▲", { Size = UDim2.fromScale(1, 1), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Color3.fromRGB(90, 220, 255), ZIndex = 5, Parent = ship })

	local state, menuIndex = "play", 1
	local x, y, lives, score, elapsed, cooldown, spawnTimer, invuln, wasHit
	local bullets, rocks = {}, {}
	local best = ctx.save:Get("best", 0)

	local function clearEntities()
		for _, list in { bullets, rocks } do
			for _, e in list do
				e.frame:Destroy()
			end
			table.clear(list)
		end
	end

	local function reset()
		clearEntities()
		x, y = W / 2, H - 160
		lives, score, elapsed, cooldown, spawnTimer, invuln, wasHit = 3, 0, 0, 0, 0, 0, false
		state = "play"
		centerText.Text = ""
	end

	local MENU = { "Resume", "Restart", "Quit to PS5 Menu" }
	local function drawMenu()
		local lines = { "PAUSED", "" }
		for i, item in MENU do
			table.insert(lines, (i == menuIndex and "▶  " or "    ") .. item)
		end
		centerText.Text = table.concat(lines, "\n")
	end

	local function gameOver()
		state = "over"
		ctx.input:Rumble(1, 0.5)
		ctx.audio:Play("explosion", { volume = 0.8, pitch = 0.6 })
		if score > best then
			best = score
			ctx.save:Set("best", best)
		end
		ctx.save:Set("games", ctx.save:Get("games", 0) + 1)
		centerText.Text = `GAME OVER\nScore: {score}   Best: {best}\n\n{ctx.input:Glyph("cross")} — play again    {ctx.input:Glyph("circle")} — quit`
	end

	local function spawnRock()
		local r = math.random(30, 70)
		local rock = ui.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.fromHSV(0.07, 0.3, 0.35 + math.random() * 0.25),
			Size = UDim2.fromOffset(r * 2, r * 2),
			ZIndex = 4,
			Parent = canvas,
		}, { ui.corner(UDim.new(0.5, 0)), ui.stroke(Color3.fromRGB(255, 150, 90), 2, 0.5) })
		local speed = 160 + elapsed * 4 + math.random() * 120
		table.insert(rocks, { frame = rock, x = math.random(60, W - 60), y = -r, vx = (math.random() - 0.5) * 120, vy = speed, r = r, hp = r > 50 and 2 or 1 })
	end

	local function checkTrophies()
		if score >= 100 then
			ctx.trophies:Unlock("score_100")
		end
		if score >= 500 then
			ctx.trophies:Unlock("score_500")
		end
		if score >= 200 and not wasHit then
			ctx.trophies:Unlock("untouchable")
		end
		if elapsed >= 60 then
			ctx.trophies:Unlock("survivor")
		end
	end

	ctx.input:On("press", function(btn)
		if state == "play" then
			if btn == "options" then
				state, menuIndex = "paused", 1
				drawMenu()
			end
		elseif state == "paused" then
			if btn == "up" or btn == "down" then
				menuIndex = (menuIndex - 1 + (btn == "down" and 1 or -1)) % #MENU + 1
				ctx.audio:Play("move", { volume = 0.3, pitch = 1.6 })
				drawMenu()
			elseif btn == "circle" or btn == "options" then
				state = "play"
				centerText.Text = ""
			elseif btn == "cross" then
				if menuIndex == 1 then
					state = "play"
					centerText.Text = ""
				elseif menuIndex == 2 then
					reset()
				else
					ctx:Exit()
				end
			end
		elseif state == "over" then
			if btn == "cross" then
				reset()
			elseif btn == "circle" then
				ctx:Exit()
			end
		end
	end)

	-- Пауза системы (кнопка PS): ctx:Loop останавливается сам, здесь — ставим и игровое меню.
	ctx:On("pause", function()
		if state == "play" then
			state, menuIndex = "paused", 1
			drawMenu()
		end
	end)

	reset()

	ctx:Loop(function(dt)
		for _, s in stars do
			s.y = (s.y + s.speed * dt) % H
			s.frame.Position = UDim2.fromOffset(s.x, s.y)
		end
		if state ~= "play" then
			return
		end
		elapsed += dt
		local axes = ctx.input:GetAxes()
		x = math.clamp(x + axes.lx * SHIP_SPEED * dt, 40, W - 40)
		y = math.clamp(y - axes.ly * SHIP_SPEED * dt, 80, H - 40)
		ship.Position = UDim2.fromOffset(x, y)
		invuln = math.max(0, invuln - dt)
		ship.Visible = invuln == 0 or math.floor(invuln * 10) % 2 == 0

		cooldown -= dt
		if (ctx.input:IsDown("cross") or ctx.input:IsDown("r2")) and cooldown <= 0 then
			cooldown = 0.16
			local b = ui.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(120, 240, 255), BorderSizePixel = 0,
				Size = UDim2.fromOffset(6, 26), ZIndex = 3, Parent = canvas,
			}, { ui.corner(3) })
			table.insert(bullets, { frame = b, x = x, y = y - 40 })
			ctx.audio:Play("shoot", { volume = 0.15, pitch = 1.8 })
		end

		spawnTimer -= dt
		if spawnTimer <= 0 then
			spawnTimer = math.max(0.25, 1.1 - elapsed * 0.012)
			spawnRock()
		end

		for i = #bullets, 1, -1 do
			local b = bullets[i]
			b.y -= BULLET_SPEED * dt
			b.frame.Position = UDim2.fromOffset(b.x, b.y)
			if b.y < -30 then
				b.frame:Destroy()
				table.remove(bullets, i)
			end
		end

		for i = #rocks, 1, -1 do
			local r = rocks[i]
			r.x += r.vx * dt
			r.y += r.vy * dt
			r.frame.Position = UDim2.fromOffset(r.x, r.y)
			local destroyed = false
			for j = #bullets, 1, -1 do
				local b = bullets[j]
				if (b.x - r.x) ^ 2 + (b.y - r.y) ^ 2 < r.r ^ 2 then
					b.frame:Destroy()
					table.remove(bullets, j)
					r.hp -= 1
					if r.hp <= 0 then
						destroyed = true
						score += r.r > 50 and 20 or 10
						ctx.audio:Play("explosion", { volume = 0.35, pitch = 1.4 })
						ctx.trophies:Unlock("first_blood")
						break
					end
				end
			end
			if not destroyed and invuln == 0 and (x - r.x) ^ 2 + (y - r.y) ^ 2 < (r.r + 26) ^ 2 then
				destroyed = true
				lives -= 1
				wasHit = true
				invuln = 2
				ctx.input:Rumble(0.8, 0.3)
				ctx.audio:Play("hit", { volume = 0.6, pitch = 0.8 })
				if lives <= 0 then
					r.frame:Destroy()
					table.remove(rocks, i)
					gameOver()
					return
				end
			end
			if destroyed or r.y > H + 100 then
				r.frame:Destroy()
				table.remove(rocks, i)
			end
		end

		checkTrophies()
		hud.Text = `Score: {score}    Best: {math.max(best, score)}    Lives: {string.rep("♥", lives)}    {math.floor(elapsed)} s`
	end)
end

return Game
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">art</string>
            <string name="Source"><![CDATA[-- Сгенерировано blender/export_luau.py из assets/renders/star_pilot_art.png. Не редактировать вручную.
-- Key art star_pilot: RGB 320×180 в base64, собирается в EditableImage.
return { width = 320, height = 180, rgb = "" }
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">cover</string>
            <string name="Source"><![CDATA[-- Сгенерировано blender/export_luau.py из assets/renders/star_pilot_cover.png. Не редактировать вручную.
-- Обложка Star Pilot: RGB 192×192 в base64, собирается в EditableImage.
return { width = 192, height = 192, rgb = "" }
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "star_pilot",
	title = "Star Pilot",
	category = "game", -- game | media | app
	genre = "Arcade",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 1,
	preinstalled = true, -- стоит на консоли сразу, остальные игры скачиваются в PS Store
	description = "Sandbox sample game: blast asteroids and dodge them. Shows off input, saves, trophies and sound.",
	icon = "🚀", -- символ или "rbxassetid://..."
	art = "art", -- фон главного экрана (blender/game_art.py)
	cover = "cover", -- модуль cover.luau в этой папке (рендер из Blender) или "rbxassetid://..."
	colors = { "#FF6B35", "#2B0F54" },
	controls = {
		{ "Stick / arrows / WASD", "Move" },
		{ "✕ / Enter / Space", "Fire" },
		{ "OPTIONS / O", "Pause" },
		{ "PS / H", "Control Center" },
	},
	trophies = {
		{ id = "first_blood", name = "First Shot", description = "Destroy your first asteroid", grade = "bronze" },
		{ id = "score_100", name = "Pilot", description = "Score 100 points", grade = "bronze" },
		{ id = "score_500", name = "Ace", description = "Score 500 points", grade = "silver" },
		{ id = "untouchable", name = "Untouchable", description = "Score 200 points without losing a life", grade = "silver", hidden = true },
		{ id = "survivor", name = "Survivor", description = "Survive for 60 seconds", grade = "gold" },
		{ id = "platinum", name = "King of Space", description = "Earn every Star Pilot trophy", grade = "platinum" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="102">
        <Properties>
          <string name="Name">_Template</string>
          <string name="Source"><![CDATA[-- Шаблон: 2D-интерфейс в ctx.gui + 3D-объект в ctx.world, счётчик в сохранениях и трофей.
local Template = {}

function Template.launch(ctx)
	local ui = ctx.ui

	-- 3D: вращающийся куб перед камерой
	local cube = Instance.new("Part")
	cube.Anchored = true
	cube.Size = Vector3.new(4, 4, 4)
	cube.Color = Color3.fromRGB(58, 134, 255)
	cube.Material = Enum.Material.SmoothPlastic
	cube.Position = Vector3.new(0, 105, 0)
	cube.Parent = ctx.world
	ctx.camera.CameraType = Enum.CameraType.Scriptable
	ctx.camera.CFrame = CFrame.lookAt(Vector3.new(0, 107, 14), cube.Position)

	-- 2D: прозрачный фон, чтобы был виден 3D-мир
	ctx.gui.BackgroundTransparency = 1
	local canvas = ui.canvas(ctx.gui)
	local label = ui.text("", {
		Size = UDim2.fromOffset(1920, 200),
		Position = UDim2.fromOffset(0, 760),
		TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = canvas,
	})

	local count = ctx.save:Get("count", 0)
	local function render()
		label.Text = `Hello, {ctx.user.name}!\n✕ pressed: {count}   ({ctx.input:Glyph("circle")} — quit)`
	end
	render()

	ctx.input:On("press", function(btn)
		if btn == "cross" then
			count += 1
			ctx.save:Set("count", count)
			ctx.trophies:Unlock("hello")
			ctx.audio:Play("confirm")
			render()
		elseif btn == "circle" then
			ctx:Exit()
		end
	end)

	ctx:Loop(function(dt)
		cube.CFrame = cube.CFrame * CFrame.Angles(dt, dt * 0.7, 0)
	end)

	ctx:On("exit", function()
		-- ctx.world, ctx.gui, подписки и звуки очищаются системой; здесь — своё
	end)
end

return Template
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Шаблон приложения. Скопируйте папку _Template, переименуйте и уберите hidden = true.
return {
	id = "my_game", -- уникальный: латиница, цифры, _ и -
	title = "My Game",
	category = "game", -- game | media | app
	genre = "Genre",
	developer = "Your Name",
	version = "0.1",
	description = "Short description for the home screen and the store.",
	icon = "🎮",
	cover = "", -- модуль-картинка cover.luau в папке игры или "rbxassetid://..."
	art = "", -- фон главного экрана 16:9 (art.luau), рисует blender/game_art.py
	colors = { "#3A86FF", "#14213D" },
	hidden = true, -- шаблон не показывается в системе; удалите эту строку в своей игре
	controls = {
		{ "✕", "Action" },
		{ "○", "Exit" },
	},
	trophies = {
		{ id = "hello", name = "Hello, PS5", description = "Press ✕ for the first time", grade = "bronze" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="104">
      <Properties>
        <string name="Name">PS5Assets</string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="105">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="106">
      <Properties>
        <string name="Name">ChillZone</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Чиллзона целиком из Blender: дом, двор, столкновения, свет, таблички и метки описаны в blender/chillzone.py
-- и выгружены в Assets/ChillZoneParts (python3 blender/export_luau.py chillzone). Сервер только кладёт землю (Terrain),
-- строит детали из этого модуля и настраивает освещение. Планировка: вход прямо по дорожке от точки появления,
-- в доме по центру PLAY (телевизор и PS5), слева MY GAMES, справа MY TROPHIES; во дворе костёр слева и пруд справа.
-- У каждого игрока своя чиллзона (Workspace.ChillZones.Zone_<UserId>) на своём участке. Она растёт вместе с уровнем
-- игрока (атрибут PS5Tier от PS5Server): детали уровня выше текущего лежат в ServerStorage и появляются при повышении.
-- Игроки ходят в гости через RemoteEvent PS5Remotes.VisitZone.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

-- Сборка шаблона (меши из Creator Store) занимает секунды; без этого персонаж
-- появлялся над пустотой и разбивался ниже FallenPartsDestroyHeight. Спавн ниже, в createZone.
game:GetService("Players").CharacterAutoLoads = false

local zone = Instance.new("Model")
zone.Name = "ChillZone"

local rgb = Color3.fromRGB
local M = Enum.Material

local function part(name, size, at, color, material, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = typeof(at) == "CFrame" and at or CFrame.new(at)
	p.Color = color or rgb(200, 200, 200)
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props or {} do
		p[k] = v
	end
	p.Parent = zone
	return p
end

local function sign(p, face, text, color, size)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	-- табличка освещается как обычная поверхность: никакого свечения
	gui.LightInfluence = 1
	gui.Brightness = 1
	gui.PixelsPerStud = 50
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.BuilderSansMedium
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.18, 0)
	padding.PaddingBottom = UDim.new(0.18, 0)
	padding.Parent = label
	gui.Parent = p
	return gui
end

-- Земля: участок идеально ровный (поверхность ровно на y = 0, по границе вокселей, поэтому Terrain нигде
-- не вылезает сквозь дорожки и полы), за живой изгородью рельеф плавно поднимается в лесистые холмы.
-- Бассейн: Terrain-вода в плиточной чаше из Blender (метка Pool с координатами).
local terrain = Workspace.Terrain
local VOXEL = 4
local PLOT_HALF_X, PLOT_Z0, PLOT_Z1 = 92, -57, 128 -- ровная зона (изгородь + 12 студов газона за ней)
local HILL_X, HILL_Z0, HILL_Z1 = 256, -228, 296 -- куда тянутся холмы (участки соседей через 520 по X)

local function smoothstep(a, b, x)
	local t = math.clamp((x - a) / (b - a), 0, 1)
	return t * t * (3 - 2 * t)
end

-- высота земли относительно начала участка
local function groundHeight(x, z)
	local dx = math.max(math.abs(x) - PLOT_HALF_X, 0)
	local dz = math.max(z - PLOT_Z1, PLOT_Z0 - z, 0)
	local d = math.sqrt(dx * dx + dz * dz)
	if d <= 0 then
		return 0
	end
	local big = 0.65 + 0.35 * math.noise(x / 90, z / 90, 0.37)
	local small = math.noise(x / 28, z / 28, 1.91) * 5
	return 46 * smoothstep(6, 130, d) * big + small * smoothstep(0, 40, d)
end

local function fillTerrain(origin)
	-- WriteVoxels требует области, выровненной по сетке 4 студа
	local x0, x1 = origin.X - HILL_X, origin.X + HILL_X
	local z0, z1 = origin.Z + HILL_Z0, origin.Z + HILL_Z1
	local y0, y1 = -16, 64
	local nx, ny, nz = (x1 - x0) / VOXEL, (y1 - y0) / VOXEL, (z1 - z0) / VOXEL
	local materials, occupancy = table.create(nx), table.create(nx)
	for i = 1, nx do
		local mi, oi = table.create(ny), table.create(ny)
		for j = 1, ny do
			mi[j], oi[j] = table.create(nz), table.create(nz)
		end
		local x = x0 + (i - 0.5) * VOXEL - origin.X
		for k = 1, nz do
			local z = z0 + (k - 0.5) * VOXEL - origin.Z
			local h = groundHeight(x, z)
			local mat = (h > 6 and math.noise(x / 40, z / 40, 7.3) > 0.15) and M.LeafyGrass or M.Grass
			for j = 1, ny do
				-- гладкий Terrain рисует поверхность по центрам вокселей: занятость 0.5 у вокселя [-4, 0]
				-- даёт поверхность ровно на y = 0 (полностью занятый воксель поднял бы газон на 2 студа)
				local vy = y0 + (j - 1) * VOXEL
				local occ = math.clamp((h - vy - VOXEL / 2) / VOXEL, 0, 1)
				mi[j][k] = occ > 0 and mat or M.Air
				oi[j][k] = occ
			end
		end
		materials[i], occupancy[i] = mi, oi
	end
	terrain:WriteVoxels(Region3.new(Vector3.new(x0, y0, z0), Vector3.new(x1, y1, z1)), VOXEL, materials, occupancy)
	-- бассейн: сначала воздух под чашей, потом вода до уровня Surface
	local pool = zone:FindFirstChild("Pool")
	if pool then
		local px0, px1 = pool:GetAttribute("X0"), pool:GetAttribute("X1")
		local pz0, pz1 = pool:GetAttribute("Z0"), pool:GetAttribute("Z1")
		local bottom, surface = pool:GetAttribute("Bottom"), pool:GetAttribute("Surface")
		local center = origin + Vector3.new((px0 + px1) / 2, 0, (pz0 + pz1) / 2)
		-- вырезаем глубоко: полузаполненный воксель под дном поднял бы грунт выше плиток
		terrain:FillBlock(CFrame.new(center + Vector3.new(0, -6, 0)), Vector3.new(px1 - px0 + 2, 12, pz1 - pz0 + 2), M.Air)
		terrain:FillBlock(CFrame.new(center + Vector3.new(0, (bottom + surface) / 2, 0)),
			Vector3.new(px1 - px0, surface - bottom, pz1 - pz0), M.Water)
	end
end
terrain.WaterColor = rgb(40, 118, 140)
terrain.WaterTransparency = 0.6
terrain.WaterReflectance = 0.6
terrain.WaterWaveSize = 0.05
terrain.WaterWaveSpeed = 6
pcall(function()
	terrain:SetMaterialColor(M.Grass, rgb(82, 110, 58))
	terrain:SetMaterialColor(M.LeafyGrass, rgb(70, 98, 52))
end)

-- Детали из Blender. Обычные идут в модель Scenery; особые (метки, свет, таблички, огонь) кладутся прямо в ChillZone
-- под своими именами, их ищет клиент (ConsoleSpot, TVScreen, TrophySlot, GameSlot, StatsBoard, Bulb, GuideArrow…).
local SHAPES = { Enum.PartType.Block, Enum.PartType.Cylinder, Enum.PartType.Ball }
local function color3(c)
	return rgb(c[1], c[2], c[3])
end

local function addLight(p, info)
	local l
	if info.surface then
		l = Instance.new("SurfaceLight")
		l.Face = Enum.NormalId[info.surface]
		l.Angle = info.angle
	else
		l = Instance.new("PointLight")
	end
	l.Color = color3(info.color)
	l.Range = info.range
	l.Brightness = info.brightness
	l.Shadows = info.shadows == true
	if info.flicker then
		l:SetAttribute("Flicker", true)
	end
	l.Parent = p
end

local function buildScenery(data)
	local scenery = Instance.new("Model")
	scenery.Name = "Scenery"
	local built = {}
	for i, row in data.parts do
		local style = data.styles[row[1]]
		local shape = row[2]
		local cf = CFrame.new(row[3], row[4], row[5], row[6], row[7], row[8], row[9], row[10], row[11], row[12], row[13], row[14])
		local size = Vector3.new(row[15], row[16], row[17])
		local p = shape == 4 and Instance.new("WedgePart") or Instance.new("Part")
		if shape == 2 then
			p.Shape = SHAPES[2]
			cf *= CFrame.Angles(0, 0, math.pi / 2)
			size = Vector3.new(size.Y, size.X, size.Z)
		elseif shape == 3 then
			if math.abs(size.X - size.Y) < 0.01 and math.abs(size.X - size.Z) < 0.01 then
				p.Shape = SHAPES[3]
			else
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = p
			end
		end
		local solid = row[18] == 1
		p.Name = style.name
		p.Anchored = true
		p.CanCollide = solid
		p.CanQuery = solid
		p.CanTouch = false
		p.Size = size
		p.CFrame = cf
		p.Color = color3(style.color)
		-- неон в проекте не используем: старые стили из Blender становятся пластиком
		p.Material = style.material == "Neon" and M.SmoothPlastic or M[style.material]
		p.Transparency = style.transparency
		p.CastShadow = style.material ~= "Glass" and size.Magnitude > 1.2
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if (row[19] or 1) > 1 then
			p:SetAttribute("Tier", row[19])
		end
		p.Parent = scenery
		built[i] = p
	end
	for _, info in data.specials or {} do
		local p = built[info.row]
		p.Name = info.name
		if info.hidden then
			p.Transparency = 1
			p.CanCollide = false
			p.CanQuery = false
			p.CastShadow = false
		end
		if info.index then
			p:SetAttribute("Index", info.index)
		end
		for k, v in info.attrs or {} do
			p:SetAttribute(k, v)
		end
		if info.light then
			addLight(p, info.light)
		end
		if info.sign then
			sign(p, Enum.NormalId[info.sign.face], info.sign.text, color3(info.sign.color), 4)
		end
		if info.fire then
			local fire = Instance.new("Fire")
			fire.Size = 6
			fire.Heat = 9
			fire.Color = rgb(255, 140, 50)
			fire.SecondaryColor = rgb(255, 60, 20)
			fire.Parent = p
		end
		p.Parent = zone
	end
	return scenery
end

local okScenery, sceneryData = pcall(function()
	return require(ReplicatedStorage:WaitForChild("PS5"):WaitForChild("Assets"):WaitForChild("ChillZoneParts"))
end)
if okScenery then
	buildScenery(sceneryData).Parent = zone
else
	-- запасной вид: пол, телевизор и место консоли, чтобы PS5 всё равно запускалась
	warn("[PS5] Chill zone scenery missing:", sceneryData)
	part("Floor", Vector3.new(40, 1, 30), Vector3.new(0, 0.5, 0), rgb(150, 104, 70), M.WoodPlanks)
	part("TVScreen", Vector3.new(14, 8, 0.1), Vector3.new(0, 9, -14), rgb(4, 6, 12), M.Glass)
	part("ConsoleSpot", Vector3.one, Vector3.new(-5, 2, -12), nil, nil, { Transparency = 1, CanCollide = false })
	part("SpawnPoint", Vector3.one, Vector3.new(0, 1.5, 8), nil, nil, { Transparency = 1, CanCollide = false })
end

-- Красивые модели из Creator Store (Assets/CreatorStore): меши собираются на сервере,
-- если все детали модели загрузились, её запасные детали из Blender убираются.
local AssetService = game:GetService("AssetService")
local function buildStoreModel(info)
	local model = Instance.new("Model")
	model.Name = info.name
	local pivot = CFrame.new(info.pivot[1], info.pivot[2], info.pivot[3])
	-- меши качаются параллельно: по очереди это несколько секунд, и всё это время игрок ждёт спавна
	local meshes, pending, failure = {}, 0, nil
	for i, d in info.parts do
		if d.class ~= "Seat" then
			pending += 1
			task.spawn(function()
				local ok, result = pcall(function()
					return AssetService:CreateMeshPartAsync(d.mesh, { CollisionFidelity = Enum.CollisionFidelity.Box })
				end)
				if ok and result then
					meshes[i] = result
				else
					failure = failure or result or "no mesh"
				end
				pending -= 1
			end)
		end
	end
	while pending > 0 do
		task.wait()
	end
	if failure then
		for _, m in meshes do
			m:Destroy()
		end
		model:Destroy()
		warn("[PS5] Creator Store model failed, keeping the Blender one:", info.name, failure)
		return nil
	end
	for i, d in info.parts do
		local p
		if d.class == "Seat" then
			p = Instance.new("Seat")
			p.Transparency = 1
			p.CanCollide = false
		else
			p = meshes[i]
			if d.texture ~= "" then
				p.TextureID = d.texture
			end
			p.Color = d.color and color3(d.color) or rgb(163, 162, 165)
			p.CanCollide = d.solid == true
			p.CanQuery = d.solid == true
		end
		p.Name = d.name
		p.Anchored = true
		p.CanTouch = d.class == "Seat"
		p.Size = Vector3.new(d.size[1], d.size[2], d.size[3])
		p.CFrame = pivot * CFrame.new(d.cf[1], d.cf[2], d.cf[3]) * CFrame.Angles(0, math.rad(d.yaw or 0), 0)
		p.Parent = model
	end
	return model
end

local okStore, storeModels = pcall(function()
	return require(ReplicatedStorage.PS5.Assets:WaitForChild("CreatorStore"))
end)
if okStore then
	for _, info in storeModels do
		local model = buildStoreModel(info)
		if model then
			model.Parent = zone
			for _, d in zone:GetChildren() do
				if d.Name == info.fallback then
					d:Destroy()
				end
			end
		end
	end
end

-- Модели из Hunyuan3D (assets/roblox/*.rbxm → ServerStorage.ChillZoneAssets) ставятся на метки AssetSpot из Blender:
-- низ модели по центру на метку, поворот Yaw, масштаб под Size по высоте (Fit = "height") или по длинной стороне.
-- Модели нормализованы при импорте: опора внизу по центру, «перед» смотрит на +Z.
local assetLibrary = game:GetService("ServerStorage"):FindFirstChild("ChillZoneAssets")

local function placeAsset(name, cf, size, fit, tier)
	local source = assetLibrary and assetLibrary:FindFirstChild(name)
	if not source then
		return nil
	end
	local model = source:Clone()
	local _, box = model:GetBoundingBox()
	local current = fit == "length" and math.max(box.X, box.Z) or box.Y
	if size and current > 0 then
		model:ScaleTo(model:GetScale() * size / current)
	end
	model:PivotTo(cf)
	if tier and tier > 1 then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p:SetAttribute("Tier", tier)
			end
		end
	end
	return model
end

local function placeAssets(z)
	local missing = {}
	for _, spot in z:GetChildren() do
		if spot.Name == "AssetSpot" then
			local name = spot:GetAttribute("Asset")
			local cf = CFrame.new(spot.Position) * CFrame.Angles(0, math.rad(spot:GetAttribute("Yaw") or 0), 0)
			local model = placeAsset(name, cf, spot:GetAttribute("Size"), spot:GetAttribute("Fit"), spot:GetAttribute("Tier"))
			if model then
				model.Parent = z
				spot:Destroy()
			else
				missing[name] = true
			end
		end
	end
	local names = {}
	for name in missing do
		table.insert(names, name)
	end
	if #names > 0 then
		table.sort(names)
		warn("[PS5] Chill zone models not imported yet:", table.concat(names, ", "))
	end
end

-- Лес на холмах вокруг участка (свой для каждого участка, живёт вместе с Terrain)
local hillsFolder = Instance.new("Folder")
hillsFolder.Name = "ChillHills"
hillsFolder.Parent = Workspace

local function plantHills(origin, slot)
	local folder = Instance.new("Folder")
	folder.Name = "Hills_" .. slot
	local rng = Random.new(1000 + slot)
	local kinds = { "Pine", "Pine", "ShadeTree" }
	local placed = {}
	for _ = 1, 260 do
		if #placed >= 70 then
			break
		end
		local x = rng:NextNumber(-HILL_X + 20, HILL_X - 20)
		local z = rng:NextNumber(HILL_Z0 + 20, HILL_Z1 - 20)
		local h = groundHeight(x, z)
		local far = h > 4
		local free = true
		for _, p in placed do
			if (p - Vector3.new(x, 0, z)).Magnitude < 16 then
				free = false
				break
			end
		end
		if far and free then
			local kind = kinds[rng:NextInteger(1, #kinds)]
			local size = (kind == "Pine" and 24 or 20) * rng:NextNumber(0.8, 1.25)
			local cf = CFrame.new(origin + Vector3.new(x, h - 0.8, z)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
			local tree = placeAsset(kind, cf, size, "height")
			if tree then
				tree.Parent = folder
				table.insert(placed, Vector3.new(x, 0, z))
			end
		end
	end
	folder.Parent = hillsFolder
end

placeAssets(zone)

-- Точка появления из Blender: у калитки, лицом к дому
local spawnPoint = zone:FindFirstChild("SpawnPoint")
local spawn = Instance.new("SpawnLocation")
spawn.Name = "Spawn"
spawn.Anchored = true
spawn.Size = Vector3.new(6, 1, 6)
spawn.CFrame = CFrame.lookAt(spawnPoint.Position, spawnPoint.Position - Vector3.new(0, 0, 1))
spawn.Transparency = 1
spawn.CanCollide = false
spawn.Neutral = true
spawn.Duration = 0
spawn.Parent = zone

-- Шаблон готов: каждая чиллзона игрока — его копия на своём участке
zone.WorldPivot = CFrame.new()

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local PLOT_SPACING = 520
local zonesFolder = Instance.new("Folder")
zonesFolder.Name = "ChillZones"
zonesFolder.Parent = Workspace
local hiddenRoot = Instance.new("Folder")
hiddenRoot.Name = "ChillZoneTiers"
hiddenRoot.Parent = ServerStorage

local remotes = ReplicatedStorage:WaitForChild("PS5Remotes")
local visitRemote = Instance.new("RemoteEvent")
visitRemote.Name = "VisitZone"
visitRemote.Parent = remotes

local slots = {} -- номер участка -> userId
local terrainReady = {}
local zones = {} -- userId -> { zone, slot, hidden, parts, tier }
local lastVisit = {}

-- участки по очереди справа и слева от первого: 0, +1, -1, +2, -2…
local function slotOrigin(slot)
	local k = slot % 2 == 1 and (slot + 1) / 2 or -slot / 2
	return Vector3.new(k * PLOT_SPACING, 0, 0)
end

-- показать детали своего уровня и спрятать те, что выше (очки могут и уменьшиться, если удалить игру)
local function applyTier(state, level, animate)
	state.tier = level
	state.zone:SetAttribute("Tier", level)
	for p, info in state.parts do
		local show = info.tier <= level
		if show and p.Parent == state.hidden then
			p.Parent = info.home
			if animate then
				p.Transparency = 1
				TweenService:Create(p, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = info.transparency }):Play()
			end
		elseif not show and p.Parent ~= state.hidden then
			p.Parent = state.hidden
		end
	end
end

local function setOwnerSign(z, player)
	local signPart = z:FindFirstChild("ChillSign")
	local gui = signPart and signPart:FindFirstChildOfClass("SurfaceGui")
	local label = gui and gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.Text = string.upper(player.DisplayName) .. "'S CHILL ZONE"
	end
end

local function spawnCFrame(state)
	return state.zone.Spawn.CFrame * CFrame.new(0, 3, 0)
end

local function sendTo(player, state)
	local character = player.Character
	if character and state then
		character:PivotTo(spawnCFrame(state))
	end
end

local function createZone(player)
	if zones[player.UserId] then
		return zones[player.UserId]
	end
	local slot = 0
	while slots[slot] do
		slot += 1
	end
	slots[slot] = player.UserId
	local origin = slotOrigin(slot)
	if not terrainReady[slot] then
		terrainReady[slot] = true
		fillTerrain(origin)
		plantHills(origin, slot)
	end
	local z = zone:Clone()
	z.Name = "Zone_" .. player.UserId
	z:SetAttribute("OwnerId", player.UserId)
	z:SetAttribute("OwnerName", player.DisplayName)
	z:SetAttribute("Origin", origin)
	z:PivotTo(CFrame.new(origin))
	local hidden = Instance.new("Folder")
	hidden.Name = z.Name
	hidden.Parent = hiddenRoot
	local state = { zone = z, slot = slot, hidden = hidden, parts = {}, tier = 1 }
	for _, p in z:GetDescendants() do
		local level = p:IsA("BasePart") and p:GetAttribute("Tier")
		if level then
			state.parts[p] = { tier = level, home = p.Parent, transparency = p.Transparency }
		end
	end
	setOwnerSign(z, player)
	applyTier(state, player:GetAttribute("PS5Tier") or 1, false)
	z.Parent = zonesFolder
	zones[player.UserId] = state
	player.RespawnLocation = z.Spawn
	sendTo(player, state)
	player:GetAttributeChangedSignal("PS5Tier"):Connect(function()
		local level = player:GetAttribute("PS5Tier") or 1
		if zones[player.UserId] == state and level ~= state.tier then
			applyTier(state, level, level > state.tier)
		end
	end)
	player.CharacterAdded:Connect(function()
		player:SetAttribute("VisitingZone", nil)
	end)
	return state
end

local function onPlayerAdded(player)
	-- автоспавн выключен, поэтому возрождение после смерти тоже на нас
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid").Died:Once(function()
			task.wait(Players.RespawnTime)
			if player.Parent and player.Character == character then
				player:LoadCharacter()
			end
		end)
	end)
	local ok, err = pcall(createZone, player)
	if not ok then
		warn("[PS5] Chill zone failed for", player.Name, err)
	end
	if player.Parent and not player.Character then
		player:LoadCharacter()
	end
end

local function removeZone(player)
	local state = zones[player.UserId]
	if not state then
		return
	end
	zones[player.UserId] = nil
	slots[state.slot] = nil
	-- гости этой чиллзоны возвращаются к себе
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("VisitingZone") == player.UserId then
			other:SetAttribute("VisitingZone", nil)
			sendTo(other, zones[other.UserId])
		end
	end
	state.zone:Destroy()
	state.hidden:Destroy()
end

-- в гости: VisitZone(userId) — к другому игроку, VisitZone() — домой
visitRemote.OnServerEvent:Connect(function(player, targetUserId)
	local now = os.clock()
	if lastVisit[player] and now - lastVisit[player] < 1.5 then
		return
	end
	lastVisit[player] = now
	local own = zones[player.UserId]
	local target = typeof(targetUserId) == "number" and zones[targetUserId] or own
	if not target then
		return
	end
	player:SetAttribute("VisitingZone", target ~= own and targetUserId or nil)
	sendTo(player, target)
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	removeZone(player)
	lastVisit[player] = nil
end)
for _, plr in Players:GetPlayers() do
	task.spawn(onPlayerAdded, plr)
end

-- Тёплый вечер: солнце только что село, небо ещё светлое, во дворе горят обычные тёплые лампы
Lighting.ClockTime = 17.88
Lighting.GeographicLatitude = 25
Lighting.Brightness = 1.8
Lighting.Ambient = rgb(46, 44, 52)
Lighting.OutdoorAmbient = rgb(128, 118, 120)
Lighting.EnvironmentDiffuseScale = 0.55
Lighting.EnvironmentSpecularScale = 0.7
Lighting.ShadowSoftness = 0.25
Lighting.ExposureCompensation = 0.15
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
atmosphere.Density = 0.3
atmosphere.Offset = 0.15
atmosphere.Color = rgb(236, 196, 168)
atmosphere.Decay = rgb(186, 116, 98) -- тёплый закатный горизонт (с холодным небо в сумерках зеленело)
atmosphere.Glare = 0.4
atmosphere.Haze = 1.2
atmosphere.Parent = Lighting
-- Без Bloom/SunRays/цветокоррекции: со свечением мир и игры пересвечивались
for _, e in Lighting:GetChildren() do
	if e:IsA("BloomEffect") or e:IsA("SunRaysEffect") or e:IsA("ColorCorrectionEffect") then
		e:Destroy()
	end
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="107">
      <Properties>
        <string name="Name">PS5Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Сервер данных PS5: хранит профиль каждого игрока (пользователи, настройки,
-- сохранения игр, трофеи) в DataStore. В Studio без доступа к API работает в памяти.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local STORE_NAME = "PS5Sandbox_v1"
local AUTOSAVE_SECONDS = 60
local MAX_BYTES = 3_500_000
local ROOTS = { settings = true, users = true, data = true }

-- персонажей спавнит ChillZone.server, когда участок игрока готов (иначе он падает в пустоту)
Players.CharacterAutoLoads = false

local remotes = Instance.new("Folder")
remotes.Name = "PS5Remotes"
local getProfile = Instance.new("RemoteFunction")
getProfile.Name = "GetProfile"
getProfile.Parent = remotes
local mutate = Instance.new("RemoteEvent")
mutate.Name = "Mutate"
mutate.Parent = remotes
local getPublicProfile = Instance.new("RemoteFunction")
getPublicProfile.Name = "GetPublicProfile"
getPublicProfile.Parent = remotes
remotes.Parent = ReplicatedStorage

local Progress = require(ReplicatedStorage:WaitForChild("PS5"):WaitForChild("Progress"))

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[PS5] DataStore unavailable (enable Studio Access to API Services). Data is kept in memory only.")
	end
end

local profiles = {} -- player -> { data, dirty, loaded }

local function key(player)
	return "player_" .. player.UserId
end

local function defaultProfile(player)
	return {
		version = 1,
		settings = {},
		users = { { id = "u1", name = player.DisplayName, color = "#2D7CF6" } },
		data = {},
	}
end

local publish -- публичный профиль, ниже

local function load(player)
	local entry = { data = nil, dirty = false, loaded = false }
	profiles[player] = entry
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				entry.data = result
				break
			end
			warn(`[PS5] Load failed ({attempt}/3): {result}`)
			task.wait(attempt)
		end
	end
	entry.data = type(entry.data) == "table" and entry.data or defaultProfile(player)
	entry.loaded = true
	publish(player)
	return entry
end

local function save(player)
	local entry = profiles[player]
	if not (store and entry and entry.loaded and entry.dirty) then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync(key(player), entry.data, { player.UserId })
	end)
	if ok then
		entry.dirty = false
	else
		warn("[PS5] Save failed:", err)
	end
end

-- Публичный профиль: трофеи, награды и игры. Его видят другие игроки (профиль по наведению, витрина
-- в чужой чиллзоне), а уровень чиллзоны (атрибут PS5Tier) читает сервер чиллзоны.
local manifests
local function appManifests()
	if manifests then
		return manifests
	end
	manifests = {}
	local folder = ReplicatedStorage:WaitForChild("PS5Apps")
	for _, module in folder:GetChildren() do
		local m = module:FindFirstChild("manifest")
		if m then
			local ok, manifest = pcall(require, m)
			if ok and type(manifest) == "table" and type(manifest.id) == "string" and not manifest.hidden then
				table.insert(manifests, manifest)
			end
		end
	end
	return manifests
end

function publish(player)
	local entry = profiles[player]
	if not (entry and entry.loaded) then
		return
	end
	local summary = Progress.Summarize(entry.data, appManifests())
	summary.userId = player.UserId
	summary.name = player.Name
	summary.displayName = player.DisplayName
	entry.summary = summary
	player:SetAttribute("PS5Points", summary.points)
	player:SetAttribute("PS5Trophies", summary.trophies.got)
	player:SetAttribute("PS5Games", summary.gamesOwned)
	player:SetAttribute("PS5Tier", summary.tier)
	player:SetAttribute("PS5ProfileVersion", (player:GetAttribute("PS5ProfileVersion") or 0) + 1)
end

local function schedulePublish(player)
	local entry = profiles[player]
	if not entry or entry.publishQueued then
		return
	end
	entry.publishQueued = true
	task.delay(1, function()
		entry.publishQueued = false
		if profiles[player] == entry then
			publish(player)
		end
	end)
end

getPublicProfile.OnServerInvoke = function(_, userId)
	local target = typeof(userId) == "number" and Players:GetPlayerByUserId(userId)
	local entry = target and profiles[target]
	if not entry then
		return nil
	end
	while not entry.loaded do
		task.wait(0.1)
	end
	if not entry.summary then
		publish(target)
	end
	return entry.summary
end

local function validPath(path)
	if type(path) ~= "table" or #path < 1 or #path > 8 or not ROOTS[path[1]] then
		return false
	end
	for _, part in path do
		if type(part) ~= "string" or #part == 0 or #part > 64 then
			return false
		end
	end
	return true
end

getProfile.OnServerInvoke = function(player)
	local entry = profiles[player]
	while entry and not entry.loaded do
		task.wait(0.1)
	end
	return entry and entry.data
end

mutate.OnServerEvent:Connect(function(player, path, value)
	local entry = profiles[player]
	if not (entry and entry.loaded and validPath(path)) then
		return
	end
	local okEncode = pcall(HttpService.JSONEncode, HttpService, { v = value })
	if not okEncode then
		return
	end
	local node = entry.data
	for i = 1, #path - 1 do
		if type(node[path[i]]) ~= "table" then
			node[path[i]] = {}
		end
		node = node[path[i]]
	end
	local previous = node[path[#path]]
	node[path[#path]] = value
	if #HttpService:JSONEncode(entry.data) > MAX_BYTES then
		node[path[#path]] = previous
		warn("[PS5] Profile size limit exceeded, change rejected")
		return
	end
	entry.dirty = true
	schedulePublish(player)
end)

Players.PlayerAdded:Connect(load)
for _, player in Players:GetPlayers() do
	task.spawn(load, player)
end

Players.PlayerRemoving:Connect(function(player)
	save(player)
	profiles[player] = nil
end)

game:BindToClose(function()
	for player in profiles do
		task.spawn(save, player)
	end
	task.wait(2)
end)

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_SECONDS)
		for player in profiles do
			task.spawn(save, player)
		end
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
