        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">cover</string>
            <string name="Source"><![CDATA[-- Сгенерировано blender/export_luau.py из assets/renders/orbit_strike_cover.png. Не редактировать вручную.
-- Cover orbit_strike: RGB 192×192 в base64, собирается в EditableImage.
