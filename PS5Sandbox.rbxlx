        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест Pixel Quest: читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "pixel_quest",
	title = "Pixel Quest",
	category = "game",
	genre = "Platformer",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 3,
	description = "A cosy pixel platformer with coins, secrets and a boss at the end.",
	icon = "🍄",
	cover = "cover",
	art = "art", -- фон главного экрана (blender/game_art.py)
	colors = { "#43AA8B", "#0B3D2E" },
	controls = {
		{ "Stick / arrows / A D", "Move" },
		{ "✕ / Space / W / ↑", "Jump (hold to jump higher)" },
		{ "□ / F (hold)", "Run" },
		{ "OPTIONS / O", "Pause" },
		{ "PS / H", "Control Center" },
	},
	trophies = {
		{ id = "first_clear", name = "First Steps", description = "Clear Green Meadow", grade = "bronze" },
		{ id = "coins_100", name = "Pocket Money", description = "Collect 100 coins in total", grade = "bronze" },
		{ id = "stomp_30", name = "Slime Squasher", description = "Stomp 30 enemies", grade = "bronze" },
		{ id = "secret_gem", name = "Secret Keeper", description = "Find a hidden gem", grade = "silver", hidden = true },
		{ id = "no_damage", name = "Not a Scratch", description = "Clear a level without taking damage", grade = "silver" },
		{ id = "all_gems", name = "Treasure Hunter", description = "Find all three hidden gems", grade = "gold" },
		{ id = "boss", name = "Crown Breaker", description = "Defeat the Moss King", grade = "gold" },
		{ id = "platinum", name = "Pixel Legend", description = "Earn every Pixel Quest trophy", grade = "platinum" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">Pong</string>
          <string name="Source"><![CDATA[-- Пинг-понг против компьютера: игрок слева, до 7 очков.
local Pong = {}

local FW, FH, PW, PH, BALL = 1400, 800, 22, 150, 24
local TARGET = 7

function Pong.launch(ctx)
	local ui = ctx.ui
	local canvas = ui.canvas(ctx.gui)
	ctx.gui.BackgroundColor3 = Color3.fromRGB(14, 4, 26)
	local field = ui.new("Frame", {
		Size = UDim2.fromOffset(FW, FH), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(960, 580),
		BackgroundColor3 = Color3.fromRGB(28, 10, 50), Parent = canvas,
	}, { ui.corner(20), ui.stroke(Color3.fromRGB(247, 37, 133), 2, 0.4) })
	ui.new("Frame", { Size = UDim2.fromOffset(4, FH - 40), Position = UDim2.fromOffset(FW / 2 - 2, 20), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.8, Parent = field })
	local function paddle(color)
		return ui.new("Frame", { Size = UDim2.fromOffset(PW, PH), BackgroundColor3 = color, Parent = field }, { ui.corner(8) })
	end
	local left, right = paddle(Color3.fromRGB(80, 200, 255)), paddle(Color3.fromRGB(247, 37, 133))
	local ballFrame = ui.new("Frame", { Size = UDim2.fromOffset(BALL, BALL), BackgroundColor3 = Color3.new(1, 1, 1), Parent = field }, { ui.corner(UDim.new(0.5, 0)) })
	local scoreLabel = ui.text("", { Size = UDim2.fromOffset(1920, 80), Position = UDim2.fromOffset(0, 70), TextSize = 72, Font = ctx.theme.FontHeavy, TextXAlignment = Enum.TextXAlignment.Center, Parent = canvas })
	local message = ui.text("", { Size = UDim2.fromOffset(1920, 140), Position = UDim2.fromOffset(0, 510), TextSize = 46, Font = ctx.theme.FontHeavy, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.3, Parent = canvas })

	local ly, ry, ball, vel, you, cpu, state

	local function serve(towardsPlayer)
		ball = Vector2.new(FW / 2, FH / 2)
		local angle = math.rad(math.random(-30, 30))
		vel = Vector2.new(math.cos(angle) * (towardsPlayer and -1 or 1), math.sin(angle)) * 620
		state = "serve"
		message.Text = `{ctx.input:Glyph("cross")} serve`
	end

	local function newMatch()
		ly, ry, you, cpu = FH / 2, FH / 2, 0, 0
		serve(false)
	end

	local function draw()
		left.Position = UDim2.fromOffset(30, ly - PH / 2)
		right.Position = UDim2.fromOffset(FW - 30 - PW, ry - PH / 2)
		ballFrame.Position = UDim2.fromOffset(ball.X - BALL / 2, ball.Y - BALL / 2)
		scoreLabel.Text = `{you}   :   {cpu}`
	end

	local function point(playerScored)
		if playerScored then
			you += 1
			ctx.trophies:Unlock("first_point")
			ctx.audio:Play("confirm")
		else
			cpu += 1
			ctx.audio:Play("hit")
		end
		if you >= TARGET or cpu >= TARGET then
			state = "over"
			local won = you >= TARGET
			if won then
				ctx.trophies:Unlock("win")
				if cpu == 0 then
					ctx.trophies:Unlock("shutout")
				end
				ctx.save:Set("wins", ctx.save:Get("wins", 0) + 1)
				ctx.save:Set("best", math.max(ctx.save:Get("best", 0), you - cpu))
			end
			message.Text = `{won and "You win! 🏆" or "Computer wins"}\n{ctx.input:Glyph("cross")} new match   {ctx.input:Glyph("circle")} quit`
		else
			serve(not playerScored)
		end
	end

	ctx.input:On("press", function(btn)
		if btn == "cross" then
			if state == "serve" then
				state = "play"
				message.Text = ""
			elseif state == "over" then
				newMatch()
			end
		elseif btn == "circle" then
			ctx:Exit()
		end
	end)

	ctx:Loop(function(dt)
		local axis = ctx.input:GetAxes().ly
		if ctx.input:IsDown("up") then
			axis = 1
		elseif ctx.input:IsDown("down") then
			axis = -1
		end
		ly = math.clamp(ly - axis * 900 * dt, PH / 2, FH - PH / 2)
		if state == "play" then
			-- компьютер догоняет мяч с ограниченной скоростью, чтобы его можно было обыграть
			local target = vel.X > 0 and ball.Y or FH / 2
			ry += math.clamp(target - ry, -520 * dt, 520 * dt)
			ry = math.clamp(ry, PH / 2, FH - PH / 2)
			ball += vel * dt
			if ball.Y < BALL / 2 or ball.Y > FH - BALL / 2 then
				vel = Vector2.new(vel.X, -vel.Y)
				ball = Vector2.new(ball.X, math.clamp(ball.Y, BALL / 2, FH - BALL / 2))
			end
			local function bounce(py, x, dirSign)
				if math.abs(ball.Y - py) <= PH / 2 + BALL / 2 then
					local offset = (ball.Y - py) / (PH / 2)
					local speed = math.min(vel.Magnitude * 1.06, 1500)
					vel = Vector2.new(dirSign * math.cos(offset * 0.9), math.sin(offset * 0.9)).Unit * speed
					ball = Vector2.new(x, ball.Y)
					ctx.audio:Play("move", { pitch = 1.3 })
				end
			end
			if vel.X < 0 and ball.X <= 30 + PW + BALL / 2 and ball.X > 20 then
				bounce(ly, 30 + PW + BALL / 2, 1)
			elseif vel.X > 0 and ball.X >= FW - 30 - PW - BALL / 2 and ball.X < FW - 20 then
				bounce(ry, FW - 30 - PW - BALL / 2, -1)
			end
			if ball.X < 0 then
				point(false)
			elseif ball.X > FW then
				point(true)
			end
		end
		draw()
	end)

	newMatch()
	draw()
end

return Pong
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "pong",
	title = "Pong",
	category = "game",
	genre = "Classic",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 11,
	description = "Paddle duel against the computer. First to 7 points wins.",
	icon = "🏓",
	cover = "",
	art = "",
	colors = { "#F72585", "#1B0033" },
	controls = {
		{ "Stick / ↑↓ / W S", "Move paddle" },
		{ "✕ / Enter", "Serve / start again" },
		{ "○", "Quit" },
	},
	trophies = {
		{ id = "first_point", name = "On the Board", description = "Score a point", grade = "bronze" },
		{ id = "win", name = "Champion", description = "Win a match", grade = "silver" },
		{ id = "shutout", name = "Untouchable", description = "Win a match 7–0", grade = "gold" },
		{ id = "platinum", name = "Table Legend", description = "Earn every Pong trophy", grade = "platinum" },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">RocketBall</string>
          <string name="Source"><![CDATA[-- Rocket Ball — футбол на машинах 1 на 1 против бота. 3D-стадион в ctx.world, HUD в ctx.gui.
-- Физика своя (анкерные детали, ручной расчёт), поэтому игра одинаково ведёт себя в Studio и в дымовом тесте.
local Game = {}

-- Стадион стоит далеко от чиллзоны, чтобы её не было видно
local OX, OY, OZ = 0, 600, 3200

-- Поле: x от -FIELD_X до FIELD_X, z от -FIELD_Z до FIELD_Z. Синие защищают ворота на -z, оранжевые на +z.
local FIELD_X, FIELD_Z = 50, 80
local CEILING = 34
local GOAL_W, GOAL_H, GOAL_D = 16, 14, 12 -- полуширина, высота, глубина ворот
local BALL_R = 4

-- Машина: x, y — центр днища; передом смотрит в локальную -Z (как LookVector в Roblox)
local CAR_HX, CAR_HY, CAR_HZ = 2.6, 1.9, 4.4 -- полуразмеры корпуса для ударов по мячу
local CAR_R = 3.6 -- радиус для столкновений со стенами
local ACCEL, BRAKE, MAX_SPEED, MAX_REVERSE = 55, 110, 62, 30
local BOOST_ACCEL, MAX_BOOST_SPEED, BOOST_USE = 80, 100, 34
local TURN_RATE, AIR_TURN, GRIP = 2.7, 2.2, 7
local GRAVITY, JUMP_SPEED, DODGE_SPEED = 70, 30, 36
local BALL_GRAVITY, BALL_MAX_SPEED = 42, 115

local BLUE = Color3.fromRGB(0, 180, 216)
local ORANGE = Color3.fromRGB(255, 140, 40)

local DIFFICULTIES = {
	{ name = "Rookie", throttle = 0.72, react = 0.45, predict = 0.4, boost = 0.25, jump = 0.15, aim = 9 },
	{ name = "Pro", throttle = 0.88, react = 0.25, predict = 0.8, boost = 0.6, jump = 0.5, aim = 5 },
	{ name = "All-Star", throttle = 1, react = 0.1, predict = 1, boost = 1, jump = 0.9, aim = 2 },
}
local LENGTHS = { 120, 180, 300 }

local function wrapAngle(a)
	return (a + math.pi) % (2 * math.pi) - math.pi
end

local function at(x, y, z)
	return CFrame.new(OX + x, OY + y, OZ + z)
end

local function vec(x, y, z)
	return Vector3.new(OX + x, OY + y, OZ + z)
end

function Game.launch(ctx)
	local ui = ctx.ui
	local world = ctx.world
	local manifest = ctx.manifest

	---------------------------------------------------------------- стадион
	local function part(props)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Material = Enum.Material.SmoothPlastic
		for k, v in props do
			p[k] = v
		end
		p.Parent = props.Parent or world
		return p
	end

	local arena = Instance.new("Folder")
	arena.Name = "Arena"
	arena.Parent = world

	-- Земля вокруг и полосатый газон
	part({ Name = "Ground", Size = Vector3.new(420, 2, 520), CFrame = at(0, -1.6, 0), Color = Color3.fromRGB(14, 18, 32), Parent = arena })
	local STRIPES = 10
	for i = 0, STRIPES - 1 do
		local len = FIELD_Z * 2 / STRIPES
		part({
			Name = "Grass",
			Size = Vector3.new(FIELD_X * 2, 1, len),
			CFrame = at(0, -0.5, -FIELD_Z + len * (i + 0.5)),
			Material = Enum.Material.Grass,
			Color = i % 2 == 0 and Color3.fromRGB(46, 140, 72) or Color3.fromRGB(38, 122, 62),
			Parent = arena,
		})
	end

	-- Разметка
	local LINE = Color3.fromRGB(235, 245, 255)
	local function line(x, z, sx, sz)
		part({ Name = "Line", Size = Vector3.new(sx, 0.1, sz), CFrame = at(x, 0.02, z), Material = Enum.Material.SmoothPlastic, Color = LINE, Transparency = 0.25, Parent = arena })
	end
	line(0, 0, FIELD_X * 2, 0.6)
	line(-FIELD_X + 0.6, 0, 0.6, FIELD_Z * 2)
	line(FIELD_X - 0.6, 0, 0.6, FIELD_Z * 2)
	for _, s in { -1, 1 } do
		line(0, s * (FIELD_Z - 0.6), FIELD_X * 2, 0.6)
		line(0, s * (FIELD_Z - 18), 48, 0.6)
		line(-24, s * (FIELD_Z - 9), 0.6, 18)
		line(24, s * (FIELD_Z - 9), 0.6, 18)
	end
	for i = 1, 36 do
		local a = i / 36 * math.pi * 2
		part({
			Name = "Circle", Size = Vector3.new(0.6, 0.1, 2.9),
			CFrame = at(math.cos(a) * 14, 0.02, math.sin(a) * 14) * CFrame.Angles(0, -a, 0),
			Material = Enum.Material.SmoothPlastic, Color = LINE, Transparency = 0.25, Parent = arena,
		})
	end

	-- Стены из стекла с неоновой кромкой цвета команды
	local GLASS = Color3.fromRGB(150, 210, 255)
	local function wall(x, y, z, sx, sy, sz)
		part({ Name = "Wall", Size = Vector3.new(sx, sy, sz), CFrame = at(x, y, z), Material = Enum.Material.Glass, Color = GLASS, Transparency = 0.82, Parent = arena })
	end
	local function rail(x, y, z, sx, sz, color)
		part({ Name = "Rail", Size = Vector3.new(sx, 0.6, sz), CFrame = at(x, y, z), Material = Enum.Material.SmoothPlastic, Color = color, Parent = arena })
	end
	for _, s in { -1, 1 } do
		wall(s * (FIELD_X + 0.5), CEILING / 2, 0, 1, CEILING, FIELD_Z * 2)
		rail(s * (FIELD_X + 0.5), CEILING, -FIELD_Z / 2, 1.2, FIELD_Z, BLUE)
		rail(s * (FIELD_X + 0.5), CEILING, FIELD_Z / 2, 1.2, FIELD_Z, ORANGE)
		rail(s * (FIELD_X + 0.5), 0.3, -FIELD_Z / 2, 1.2, FIELD_Z, BLUE)
		rail(s * (FIELD_X + 0.5), 0.3, FIELD_Z / 2, 1.2, FIELD_Z, ORANGE)
		local color = s < 0 and BLUE or ORANGE
		local side = (FIELD_X - GOAL_W) / 2
		wall(-FIELD_X + side, CEILING / 2, s * (FIELD_Z + 0.5), side * 2, CEILING, 1)
		wall(FIELD_X - side, CEILING / 2, s * (FIELD_Z + 0.5), side * 2, CEILING, 1)
		wall(0, (CEILING + GOAL_H) / 2, s * (FIELD_Z + 0.5), GOAL_W * 2, CEILING - GOAL_H, 1)
		rail(0, CEILING, s * (FIELD_Z + 0.5), FIELD_X * 2, 1.2, color)

		-- Ворота: неоновая рамка, сетка из силового поля, тёмный пол
		local zFront, zBack = s * FIELD_Z, s * (FIELD_Z + GOAL_D)
		local zMid = (zFront + zBack) / 2
		for _, px in { -GOAL_W, GOAL_W } do
			part({ Name = "Post", Size = Vector3.new(1, GOAL_H, 1), CFrame = at(px, GOAL_H / 2, zFront), Material = Enum.Material.SmoothPlastic, Color = color, Parent = arena })
			part({ Name = "Net", Size = Vector3.new(0.4, GOAL_H, GOAL_D), CFrame = at(px, GOAL_H / 2, zMid), Material = Enum.Material.ForceField, Color = color, Parent = arena })
		end
		part({ Name = "Crossbar", Size = Vector3.new(GOAL_W * 2 + 1, 1, 1), CFrame = at(0, GOAL_H, zFront), Material = Enum.Material.SmoothPlastic, Color = color, Parent = arena })
		part({ Name = "Net", Size = Vector3.new(GOAL_W * 2, GOAL_H, 0.4), CFrame = at(0, GOAL_H / 2, zBack), Material = Enum.Material.ForceField, Color = color, Parent = arena })
		part({ Name = "Net", Size = Vector3.new(GOAL_W * 2, 0.4, GOAL_D), CFrame = at(0, GOAL_H, zMid), Material = Enum.Material.ForceField, Color = color, Parent = arena })
		part({ Name = "GoalFloor", Size = Vector3.new(GOAL_W * 2, 1, GOAL_D), CFrame = at(0, -0.5, zMid), Color = color:Lerp(Color3.new(0, 0, 0), 0.6), Parent = arena })
		local glow = part({ Name = "GoalGlow", Size = Vector3.new(GOAL_W * 2, 0.1, 1.2), CFrame = at(0, 0.03, zFront), Material = Enum.Material.SmoothPlastic, Color = color, Parent = arena })
		glow.Transparency = 0.1
	end

	-- Трибуны со зрителями и мачты освещения
	local CROWD = { Color3.fromRGB(0, 180, 216), Color3.fromRGB(255, 140, 40), Color3.fromRGB(240, 240, 250), Color3.fromRGB(255, 214, 10), Color3.fromRGB(120, 90, 220) }
	for _, s in { -1, 1 } do
		for tier = 1, 4 do
			local x = s * (FIELD_X + 6 + tier * 6)
			part({ Name = "Stand", Size = Vector3.new(6, tier * 4, FIELD_Z * 2 + 20), CFrame = at(x, tier * 2, 0), Color = Color3.fromRGB(28, 34, 58), Parent = arena })
			for _ = 1, 14 do
				part({
					Name = "Fan", Size = Vector3.new(1.4, 2.2, 1.4),
					CFrame = at(x + (math.random() - 0.5) * 3, tier * 4 + 1.1, (math.random() - 0.5) * (FIELD_Z * 2 + 10)),
					Color = CROWD[math.random(#CROWD)], Parent = arena,
				})
			end
		end
		for _, z in { -FIELD_Z - 6, FIELD_Z + 6 } do
			local x = s * (FIELD_X + 40)
			part({ Name = "Mast", Size = Vector3.new(1.5, 60, 1.5), CFrame = at(x, 30, z), Color = Color3.fromRGB(60, 66, 90), Parent = arena })
			local lamp = part({ Name = "Lamp", Size = Vector3.new(10, 5, 1), CFrame = CFrame.lookAt(vec(x, 60, z), vec(0, 0, 0)), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(255, 250, 230), Parent = arena })
			local spot = Instance.new("SpotLight")
			spot.Range = 60
			spot.Angle = 70
			spot.Brightness = 3
			spot.Parent = lamp
		end
	end
	-- Свет над полем
	for _, z in { -55, 0, 55 } do
		for _, x in { -25, 25 } do
			local holder = part({ Name = "FieldLight", Size = Vector3.new(1, 1, 1), CFrame = at(x, CEILING + 6, z), Transparency = 1, Parent = arena })
			local light = Instance.new("PointLight")
			light.Range = 60
			light.Brightness = 1.6
			light.Color = Color3.fromRGB(235, 240, 255)
			light.Parent = holder
		end
	end

	---------------------------------------------------------------- подборы буста
	local pads = {}
	local function addPad(x, z, big)
		local p = part({
			Name = big and "BigBoost" or "Boost",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, big and 6 or 3.4, big and 6 or 3.4),
			CFrame = at(x, 0.1, z) * CFrame.Angles(0, 0, math.pi / 2),
			Material = Enum.Material.SmoothPlastic,
			Color = Color3.fromRGB(255, 196, 40),
			Parent = arena,
		})
		local orb
		if big then
			orb = part({ Name = "BoostOrb", Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 2.6, 2.6), CFrame = at(x, 2.5, z), Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(255, 160, 20), Parent = arena })
		end
		table.insert(pads, { x = x, z = z, big = big, timer = 0, part = p, orb = orb })
	end
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			addPad(sx * 42, sz * 70, true)
			addPad(sx * 24, sz * 30, false)
			addPad(sx * 34, sz * 52, false)
			addPad(sx * 8, sz * 62, false)
		end
		addPad(sx * 44, 0, true)
		addPad(sx * 18, 0, false)
		addPad(0, sx * 44, false)
	end

	---------------------------------------------------------------- мяч
	local ballPart = part({
		Name = "Ball", Shape = Enum.PartType.Ball, Size = Vector3.new(BALL_R * 2, BALL_R * 2, BALL_R * 2),
		Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(240, 244, 255),
	})
	local ballRing = part({
		Name = "BallRing", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, BALL_R * 2 + 0.1, BALL_R * 2 + 0.1), -- светящийся пояс вокруг мяча
		Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(0, 220, 255),
	})
	local ballLight = Instance.new("PointLight")
	ballLight.Range = 14
	ballLight.Brightness = 1
	ballLight.Color = Color3.fromRGB(150, 230, 255)
	ballLight.Parent = ballPart
	local shadow = part({
		Name = "BallShadow", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, BALL_R * 2, BALL_R * 2),
		Color = Color3.new(0, 0, 0), Transparency = 0.5,
	})
	local ball = { x = 0, y = BALL_R, z = 0, vx = 0, vy = 0, vz = 0, spin = CFrame.new() }

	---------------------------------------------------------------- машины
	local function newCar(team, color)
		local dark = color:Lerp(Color3.new(0, 0, 0), 0.45)
		local car = { team = team, color = color, parts = {}, boost = 33, x = 0, y = 0, z = 0, vx = 0, vy = 0, vz = 0, yaw = 0 }
		local function piece(name, size, offset, props)
			local p = part({ Name = name, Size = size, Color = props.Color or color, Material = props.Material or Enum.Material.SmoothPlastic, Shape = props.Shape or Enum.PartType.Block })
			table.insert(car.parts, { part = p, offset = offset })
			return p
		end
		piece("Body", Vector3.new(5, 1.5, 8.4), CFrame.new(0, 1.45, 0), {})
		piece("Nose", Vector3.new(4.6, 0.8, 2), CFrame.new(0, 1.0, -4.6), { Color = dark })
		piece("Cabin", Vector3.new(4, 1.3, 3.8), CFrame.new(0, 2.85, 0.9), { Color = Color3.fromRGB(20, 26, 40), Material = Enum.Material.Glass })
		piece("Stripe", Vector3.new(1, 0.1, 8.5), CFrame.new(0, 2.22, 0), { Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic })
		piece("Spoiler", Vector3.new(5.2, 0.3, 1.3), CFrame.new(0, 3.1, 3.7), { Color = dark })
		piece("SpoilerPost", Vector3.new(0.3, 0.9, 0.5), CFrame.new(-1.8, 2.5, 3.7), { Color = dark })
		piece("SpoilerPost", Vector3.new(0.3, 0.9, 0.5), CFrame.new(1.8, 2.5, 3.7), { Color = dark })
		for _, hx in { -1.6, 1.6 } do
			piece("Headlight", Vector3.new(0.9, 0.4, 0.2), CFrame.new(hx, 1.6, -4.25), { Color = Color3.fromRGB(255, 250, 220), Material = Enum.Material.SmoothPlastic })
		end
		for _, wx in { -2.6, 2.6 } do
			for _, wz in { -2.9, 2.9 } do
				piece("Wheel", Vector3.new(1.1, 2.2, 2.2), CFrame.new(wx, 1.1, wz), { Color = Color3.fromRGB(18, 18, 22), Shape = Enum.PartType.Cylinder })
			end
		end
		car.flame = piece("Flame", Vector3.new(1.8, 1, 2.6), CFrame.new(0, 1.5, 5.6), { Color = Color3.fromRGB(255, 120, 30), Material = Enum.Material.SmoothPlastic })
		local flameLight = Instance.new("PointLight")
		flameLight.Range = 10
		flameLight.Brightness = 2
		flameLight.Color = Color3.fromRGB(255, 150, 60)
		flameLight.Parent = car.flame
		car.flameLight = flameLight
		return car
	end

	local player = newCar("blue", BLUE)
	local bot = newCar("orange", ORANGE)
	local cars = { player, bot }

