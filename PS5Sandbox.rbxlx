            <string name="Name">manifest</string>
            <string name="Source"><![CDATA[-- Манифест читается системой без запуска игры (плитка, магазин, трофеи, сервер).
return {
	id = "chess",
	title = "Chess",
	category = "game",
	genre = "Board game",
	developer = "PS5 Sandbox",
	version = "1.0",
	order = 13,
	description = "Classic chess with every rule: castling, en passant, promotion, check and mate. Play the computer on three levels or a friend on one console.",
	icon = "♞",
	cover = "cover",
	art = "art",
	colors = { "#4C7DFF", "#0B1430" },
	controls = {
		{ "D-pad / stick / arrows / mouse", "Move the cursor" },
		{ "✕ / Enter / click", "Pick a piece, make a move" },
		{ "△", "Undo" },
		{ "□", "Hint" },
		{ "OPTIONS / ○", "Menu" },
	},
	trophies = {
		{ id = "first_win", name = "Checkmate!", description = "Beat the computer on any level", grade = "bronze" },
		{ id = "beat_medium", name = "Club Player", description = "Beat the computer on Medium", grade = "silver" },
		{ id = "beat_hard", name = "Grandmaster", description = "Beat the computer on Hard", grade = "gold" },
		{ id = "quick_mate", name = "Blitz", description = "Checkmate the computer in 30 moves or fewer", grade = "silver" },
		{ id = "castle", name = "Safe and Sound", description = "Castle your king", grade = "bronze" },
		{ id = "en_passant", name = "In Passing", description = "Capture a pawn en passant", grade = "bronze" },
		{ id = "promotion", name = "Royal Upgrade", description = "Promote a pawn", grade = "bronze" },
		{ id = "knight_promo", name = "Humble Knight", description = "Promote a pawn to a knight", grade = "bronze", hidden = true },
		{ id = "two_player", name = "Friendly Match", description = "Finish a game for two players", grade = "bronze" },
		{ id = "platinum", name = "King of the Board", description = "Earn every Chess trophy", grade = "platinum" },
	},
}
]]></string>
